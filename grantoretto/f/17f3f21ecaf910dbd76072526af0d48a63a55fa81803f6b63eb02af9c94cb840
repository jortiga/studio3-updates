          g.fillStyle = dir > 0 ? 'rgba(255,255,240,.9)' : 'rgba(255,90,110,.9)'; g.beginPath(); g.arc(a[0], a[1], 2.2, 0, 6.283); g.fill();
        }
      }
    }
    // blinking lights
    for (const [x, y, c, per, ph] of AMBIENT.blink) {
      const k = Math.pow(Math.max(0, Math.sin((time / per + ph) * 6.283)), 6);
      if (k < 0.02) continue;
      const r = 10 + 8 * k, gr = g.createRadialGradient(x, y, 0, x, y, r);
      gr.addColorStop(0, c); gr.addColorStop(1, 'rgba(0,0,0,0)'); g.globalAlpha = k; g.fillStyle = gr; g.fillRect(x - r, y - r, r * 2, r * 2);
    }
    g.globalAlpha = 1;
    if (SHOW_PATHS) {   // user: no runway lights / plane on the airstrip
    // runway approach lights (chasing) + a plane taking off now and then
    const [r0, r1] = AMBIENT.runway, rl = Math.hypot(r1[0] - r0[0], r1[1] - r0[1]), ux = (r1[0] - r0[0]) / rl, uy = (r1[1] - r0[1]) / rl;
    for (let i = 0; i < 8; i++) { // approach lights behind the runway start, chasing toward it
      const k = ((time * 1.4 - (7 - i) * 0.09) % 1 + 1) % 1, al = k < 0.16 ? 1 - k / 0.16 : 0;
      if (al <= 0) continue;
      const x = r0[0] - ux * (16 + i * 9), y = r0[1] - uy * (16 + i * 9);
      g.fillStyle = `rgba(255,240,160,${al.toFixed(3)})`; g.beginPath(); g.arc(x, y, 2.6, 0, 6.283); g.fill();
    }
    const pc = (time % 14) / 7; // 0..2: roll + climb, then pause
    if (pc < 1) {
      const k = pc * pc, x = r0[0] + ux * rl * 1.6 * k, y = r0[1] + uy * rl * 1.6 * k - (k > 0.55 ? (k - 0.55) * 60 : 0), sc = 1 + Math.max(0, k - 0.55) * 1.4;
      g.save(); g.translate(x, y); g.rotate(Math.atan2(uy, ux)); g.scale(sc, sc); g.globalAlpha = k > 0.85 ? (1 - k) / 0.15 : 1;
      g.fillStyle = 'rgba(230,236,255,.95)'; g.fillRect(-9, -1.6, 18, 3.2); g.fillRect(-2, -8, 4, 16); g.fillRect(-9, -4, 3, 8);
      g.fillStyle = Math.sin(time * 18) > 0 ? '#ff3355' : '#3dffa8'; g.fillRect(-1, -9, 2, 2);
      g.restore(); g.globalAlpha = 1;
    }
    }
    // water glints
    for (const gl of glints) {
      gl.t += dt; if (gl.t > gl.life) spawnGlint(gl);
      const a = Math.sin(Math.PI * gl.t / gl.life) * 0.55;
      g.strokeStyle = `rgba(${gl.c},${a.toFixed(3)})`; g.lineWidth = 1.6; g.beginPath(); g.moveTo(gl.x - gl.w / 2, gl.y); g.lineTo(gl.x + gl.w / 2, gl.y); g.stroke();
    }
    // career route: done legs gold, the leg being opened grows, locked legs faint dots
    g.globalCompositeOperation = 'source-over';
    for (let i = 0; SHOW_PATHS && i < AREA_ORDER.length - 1; i++) {   // route line off (misaligned)
      const f = AREA_ORDER[i], t = AREA_ORDER[i + 1], openLeg = st.open[t] && anim.leg !== f;
      const growing = anim.leg === f, u1 = growing ? anim.legU : openLeg ? 1 : 0;
      const pts = []; for (let k = 0; k <= 40; k++) pts.push(legPt(f, t, k / 40));
      // base: dotted
      g.setLineDash([2 * px, 10 * px]); g.lineDashOffset = 0; g.lineWidth = 3 * px; g.strokeStyle = 'rgba(220,225,255,.5)';
      g.beginPath(); pts.forEach((p, k) => (k ? g.lineTo(p[0], p[1]) : g.moveTo(p[0], p[1]))); g.stroke();
      if (u1 > 0) {
        const n = Math.max(1, Math.round(40 * u1));
        g.setLineDash([]); g.lineWidth = 9 * px; g.strokeStyle = 'rgba(255,47,154,.35)';
        g.beginPath(); for (let k = 0; k <= n; k++) { const p = k === n ? legPt(f, t, u1) : pts[k]; k ? g.lineTo(p[0], p[1]) : g.moveTo(p[0], p[1]); } g.stroke();
        g.setLineDash([14 * px, 10 * px]); g.lineDashOffset = -time * 40 * px; g.lineWidth = 4 * px; g.strokeStyle = '#ffd76a';
        g.stroke();
      }
    }
    g.setLineDash([]);
    if (route) {   /* chapter route: done legs gold, the leg to the next stop pulses pink, later legs faint dashes */
      const S = route.stops, ni = S.findIndex((q) => q.st !== 'beat');
      g.lineCap = 'round'; g.lineJoin = 'round';
      for (let i = 1; i < S.length; i++) {
        const a = S[i - 1], b = S[i], cx = (a.x + b.x) / 2 + (b.y - a.y) * 0.12, cy = (a.y + b.y) / 2 - (b.x - a.x) * 0.12;
        const path = () => { g.beginPath(); g.moveTo(a.x, a.y); g.quadraticCurveTo(cx, cy, b.x, b.y); };
        if (b.st === 'beat') { g.setLineDash([]); g.lineWidth = 8 * px; g.strokeStyle = 'rgba(0,0,0,.45)'; path(); g.stroke(); g.lineWidth = 4 * px; g.strokeStyle = '#ffd76a'; path(); g.stroke(); }
        else if (i === ni) { g.setLineDash([]); g.lineWidth = 8 * px; g.strokeStyle = 'rgba(255,47,154,.35)'; path(); g.stroke(); g.setLineDash([12 * px, 9 * px]); g.lineDashOffset = -time * 36 * px; g.lineWidth = 3.5 * px; g.strokeStyle = '#ff7ac8'; path(); g.stroke(); }
        else { g.setLineDash([2 * px, 9 * px]); g.lineDashOffset = 0; g.lineWidth = 3 * px; g.strokeStyle = 'rgba(220,225,255,.55)'; path(); g.stroke(); }
      }
      g.setLineDash([]);
    }
  }

  // ---------- unlock animation (area `to` opens after beating `from`'s boss) ----------
  // timeline (s): 0 burst at from; 0.5-2.1 camera pans + route grows + car drives; 1.7-2.9 fog lifts; 2.5 pin lights up.
  function unlock(from, to, { hold = -1, onBurst, onDone } = {}) {
    const fired = {};
    let t = 0;
    anim.lockT = to; anim.leg = from; anim.legU = 0; anim.fogOff[to] = 0; applyFog(); renderPins();
    focus(from, { instant: true, zoom: 1.35 });
    const c0 = { x: cam.x, y: cam.y, s: cam.s }, c1 = camFor(AREAS[to].x, AREAS[to].y, coverS * 1.35);
    const fire = (k, at, fn) => { if (!fired[k] && t >= at) { fired[k] = 1; fn(); } };
    anim.run = (dt) => {
      if (hold < 0 || t < hold) t = hold >= 0 ? Math.min(hold, t + dt) : t + dt;
      fire('a', 0.05, () => onBurst && onBurst('cleared', from));
      const p = ease(seg(t, 0.5, 2.1));
      cam.x = c0.x + (c1.x - c0.x) * p; cam.y = c0.y + (c1.y - c0.y) * p; cam.s = c0.s + (c1.s - c0.s) * p + Math.sin(p * Math.PI) * -0.12 * c0.s; dirty = true;
      anim.legU = easeOut(seg(t, 0.55, 2.0));
      anim.carAt = legPt(from, to, ease(seg(t, 0.6, 2.05)));
      anim.fogOff[to] = easeOut(seg(t, 1.7, 2.9)); applyFog();
      fire('b', 2.5, () => { anim.lockT = null; renderPins(); pins[to].classList.add('pop'); onBurst && onBurst('open', to); });
      if (t >= 3.3 && hold < 0) {
        anim.run = null; anim.leg = null; anim.carAt = null; delete anim.fogOff[to]; applyFog(); renderPins();
        onDone && onDone();
      }
    };
  }

  // ---------- race fly-in: the camera flies to a stop, a pin drops with the place + race type, then onDone ----------
  function flyTo(x, y, { label = '', sub = '', type = 'drag', dur = 0.85, hold = 0.5, zoom = 2.1, onDone } = {}) {
    anim.flyT = (anim.flyT || 0) + 1; const id = anim.flyT;
    fly = { x, y };
    flyEl.querySelector('b').textContent = label; flyEl.querySelector('small').innerHTML = sub;
    flyEl.className = 'wmFly rt_' + type; void flyEl.offsetWidth;
    panTo(camFor(x, y, Math.max(cam.s, coverS * zoom)), dur); dirty = true;
    /* the plate drops near the end of the flight; onDone waits for the camera to arrive (slow devices: frame-clamped tween) */
    setTimeout(() => { if (anim.flyT === id) flyEl.classList.add('on'); }, Math.max(0, dur * 1000 - 260));
    let fired = false;
    const end = () => { if (fired || anim.flyT !== id) return; fired = true; flyEl.classList.add('on'); if (onDone) onDone(); };
    tween.onEnd = () => setTimeout(end, hold * 1000);
    if (hold < 100) setTimeout(end, (dur + hold + 2.5) * 1000);   /* a drag cancels the tween: go anyway */
  }
  function flyOff() { anim.flyT = (anim.flyT || 0) + 1; fly = null; flyEl.className = 'wmFly'; }

  // ---------- public ----------
  const api = {
    root, cam,
    setState(s) { Object.assign(st, s); renderPins(); applyFog(); },
    setInsets(o) { Object.assign(view, o); },
    select(t) { st.sel = t; renderPins(); },
    focus, unlock, imgReady, setRoute, flyTo, flyOff,
    focusXY(x, y, { zoom = null, dur = 0.6 } = {}) { panTo(camFor(x, y, zoom != null ? zoom * coverS : Math.max(cam.s, coverS * 1.3)), dur); },
    pinEl: (t) => pins[t],
    pinScreen(t) { const r = root.getBoundingClientRect(), [x, y] = toScr(AREAS[t].x, AREAS[t].y); return [r.left + x, r.top + y]; },
    busy: () => !!anim.run,
    resize() { fitBounds(); },
    start() { if (running) return; running = true; last = 0; fitBounds(); raf = requestAnimationFrame(frame); },
    stop() { running = false; cancelAnimationFrame(raf); raf = 0; },
  };
  return api;
}
