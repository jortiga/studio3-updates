      sparks(v, grade === 'PERFECT' ? 34 : grade === 'GOOD' ? 16 : 6, grade === 'PERFECT' ? 2 : 0, car);
      v.susp.v -= v.susp.k.shiftKick; v.susp.zv -= 0.05; // torque cut: nose dives, then rebounds when the clutch bites
      if (isPlayer) {
