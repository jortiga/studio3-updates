function handleEvents(car, v, isPlayer) {
  if (G.solo && !isPlayer) { car.events.length = 0; return; }   // solo race: the hidden rival makes no sparks/flames/sounds
  for (const e of car.events) {
    const [type, grade] = e.split(':');
    EX.event(type, grade, isPlayer);
    if (type === 'hit' && isPlayer) {   /* rolling start: the car floors it (at GO, or 0.6 s later after a jump start) */
      const g = G.rollGrade || 'GOOD';
      car.launchGrade = g === 'JUMP' ? 'BOG' : g;
      hud.pop(g === 'JUMP' ? 'BACK ON IT' : g === 'PERFECT' ? 'PERFECT JUMP' : 'FLOORED!', g === 'PERFECT' ? 'fxs perf' : g === 'GOOD' ? 'fxs good' : 'fxs bad',
        g === 'JUMP' ? '+0.6 s PENALTY' : g === 'PERFECT' ? 'KICKDOWN PAID OFF' : 'SHIFT IN THE GREEN');
      v.susp.v += v.susp.k.launchKick * 0.6; G.punch = 0.5; G.pulse = g === 'PERFECT' ? 0.7 : 0.3;
      snd.play('backfire'); if (g === 'PERFECT') snd.play('shift_perfect');
