        if (grade === 'PERFECT') {
          hud.pop('PERFECT', 'fxs perf', sub); G.cheer = Math.max(G.cheer || 0, 0.75); G.pulse = 1; G.edge = 0.3; G.flashCol.setRGB(0.3, 0.85, 1); G.trauma = Math.min(1, G.trauma + 0.08); G.punch = 0.7; v.sweep = -0.4;
