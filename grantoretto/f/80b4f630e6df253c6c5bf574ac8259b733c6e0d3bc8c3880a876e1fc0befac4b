#honks { position: absolute; left: 50%; top: calc(var(--appH, 100vh) * .3); transform: translateX(-50%); display: none; flex-direction: row; align-items: center; gap: calc(var(--u) * 10);
  padding: calc(var(--u) * 8) calc(var(--u) * 16) calc(var(--u) * 8) calc(var(--u) * 10); border-radius: var(--r-panel, 14px); pointer-events: none; transition: opacity .3s;
  background: radial-gradient(120% 160% at 0% 50%, color-mix(in srgb, var(--rt) 24%, transparent), transparent 60%), linear-gradient(180deg, rgba(26,22,38,.94), rgba(10,8,18,.95));
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rt) 60%, rgba(255,255,255,.2)), inset 0 1px 0 rgba(255,255,255,.12), 0 0 22px color-mix(in srgb, var(--rt) 28%, transparent), 0 8px 22px rgba(0,0,0,.45); }
