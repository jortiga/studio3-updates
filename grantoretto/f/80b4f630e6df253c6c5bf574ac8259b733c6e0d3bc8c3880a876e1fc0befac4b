.exRow { margin-top: calc(var(--u) * 12); }
.exRow .seg button { min-width: 0; padding: 0 calc(var(--u) * 10); }
body.portrait .gThumbs { bottom: calc(var(--u) * 340 + env(safe-area-inset-bottom)); }

/* solo tutorial race: no opponent */
.solo #mk2, .solo .trow:has(#p2t), .solo .rt.p2 { display: none !important; }

/* =================== win / lose scene (scenes.js resultScene): themed glass frame, real-colour cars =================== */
