/* =================== countdown: extruded numeral inside a draining dotted ring (coach.js) =================== */
#count { position: absolute; left: 50%; top: calc(var(--appH, 100vh) * .2); width: calc(var(--u) * 132); height: calc(var(--u) * 132); margin-left: calc(var(--u) * -66);
  display: flex; align-items: center; justify-content: center; pointer-events: none; opacity: 0; transition: opacity .12s; perspective: calc(var(--u) * 400); }
#count.show { opacity: 1; }
.cdRing { position: absolute; inset: 0; width: 100%; height: 100%; }
.cdRing i { position: absolute; width: 5.3333%; height: 5.3333%; border-radius: 50%; background: #fff; transition: opacity .08s; will-change: opacity; }
.cdRing i.off { opacity: .14; }
#count.go .cdRing { opacity: 0; }
.cdNum { position: relative; display: block; font-family: var(--f-head); font-weight: normal; font-style: italic; font-size: calc(var(--u) * 78); line-height: 1; color: #fff;
  transform: rotateY(-14deg) rotateX(8deg) skewX(-8deg);
  text-shadow: 1px 1px 0 #d9dbe6, 2px 2px 0 #c3c6d4, 3px 3px 0 #adb0c1, 4px 4px 0 #9599ad, 5px 5px 0 #7e8299, 6px 6px 0 #676b84,
    7px 8px 2px rgba(0,0,0,.45), 9px 12px 18px rgba(0,0,0,.55); }
#count.go .cdNum { font-size: calc(var(--u) * 64); color: var(--ok); text-shadow: 1px 1px 0 #2bd894, 2px 2px 0 #22b97f, 3px 3px 0 #1a9a69, 4px 4px 0 #137b53, 5px 5px 0 #0d5d3f, 7px 8px 2px rgba(0,0,0,.45), 9px 12px 18px rgba(0,0,0,.55); }
.cdNum.cdIn { animation: cdPop .9s var(--ease) both; }
/* perf (Note 9, 2026-11-15: "lagging when the 3 2 1 shows"): the ring's dots change ~24x a second and shared one layer with
   the numeral, so every dot re-rastered the numeral with its 8 text-shadows (one 18 px blur). Own layers for both: the dots
   repaint alone, the numeral rasters once per number. Same look */
.cdNum { will-change: transform; }
@keyframes cdPop { 0% { opacity: 0; transform: rotateY(-14deg) rotateX(8deg) skewX(-8deg) scale(1.7); } 18% { opacity: 1; transform: rotateY(-14deg) rotateX(8deg) skewX(-8deg) scale(1); }
  100% { transform: rotateY(-14deg) rotateX(8deg) skewX(-8deg) scale(.88); } }
body.landscape #count { left: auto; right: calc(var(--u) * 120 + env(safe-area-inset-right)); top: calc(var(--u) * 56 + env(safe-area-inset-top)); margin: 0; width: calc(var(--u) * 112); height: calc(var(--u) * 112); }
body.landscape .cdNum { font-size: calc(var(--u) * 64); }
body.ov-count #vsTag { opacity: 0 !important; animation: none; }

