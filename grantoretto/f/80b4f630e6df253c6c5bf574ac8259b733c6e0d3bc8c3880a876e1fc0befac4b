#honks i { position: relative; display: grid; place-items: center; width: calc(var(--u) * 34); height: calc(var(--u) * 30); border-radius: calc(var(--u) * 6); transform: skewX(-10deg);
  background: rgba(255,255,255,.06); box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.22); transition: background .12s, box-shadow .12s; }
