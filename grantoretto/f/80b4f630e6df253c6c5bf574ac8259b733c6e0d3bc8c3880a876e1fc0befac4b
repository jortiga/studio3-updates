#honks i svg path:first-child, #honks i svg rect { fill: rgba(255,255,255,.14); }
#honks i svg .w1, #honks i svg .w2 { fill: none; opacity: .35; }
#honks i.on { background: linear-gradient(160deg, color-mix(in srgb, var(--rt) 95%, #fff), color-mix(in srgb, var(--rt) 55%, #000));
  box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--rt) 60%, #fff), 0 0 14px var(--rt), 0 0 30px color-mix(in srgb, var(--rt) 55%, transparent); animation: honkIn .3s var(--ease); }
