#honks i.on::after { content: ''; position: absolute; inset: -2px; border-radius: inherit; box-shadow: 0 0 0 2px var(--rt); animation: cueRing .6s ease-out forwards; }
#honks.cop i.on:nth-of-type(2) { --rt: #3a7bff; }   /* the radio cues alternate red / blue like the light bar */
#honks b { font: italic 700 calc(var(--u) * 13) / 1 var(--f-body); letter-spacing: .14em; color: #fff; margin-left: calc(var(--u) * 6); }
#honks.go { padding: calc(var(--u) * 6) calc(var(--u) * 26); background: linear-gradient(100deg, color-mix(in srgb, var(--rt) 85%, #fff), color-mix(in srgb, var(--rt) 60%, #000));
  box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--rt) 50%, #fff), 0 0 34px color-mix(in srgb, var(--rt) 75%, transparent); animation: honkIn .3s var(--ease); }
