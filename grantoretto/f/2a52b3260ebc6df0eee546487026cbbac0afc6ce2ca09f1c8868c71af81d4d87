export function gantryTex() {
  const W = 1024, H = 256, c = cv(W, H), g = c.getContext('2d');
  g.fillStyle = '#0b0b14'; g.fillRect(0, 0, W, H);
  for (let i = 0; i < 16; i++) for (let j = 0; j < 2; j++) { g.fillStyle = (i + j) % 2 ? '#111' : '#eee'; g.fillRect(i * 64, j * 32, 64, 32); g.fillRect(i * 64, H - 64 + j * 32, 64, 32); }
  g.fillStyle = '#fff'; g.font = 'italic 900 110px Impact, "Arial Black", sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle';
  g.fillText('FINISH', W / 2, H / 2 + 4);
  return c;
}

// Fraction of the image height (measured from the bottom) that holds visible pixels: lets layers be sized by content.
export function contentFrac(img) {
  try {
    const w = 128, h = Math.max(16, Math.round(128 * img.height / img.width));
    const c = cv(w, h), g = c.getContext('2d', { willReadFrequently: true });
    g.drawImage(img, 0, 0, w, h);
    const d = g.getImageData(0, 0, w, h).data;
    for (let y = 0; y < h; y++) {
      let n = 0;
      for (let x = 0; x < w; x++) if (d[(y * w + x) * 4 + 3] > 40) n++;
      if (n > w * 0.25) return 1 - y / h;
    }
  } catch { /* tainted or empty */ }
  return 1;
}
