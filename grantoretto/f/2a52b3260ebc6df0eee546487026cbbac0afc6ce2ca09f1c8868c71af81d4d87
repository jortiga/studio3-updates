// Distance boards: atlas of 4x4 boards, "100 FT" ... (index i -> (i+1)*100 ft), 1/8 mile special at 660.
export function boardAtlas(labels) {
  const BW = 256, BH = 160, c = cv(BW * 4, BH * 4), g = c.getContext('2d');
  labels.forEach((t, i) => {
    const x = (i % 4) * BW, y = Math.floor(i / 4) * BH;
    g.fillStyle = '#0d0d16'; g.fillRect(x + 6, y + 6, BW - 12, BH - 12);
    g.strokeStyle = i === labels.length - 1 ? '#ffd23a' : '#ff2fa0'; g.lineWidth = 8; g.strokeRect(x + 12, y + 12, BW - 24, BH - 24);
    g.fillStyle = '#fff'; g.font = 'italic 900 64px Impact, "Arial Black", sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle';
    g.fillText(t[0], x + BW / 2, y + BH / 2 - 14);
    g.font = 'italic 900 30px Impact, "Arial Black", sans-serif'; g.fillStyle = '#5ee7ff'; g.fillText(t[1], x + BW / 2, y + BH / 2 + 40);
  });
  return c;
}

