@font-face { font-family: 'Anton'; src: url(fonts/Anton-400.woff2) format('woff2'); font-display: swap; }
@font-face { font-family: 'Barlow Condensed'; font-weight: 600; src: url(fonts/BarlowCondensed-600.woff2) format('woff2'); font-display: swap; }
@font-face { font-family: 'Barlow Condensed'; font-weight: 700; src: url(fonts/BarlowCondensed-700.woff2) format('woff2'); font-display: swap; }
@font-face { font-family: 'Barlow Condensed'; font-weight: 700; font-style: italic; src: url(fonts/BarlowCondensed-700i.woff2) format('woff2'); font-display: swap; }
:root {
  --s: 1; --u: calc(var(--s) * 1px);
  --font: 'Anton', Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  --font2: 'Barlow Condensed', "Arial Narrow", Arial, sans-serif;
  --cyan: #2fe6ff; --pink: #ff2f9a; --violet: #8a5cff; --gold: #ffcc33; --red: #ff3355; --green: #3dffa8;
  --panel: linear-gradient(180deg, rgba(36,28,78,.92), rgba(10,8,28,.94));
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; height: 100%; overflow: hidden; background: #07061a; color: #fff; font-family: var(--font);
  user-select: none; -webkit-user-select: none; touch-action: none; }
#gl { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
.hidden { display: none !important; }
button { font-family: var(--font); color: #fff; border: 0; padding: 0; background: none; cursor: pointer; }
.u { font-size: calc(var(--s) * 16px); }

/* ---------- glossy neon buttons ---------- */
.btn { position: relative; overflow: hidden; border-radius: calc(var(--s) * 14px);
  background: linear-gradient(180deg, #4a4f72 0%, #23263e 48%, #15172a 52%, #262a46 100%);
  box-shadow: inset 0 0 0 calc(var(--s) * 2px) rgba(160,180,255,.35), inset 0 calc(var(--s) * 2px) 0 rgba(255,255,255,.35), 0 calc(var(--s) * 4px) calc(var(--s) * 10px) rgba(0,0,0,.6);
  transition: transform .08s ease-out, filter .08s; }
.btn::after { content: ''; position: absolute; top: -20%; bottom: -20%; width: 40%; left: 0;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,.45), transparent); transform: translateX(-160%) skewX(-20deg);
  animation: shine 3.6s ease-in-out infinite; pointer-events: none; }
@keyframes shine { 0%, 70% { transform: translateX(-160%) skewX(-20deg); } 100% { transform: translateX(330%) skewX(-20deg); } }
#hud .btn::after { display: none; }
.btn.down, .btn:active { transform: scale(.9); filter: brightness(1.5); }
.btn.rel { animation: rel .28s cubic-bezier(.2,1.6,.4,1); }
@keyframes rel { 0% { transform: scale(.88); } 100% { transform: scale(1); } }
.btn.off { opacity: .45; }
.btn > span { position: relative; z-index: 1; }

/* ---------- HUD ---------- */
#hud { position: fixed; inset: 0; pointer-events: none; padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); }
#hud .btn { pointer-events: auto; }
#top { position: absolute; left: calc(var(--s) * 12px); right: calc(var(--s) * 12px); top: calc(var(--s) * 10px + env(safe-area-inset-top));
  display: flex; align-items: center; gap: calc(var(--s) * 12px); }
.sq { width: calc(var(--s) * 44px); height: calc(var(--s) * 44px); flex: none; border-radius: calc(var(--s) * 10px); }
.pauseIco { display: block; margin: auto; width: 40%; height: 44%; border-left: calc(var(--s) * 6px) solid #fff; border-right: calc(var(--s) * 6px) solid #fff; }
#prog { position: relative; flex: 1; height: calc(var(--s) * 30px); }
#prog .track { position: absolute; left: 0; right: calc(var(--s) * 18px); top: 50%; height: calc(var(--s) * 4px); margin-top: calc(var(--s) * -2px);
  background: rgba(255,255,255,.18); border-radius: 4px; box-shadow: 0 0 calc(var(--s) * 8px) rgba(140,120,255,.6); }
#prog .flag { position: absolute; right: 0; top: 50%; width: calc(var(--s) * 20px); height: calc(var(--s) * 16px); margin-top: calc(var(--s) * -8px);
  background: conic-gradient(#fff 25%, #111 0 50%, #fff 0 75%, #111 0) 0 0 / calc(var(--s) * 8px) calc(var(--s) * 8px); border: 1px solid #fff; }
.mk { position: absolute; top: 50%; width: 0; height: 0; margin-left: calc(var(--s) * -1px); }
#prog .mk::before { content: ''; position: absolute; left: calc(var(--s) * -8px); width: 0; height: 0; border-left: calc(var(--s) * 8px) solid transparent; border-right: calc(var(--s) * 8px) solid transparent; }
#mk1::before { top: calc(var(--s) * -16px); border-top: calc(var(--s) * 12px) solid var(--gold); filter: drop-shadow(0 0 4px var(--gold)); }
#mk2::before { top: calc(var(--s) * 4px); border-bottom: calc(var(--s) * 12px) solid var(--red); filter: drop-shadow(0 0 4px var(--red)); }
#prog .mk { left: 0; }
#prog { margin-right: calc(var(--s) * 2px); }
#prog .mk, #prog .flag { max-width: calc(100% - 18px); }
#dist { font-size: calc(var(--s) * 18px); font-style: italic; letter-spacing: .5px; text-shadow: 0 0 8px rgba(130,120,255,.9); white-space: nowrap; }
#times { position: absolute; left: calc(var(--s) * 12px); top: calc(var(--s) * 62px + env(safe-area-inset-top)); display: flex; flex-direction: column; gap: calc(var(--s) * 6px); }
.trow { display: flex; align-items: center; gap: calc(var(--s) * 8px); height: calc(var(--s) * 26px);
  background: linear-gradient(90deg, rgba(10,8,30,.85), rgba(10,8,30,0)); padding-right: calc(var(--s) * 30px); border-radius: 6px; }
.tag { display: inline-block; font-style: italic; font-size: calc(var(--s) * 17px); padding: 0 calc(var(--s) * 9px); line-height: calc(var(--s) * 26px);
  transform: skewX(-14deg); border-radius: 4px; }
.tag.p1 { background: linear-gradient(180deg, #4fb4ff, #1662ff); box-shadow: 0 0 10px rgba(60,140,255,.8); }
.tag.p2 { background: linear-gradient(180deg, #ff5a7a, #e0103a); box-shadow: 0 0 10px rgba(255,40,80,.8); }
.tbar { width: calc(var(--s) * 70px); height: calc(var(--s) * 5px); background: rgba(255,255,255,.12); border-radius: 3px; overflow: hidden; display: none; }
.tbar span { display: block; height: 100%; width: 100%; transform-origin: left; transform: scaleX(0); }
#p1bar { background: linear-gradient(90deg, #1662ff, #6fd0ff); } #p2bar { background: linear-gradient(90deg, #e0103a, #ff8aa0); }
.tval { font-size: calc(var(--s) * 19px); font-style: italic; min-width: calc(var(--s) * 74px); font-variant-numeric: tabular-nums; }

#prompt { position: absolute; left: 0; right: 0; top: 30%; text-align: center; font-size: calc(var(--s) * 22px); font-style: italic; letter-spacing: 1px;
  opacity: 0; transition: opacity .25s; text-shadow: 0 0 10px #000, 0 0 14px var(--violet); }
#prompt.show { opacity: 1; animation: pulse 1s ease-in-out infinite; }
@keyframes pulse { 50% { transform: scale(1.06); } }

#pops { position: absolute; left: 0; right: 0; top: 19%; height: 0; }
.pop { position: absolute; left: 0; right: 0; text-align: center; opacity: 0; pointer-events: none; }
.pop b { display: block; font-weight: normal; font-style: italic; font-size: calc(var(--s) * 46px); letter-spacing: 1px; transform: skewX(-10deg);
  background: linear-gradient(180deg, #ffffff 0%, #c7f6ff 45%, #2fe6ff 55%, #7b4bff 100%); -webkit-background-clip: text; background-clip: text; color: transparent;
  -webkit-text-stroke: calc(var(--s) * 1.5px) #0b0630; filter: drop-shadow(0 0 calc(var(--s) * 8px) rgba(47,230,255,.9)) drop-shadow(0 calc(var(--s) * 3px) 0 #0b0630); }
.pop i { display: block; font-style: italic; font-size: calc(var(--s) * 18px); color: #e9ecff; text-shadow: 0 0 6px #000; margin-top: calc(var(--s) * 2px); }
.pop.show { animation: popin 1.1s cubic-bezier(.2,1.4,.4,1) forwards; }
.pop.good b { background-image: linear-gradient(180deg, #fff, #fff3b0 45%, #ffcc33 55%, #ff7a1a); filter: drop-shadow(0 0 8px rgba(255,200,50,.9)) drop-shadow(0 3px 0 #2a1200); }
.pop.bad b { background-image: linear-gradient(180deg, #fff, #ffc2cc 45%, #ff3355 55%, #a0002a); filter: drop-shadow(0 0 8px rgba(255,50,80,.9)) drop-shadow(0 3px 0 #2a0010); }
.pop.nitro b { background-image: linear-gradient(180deg, #fff, #bfe8ff 45%, #3aa0ff 55%, #2030ff); }
.pop.huge b { font-size: calc(var(--s) * 64px); }
@keyframes popin {
  0% { opacity: 0; transform: scale(2.4) translateX(-8%); }
  12% { opacity: 1; transform: scale(.94); }
  20% { transform: scale(1.04); }
  75% { opacity: 1; transform: scale(1) translateY(0); }
  100% { opacity: 0; transform: scale(1.05) translateY(calc(var(--s) * -24px)); }
}

#controls { position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--s) * 240px); }
#controls > * { position: absolute; }
#tachWrap { left: 50%; bottom: calc(var(--s) * 4px + env(safe-area-inset-bottom)); width: calc(var(--s) * 204px); height: calc(var(--s) * 218px); margin-left: calc(var(--s) * -102px); pointer-events: none; }
#tach { width: 100%; height: 100%; display: block; }
#gear { position: absolute; left: 50%; top: 57%; width: 25%; height: 20%; margin-left: -12.5%;
  text-align: center; font-size: calc(var(--s) * 38px); line-height: calc(var(--s) * 43px); font-style: italic;
  background: linear-gradient(180deg, #2a2f52, #0e0f20); border-radius: calc(var(--s) * 10px);
  box-shadow: inset 0 0 0 2px rgba(150,170,255,.55), 0 0 calc(var(--s) * 14px) rgba(110,90,255,.7); }
#gear.bump { animation: bump .25s ease-out; }
@keyframes bump { 0% { transform: scale(1.5); color: var(--cyan); } 100% { transform: scale(1); } }
#speedo { position: absolute; left: 0; right: 0; top: 79%; text-align: center; line-height: 1; white-space: nowrap; }
#kmh { display: inline-block; min-width: 1.6em; text-align: right; font-size: calc(var(--s) * 34px); font-style: italic; font-variant-numeric: tabular-nums; text-shadow: 0 0 10px rgba(80,200,255,.8); }
#speedo small { font-size: calc(var(--s) * 14px); font-style: italic; opacity: .85; margin-left: .25em; }

.round { width: calc(var(--s) * 78px); height: calc(var(--s) * 78px); border-radius: 50%;
  background: radial-gradient(circle at 50% 35%, #2c3a7a, #0c1030 70%);
  box-shadow: inset 0 0 0 calc(var(--s) * 3px) #2fb8ff, 0 0 calc(var(--s) * 16px) rgba(47,184,255,.7), 0 4px 10px rgba(0,0,0,.6); }
#nitro { left: calc(var(--s) * 12px); bottom: calc(var(--s) * 88px + env(safe-area-inset-bottom)); }
#nitroFill { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(47,184,255,.75), rgba(120,220,255,.25)); transform-origin: bottom; z-index: 0; }
#nitro .bottle { position: absolute; left: 34%; top: 12%; width: 32%; height: 52%; border-radius: 30% 30% 20% 20% / 20% 20% 10% 10%;
  background: linear-gradient(90deg, #8fd8ff, #2a7cff 60%, #1a3aa0); box-shadow: inset 0 0 0 2px #dff6ff; transform: rotate(18deg); z-index: 1; }
#nitro .bottle::before { content: ''; position: absolute; left: 30%; top: -18%; width: 40%; height: 20%; background: #dfe8ff; border-radius: 2px; }
#nitro .lbl { position: absolute; left: 0; right: 0; bottom: 11%; font-size: calc(var(--s) * 14px); font-style: italic; text-shadow: 0 0 6px #000; z-index: 1; }
#nitro.active { animation: nitroGlow .25s ease-in-out infinite alternate; }
@keyframes nitroGlow { to { box-shadow: inset 0 0 0 calc(var(--s) * 3px) #fff, 0 0 calc(var(--s) * 30px) #2fb8ff, 0 0 calc(var(--s) * 60px) rgba(47,184,255,.6); } }
#nitro.empty { filter: grayscale(.9) brightness(.6); }

.pill { width: calc(var(--s) * 62px); height: calc(var(--s) * 46px); font-size: calc(var(--s) * 34px); line-height: calc(var(--s) * 46px); text-align: center; }
#minus { left: calc(var(--s) * 22px); bottom: calc(var(--s) * 24px + env(safe-area-inset-bottom)); }
#plus { right: calc(var(--s) * 15px); bottom: calc(var(--s) * 160px + env(safe-area-inset-bottom)); box-shadow: inset 0 0 0 calc(var(--s) * 2px) rgba(61,255,168,.6), inset 0 2px 0 rgba(255,255,255,.35), 0 0 calc(var(--s) * 12px) rgba(61,255,168,.35); }
.pedal { right: calc(var(--s) * 12px); bottom: calc(var(--s) * 16px + env(safe-area-inset-bottom)); width: calc(var(--s) * 68px); height: calc(var(--s) * 130px);
  border-radius: calc(var(--s) * 16px); transform: perspective(300px) rotateX(14deg);
  background: linear-gradient(160deg, #e9edf6 0%, #9aa2b8 40%, #5c6380 60%, #c3c9da 100%);
  box-shadow: inset 0 0 0 calc(var(--s) * 3px) var(--pink), 0 0 calc(var(--s) * 20px) rgba(255,47,154,.7), 0 6px 12px rgba(0,0,0,.6); }
.pedal .ridges { position: absolute; inset: 14% 18%; background: repeating-linear-gradient(115deg, #2a2d40 0 calc(var(--s) * 7px), transparent calc(var(--s) * 7px) calc(var(--s) * 15px)); border-radius: 8px; }
.pedal.down, .pedal:active { transform: perspective(300px) rotateX(34deg) scale(.95); filter: brightness(1.3); }
.dim { opacity: .35; }

/* landscape layout */
body.landscape #tachWrap { width: calc(var(--s) * 214px); height: calc(var(--s) * 228px); margin-left: calc(var(--s) * -107px); }
body.landscape #nitro { left: calc(var(--s) * 30px); bottom: calc(var(--s) * 24px + env(safe-area-inset-bottom)); width: calc(var(--s) * 90px); height: calc(var(--s) * 90px); }
body.landscape #minus { left: calc(50% - var(--s) * 220px); bottom: calc(var(--s) * 30px + env(safe-area-inset-bottom)); }
body.landscape #plus { right: calc(50% - var(--s) * 220px); bottom: calc(var(--s) * 30px + env(safe-area-inset-bottom)); }
body.landscape .pedal { right: calc(var(--s) * 30px); bottom: calc(var(--s) * 14px + env(safe-area-inset-bottom)); }
body.landscape #prog { margin: 0 calc(var(--s) * 30px); }
body.landscape .tbar { display: block; }
body.landscape #times { top: calc(var(--s) * 60px + env(safe-area-inset-top)); }
body.landscape #prompt { top: 22%; }
body.landscape #pops { top: 24%; }

/* ---------- screens ---------- */
.screen { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 5; }
#title { justify-content: space-between; padding: calc(var(--s) * 40px) calc(var(--s) * 16px) calc(var(--s) * 30px);
  background: linear-gradient(180deg, rgba(7,6,26,.55) 0%, rgba(7,6,26,0) 30%, rgba(7,6,26,0) 55%, rgba(7,6,26,.85) 100%); }
.titleArt { position: absolute; inset: 0; z-index: -1; background-size: cover; background-position: center; }
.logo { text-align: center; transform: skewX(-12deg); margin-top: calc(var(--s) * 10px); position: relative; }
.logo .l1, .logo .l2 { font-style: italic; line-height: .9; letter-spacing: calc(var(--s) * 2px);
  background: linear-gradient(180deg, #ffffff 0%, #ffe9fb 40%, #ff4fb8 52%, #7a2bff 100%); -webkit-background-clip: text; background-clip: text; color: transparent;
  -webkit-text-stroke: calc(var(--s) * 2px) #12052e; filter: drop-shadow(0 0 calc(var(--s) * 12px) rgba(255,60,180,.8)) drop-shadow(0 calc(var(--s) * 5px) 0 #12052e); }
.logo .l1 { font-size: calc(var(--s) * 56px); }
.logo .l2 { font-size: calc(var(--s) * 78px); background-image: linear-gradient(180deg, #ffffff 0%, #d8fbff 40%, #2fe6ff 52%, #2058ff 100%); filter: drop-shadow(0 0 calc(var(--s) * 12px) rgba(47,230,255,.8)) drop-shadow(0 calc(var(--s) * 5px) 0 #12052e); }
.logo .tag { font-size: calc(var(--s) * 15px); letter-spacing: calc(var(--s) * 6px); margin-top: calc(var(--s) * 8px); color: #ffd6f3; text-shadow: 0 0 8px var(--pink); background: none; box-shadow: none; transform: none; }
.logo .l1, .logo .l2 { background-size: 300% 100%, 100% 100%; background-repeat: no-repeat; animation: logoShine 3.2s ease-in-out infinite; }
.logo .l1 { background-image: linear-gradient(100deg, transparent 42%, rgba(255,255,255,.95) 50%, transparent 58%), linear-gradient(180deg, #ffffff 0%, #ffe9fb 40%, #ff4fb8 52%, #7a2bff 100%); }
.logo .l2 { background-image: linear-gradient(100deg, transparent 42%, rgba(255,255,255,.95) 50%, transparent 58%), linear-gradient(180deg, #ffffff 0%, #d8fbff 40%, #2fe6ff 52%, #2058ff 100%); }
@keyframes logoShine { 0%, 55% { background-position: 120% 0, 0 0; } 100% { background-position: -20% 0, 0 0; } }
.swatches { display: flex; gap: calc(var(--s) * 6px); justify-content: center; flex-wrap: wrap; margin-bottom: calc(var(--s) * 14px); pointer-events: auto; }
.sw { width: calc(var(--s) * 26px); height: calc(var(--s) * 26px); border-radius: 50%; box-shadow: inset 0 0 0 2px rgba(255,255,255,.5), inset 0 -6px 8px rgba(0,0,0,.35), 0 2px 6px rgba(0,0,0,.6); cursor: pointer; transition: transform .1s; }
.sw.on { transform: scale(1.25); box-shadow: inset 0 0 0 3px #fff, 0 0 12px #fff; }
.big { width: calc(var(--s) * 240px); height: calc(var(--s) * 70px); font-size: calc(var(--s) * 40px); font-style: italic; letter-spacing: 3px; }
.gold { background: linear-gradient(180deg, #fff2a8 0%, #ffcc33 45%, #f08a00 55%, #ffb21a 100%); color: #2a1200;
  box-shadow: inset 0 0 0 calc(var(--s) * 2px) rgba(255,255,255,.7), inset 0 calc(var(--s) * 3px) 0 rgba(255,255,255,.7), 0 0 calc(var(--s) * 22px) rgba(255,190,40,.7), 0 6px 12px rgba(0,0,0,.6); }
.gold span { text-shadow: 0 1px 0 rgba(255,255,255,.6); }
.big.gold { animation: breathe 1.6s ease-in-out infinite; }
@keyframes breathe { 50% { box-shadow: inset 0 0 0 2px rgba(255,255,255,.7), inset 0 3px 0 rgba(255,255,255,.7), 0 0 36px rgba(255,190,40,1), 0 6px 12px rgba(0,0,0,.6); } }
.panel { width: min(92vw, calc(var(--s) * 360px)); background: var(--panel); border-radius: calc(var(--s) * 18px); padding: calc(var(--s) * 16px);
  box-shadow: inset 0 0 0 2px rgba(150,120,255,.55), 0 0 30px rgba(110,70,255,.45), 0 10px 30px rgba(0,0,0,.7); animation: panelIn .45s cubic-bezier(.2,1.3,.4,1); }
@keyframes panelIn { from { transform: translateY(30px) scale(.9); opacity: 0; } }
.panel.small { width: min(80vw, calc(var(--s) * 280px)); }
#result { background: radial-gradient(ellipse at center, rgba(7,6,26,.35), rgba(7,6,26,.8)); }
#pause { background: rgba(7,6,26,.6); }
.banner { text-align: center; font-size: calc(var(--s) * 50px); font-style: italic; transform: skewX(-10deg); margin: calc(var(--s) * -4px) 0 calc(var(--s) * 8px);
  background: linear-gradient(180deg, #fff 0%, #fff3b0 45%, #ffcc33 55%, #ff7a1a 100%); -webkit-background-clip: text; background-clip: text; color: transparent;
  -webkit-text-stroke: calc(var(--s) * 1.5px) #2a1200; filter: drop-shadow(0 0 10px rgba(255,190,40,.8)); }
.banner.lose { background-image: linear-gradient(180deg, #fff, #ffc2cc 45%, #ff3355 55%, #a0002a); filter: drop-shadow(0 0 10px rgba(255,50,80,.8)); -webkit-text-stroke-color: #2a0010; }
.resTimes { display: grid; grid-template-columns: 1fr 1fr; gap: calc(var(--s) * 6px); }
.rt { display: flex; align-items: center; gap: calc(var(--s) * 8px); background: rgba(0,0,0,.35); border-radius: 8px; padding: calc(var(--s) * 6px); }
.rt b { font-weight: normal; font-size: calc(var(--s) * 22px); font-style: italic; }
.margin { grid-column: span 2; text-align: center; font-size: calc(var(--s) * 16px); color: #c9d0ff; font-style: italic; }
.chips { display: flex; flex-wrap: wrap; gap: calc(var(--s) * 5px); justify-content: center; margin: calc(var(--s) * 10px) 0; }
.chip { font-size: calc(var(--s) * 13px); padding: calc(var(--s) * 3px) calc(var(--s) * 7px); border-radius: 6px; font-style: italic; letter-spacing: .5px; }
.chip.PERFECT { background: linear-gradient(180deg, #5effc0, #00a870); color: #002a1a; }
.chip.GOOD { background: linear-gradient(180deg, #fff09a, #e0a800); color: #2a1a00; }
.chip.EARLY, .chip.LATE, .chip.BOG, .chip.SPIN { background: linear-gradient(180deg, #ff8aa0, #c0102a); }
.chip.MISS { background: #333a5a; }
.stats { display: grid; grid-template-columns: 1fr 1fr; gap: calc(var(--s) * 4px) calc(var(--s) * 10px); font-family: var(--font2); font-weight: 700; font-size: calc(var(--s) * 13px); color: #c9d0ff; }
.stats div { display: flex; justify-content: space-between; white-space: nowrap; gap: 6px; border-bottom: 1px solid rgba(255,255,255,.08); padding: 2px 0; }
.stats b { color: #fff; }
.paintRow { display: flex; align-items: center; gap: calc(var(--s) * 10px); margin-top: calc(var(--s) * 10px); font-style: italic; font-size: calc(var(--s) * 15px); }
.paintRow .swatches { margin: 0; }
.paintRow .sw { width: calc(var(--s) * 24px); height: calc(var(--s) * 24px); }
.row { display: flex; gap: calc(var(--s) * 10px); justify-content: center; margin-top: calc(var(--s) * 14px); }
.row.col { flex-direction: column; align-items: center; }
.mid { width: calc(var(--s) * 150px); height: calc(var(--s) * 50px); font-size: calc(var(--s) * 22px); font-style: italic; letter-spacing: 1px; }
body.landscape .panel { width: min(70vw, calc(var(--s) * 520px)); }
body.landscape #result .panel { display: grid; grid-template-columns: 1fr 1fr; column-gap: calc(var(--s) * 14px); padding: calc(var(--s) * 12px); }
body.landscape #result .banner, body.landscape #result .row { grid-column: span 2; }
body.landscape #result .row { margin-top: calc(var(--s) * 8px); }
body.landscape #result .chips { margin: 0; align-content: flex-start; }
body.landscape #title { padding-top: calc(var(--s) * 16px); padding-bottom: calc(var(--s) * 14px); }
body.landscape .logo .l1 { font-size: calc(var(--s) * 44px); } body.landscape .logo .l2 { font-size: calc(var(--s) * 64px); }

#loading { position: fixed; inset: 0; z-index: 20; background: #07061a; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; transition: opacity .4s; }
#loading .lbar { width: 50vw; max-width: 260px; height: 6px; background: rgba(255,255,255,.12); border-radius: 3px; overflow: hidden; }
#lfill { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--cyan), var(--pink)); transition: width .2s; }
#loading .ltxt { font-style: italic; font-size: 22px; letter-spacing: 4px; color: #d9d3ff; text-shadow: 0 0 10px var(--violet); }
/* effects pass: EARLY/LATE/BOG = short red flicker on the tach ring only (main.js tachFlash); limiter shake = JS `translate` */
#tachWrap.bad::after { box-shadow: 0 0 0 2px #ff3355, 0 0 14px rgba(255,50,80,.6); animation: tachBad .36s linear; }
@keyframes tachBad { 0%, 30%, 60% { opacity: 1; } 15%, 45% { opacity: .25; } 100% { opacity: 0; } }
/* NOS sustain: speedometer digits glow blue (main.js toggles body.nos) */
body.nos #kmh { color: #9ad8ff; text-shadow: 0 0 6px #3a9cff, 0 0 14px rgba(58,156,255,.7); transition: color .15s; }
