const $ = (id) => document.getElementById(id);
const fmt = (n) => Math.round(n).toLocaleString('en-US');
const pillFmt = (n) => (n >= 100000 ? Math.floor(n / 1000) + 'K' : fmt(n)); // top-bar pills stay narrow on 360 px phones
const coinI = '<i class="ico it0"></i>', gemI = '<i class="ico it1"></i>';
const costHtml = (o) => (o.gems ? `${gemI}${o.gems}` : `${coinI}${fmt(o.coins)}`);
// Roll the first number in an element's text from its old value to the new one (same text around it), ~0.35 s.
const NUM = /-?\d[\d,]*\.?\d*/;
export function rollText(el, text, dur = 350) {
  const old = el.textContent, a = old.match(NUM), b = String(text).match(NUM);
  cancelAnimationFrame(el._roll);
  if (!a || !b || old.replace(NUM, '#') !== String(text).replace(NUM, '#') || a[0] === b[0]) { el.textContent = text; return; }
  const v0 = parseFloat(a[0].replace(/,/g, '')), v1 = parseFloat(b[0].replace(/,/g, ''));
  const dec = (b[0].split('.')[1] || '').length, comma = b[0].includes(',') || Math.abs(v1) >= 1000, t0 = performance.now();
  const f = (v) => (comma ? Math.round(v).toLocaleString('en-US') : v.toFixed(dec));
  const step = (now) => {
    const k = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - k, 3);
    el.textContent = String(text).replace(NUM, f(v0 + (v1 - v0) * e));
    if (k < 1) el._roll = requestAnimationFrame(step); else el.textContent = text;
  };
  el._roll = requestAnimationFrame(step);
}

export function createUI(api) {
  const { save, persist, snd } = api;
  let cur = null, busy = false;
  const ui = {};
  const screens = { menu: 'title', garage: 'garage', career: 'career' }; // UPGRADE lives in the garage (hotspots on the car)
  const titles = { menu: '', garage: 'GARAGE', career: 'CAREER' };
  let shownCoins = save.coins, shownGems = save.gems;

  // ---------- press juice ----------
  function tap(el, fn, sound = 'ui_click') {
    el.addEventListener('pointerdown', (e) => { e.stopPropagation(); api.audioInit(); el.classList.add('down'); });
    const up = () => { if (!el.classList.contains('down')) return; el.classList.remove('down'); el.classList.remove('rel'); void el.offsetWidth; el.classList.add('rel'); };
    el.addEventListener('pointerup', up); el.addEventListener('pointerleave', () => el.classList.remove('down')); el.addEventListener('pointercancel', () => el.classList.remove('down'));
    el.addEventListener('click', (e) => { e.stopPropagation(); if (busy) return; if (sound) snd.play(sound); fn(e); });
  }
  ui.tap = tap;

  // ---------- screens + wipe transition ----------
  function swap(name) {
    for (const k in screens) $(screens[k]).classList.add('hidden');
    $('result').classList.add('hidden');
    if (wm && name !== 'career') wm.stop();
    const el = $(screens[name]);
    el.classList.remove('hidden'); el.classList.remove('enter'); void el.offsetWidth; el.classList.add('enter');
    clearTimeout(el._et); el._et = setTimeout(() => el.classList.remove('enter'), 1300);
    cur = name;
    S.hideResultScene();
    S.rei(name === 'garage');
    document.body.classList.add('inMeta');
    if (!ui._pre) { ui._pre = setTimeout(() => C.preloadArt(MAP.files()), 1500); }
    if (name === 'garage') { gKey = ui._gKey && P.CARS[ui._gKey] ? ui._gKey : save.car; ui._gKey = null; gPaint = null; closePart(true); } else hotHint = false;
    $('topbar').classList.remove('hidden');
    $('topbar').classList.toggle('noback', name === 'menu');
    $('scrTitle').textContent = titles[name];
    api.onScreen(name);
    render[name] && render[name]();
    if (name === 'garage' && ui._focusPart) { const fp = ui._focusPart; ui._focusPart = null; setTimeout(() => { if (cur === 'garage') ui.focusPart(fp); }, 380); }
    if (name === 'garage' && ui._guide) { const gd = ui._guide; ui._guide = null; guideStart(gd); } else if (guide && name !== 'garage') guideEnd();
    if (name !== 'menu') setTimeout(() => { if (cur === name) showBeats(); }, 900);
    refreshCurrency(false);
    document.body.dataset.scr = name;
    requestAnimationFrame(panelTop);
  }
  // speech slot on garage/upgrade sits just above the bottom panel: min.css reads --panelTop
  function panelTop() {
    const p = cur === 'garage' ? (gPart ? $('pPanel') : $('gBottom')) : null;
    if (p) document.documentElement.style.setProperty('--panelTop', p.getBoundingClientRect().top + 'px');
  }
  addEventListener('resize', () => requestAnimationFrame(panelTop));
  ui.show = (name, { instant = false } = {}) => {
    if (!M.hasCar(save) && !ob) { ui.onboard(); return; }   /* no car yet: every screen leads to the car pick */
    if (name === 'map') name = 'career';
    if (name === 'upgrade') { name = 'garage'; hotHint = true; } // UPGRADE = the garage with the hotspots highlighted
    if (instant) { swap(name); return; }
    wipe(() => swap(name));
  };
  function wipe(mid) {
    const w = $('wipe');
    busy = true;
    w.classList.remove('go'); void w.offsetWidth; w.classList.add('go');
    snd.play('menu_swipe', { detune: 0.08 });
    setTimeout(() => { mid(); }, 290);
    setTimeout(() => { busy = false; w.classList.remove('go'); }, 620);
  }
  ui.wipe = wipe;
  ui.current = () => cur;
  ui.hideAll = () => { delete document.body.dataset.scr; if (wm) wm.stop(); for (const k in screens) $(screens[k]).classList.add('hidden'); $('topbar').classList.add('hidden'); cur = null; S.rei(false); S.hideResultScene(); document.body.classList.remove('inMeta'); };

  tap($('backBtn'), () => { if (guide) guideEnd(); if (cur === 'garage' && gPart) { closePart(); return; } ui.show('menu'); });

  // ---------- currency ----------
  function refreshCurrency(animate) {
    if (!animate) { shownCoins = save.coins; shownGems = save.gems; }
    $('coinVal').textContent = pillFmt(shownCoins); $('gemVal').textContent = pillFmt(shownGems);
  }
  ui.refreshCurrency = refreshCurrency;
  const bump = (el) => { el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump'); };

  // toast slot (overlay.js): one at a time under the top bar, the next waits (max 2, same text not repeated)
  function toast(msg, good = false) {
    const t = $('toast');
    O.push('toast', () => { t.innerHTML = msg; t.className = good ? 'good' : ''; void t.offsetWidth; t.className = 'show' + (good ? ' good' : ''); return 1.9; },
      () => { t.className = ''; }, { max: 2, key: msg });
  }
  ui.toast = toast;
  function spend(o) { // {coins} or {gems}; returns success
    if (o.gems) { if (save.gems < o.gems) { toast('NOT ENOUGH GEMS'); snd.play('error'); S.reiSay('broke'); return false; } save.gems -= o.gems; }
    else { if (save.coins < o.coins) { toast('NOT ENOUGH COINS'); snd.play('error'); S.reiSay('broke'); return false; } save.coins -= o.coins; }
    persist(); bump($(o.gems ? 'gemPill' : 'coinPill'));
    shownCoins = save.coins; shownGems = save.gems;
    rollText($('coinVal'), pillFmt(save.coins), 450); rollText($('gemVal'), pillFmt(save.gems), 450);
    return true;
  }

  // ---------- menu ----------
  function careerPos() {
    for (const t of M.TIERS) if (M.tierOpen(save, t) && save.career[t] < M.RUNGS) return { t, i: save.career[t] };
    return { t: 'S', i: M.RUNGS - 1, done: true };
  }
  const render = {};
  render.menu = () => {
    const p = careerPos(), ri = M.rungInfo(p.t, p.i);
    $('careerSub').textContent = p.done ? 'ALL CROWNS WON' : ri.isBoss ? `TIER ${p.t} · BOSS: ${ri.name}` : `TIER ${p.t} · RIVAL ${p.i + 1}/${M.RUNGS}`;
    $('dailyTag').classList.toggle('hidden', save.daily === M.today());
    const mt = M.carTier(save.car); $('menuTier').textContent = mt; $('menuCarName').textContent = P.CARS[save.car].name;
    renderDaily(); setTimeout(maybeClaim, 600);
    if (!hotLoop) hotLoop = requestAnimationFrame(hotFrame);
    if (save.carGift) setTimeout(() => { if (cur === 'menu') showGift(); }, 450);
    renderMenuNext();
    setTimeout(() => { if (cur === 'menu') showBeats(); }, 700);
    if (save.prog && save.prog.catchup) { const n = save.prog.catchup; delete save.prog.catchup; persist(); setTimeout(() => toast(`NEW IN YOUR GARAGE: ${n.join(' · ')}`, true), 1200); }
  };
  /* the next car to save for (unlocked, not owned) or the next career unlock: a progress plate under the car name */
  function nextCarInfo() {
    const k = M.CAR_ORDER.find((q) => M.CAR_META[q].unlockD && M.carUnlocked(save, q) && !save.owned.includes(q) && M.tierOpen(save, M.carTier(q)));
    return k ? { k, price: M.CAR_META[k].price, left: Math.max(0, M.CAR_META[k].price - save.coins) } : null;
  }
  ui.nextCarInfo = nextCarInfo;
  function nextHTML() {
    const nc = nextCarInfo();
    if (nc) return `<i class="nxImg" style="background-image:url(sprites/thumb_${nc.k}.webp)"></i><div class="nxTx"><small>NEXT CAR</small><b>${P.CARS[nc.k].name}</b>`
      + `<em>${nc.left ? `${coinI}${fmt(nc.left)} TO GO` : 'READY AT THE DEALER!'}</em><u><i style="transform:scaleX(${Math.min(1, save.coins / nc.price).toFixed(3)})"></i></u></div>`;
    const nb = M.nextBeat(save); if (!nb) return '';
    const I = M.beatInfo(nb.b);
    return `${beatIcon(nb.b, 'nxImg')}<div class="nxTx"><small>NEXT UNLOCK</small><b>${I.name}${nb.b.kind === 'rim' ? ' RIMS' : ''}</b><em>${nb.left} CAREER WIN${nb.left > 1 ? 'S' : ''}</em></div>`;
  }
  function renderMenuNext() {
    let el = $('menuNext');
    if (!el) { el = document.createElement('button'); el.id = 'menuNext'; el.className = 'nextPlate'; $('careerBtn').after(el); tap(el, () => { const nc = nextCarInfo(); if (nc) { ui._gKey = nc.k; ui.show('garage'); } else ui.show('career'); }); }
    const h = nextHTML(); el.innerHTML = h; el.classList.toggle('hidden', !h || !M.hasCar(save));
    el.classList.toggle('ready', !!(nextCarInfo() && !nextCarInfo().left));
  }
  tap($('careerBtn'), () => ui.show('career'), 'ui_confirm');
  tap($('garageBtn'), () => ui.show('garage'));
  // ---------- daily challenge card + login streak (daily.js) ----------
  const hms = (x) => [x / 3600, (x % 3600) / 60, x % 60].map((n) => String(Math.floor(n)).padStart(2, '0')).join(':');
  function renderDaily() {
    const { c, best, paid } = D.dailyState(save), t = c.targets;
    $('dThumb').style.backgroundImage = `url(sprites/thumb_${c.car}.webp)`;
    $('dName').innerHTML = 'DAILY · ' + P.CARS[c.car].name + (c.type && c.type !== 'drag' ? `<span class="rtChip rt_${c.type}">${M.TYPE_INFO[c.type].icon}${M.TYPE_INFO[c.type].name}</span>` : '');
    const beat = (m) => best > 0 && best <= t[m]; // a medal lights only once that target was beaten today
    $('dSub').innerHTML = ['g', 's', 'b'].map((m) => `<span class="dT ${m}${beat(m) ? ' hit' : ''}">${t[m].toFixed(2)}</span>`).join('') + `<br>BEST TODAY ${best > 0 ? best.toFixed(3) + 's' : '--'}`;
    for (const i of $('dMedals').children) i.classList.toggle('on', beat(i.dataset.m));
    $('dTime').textContent = 'NEW IN ' + hms(D.untilNext());
  }
  setInterval(() => { if (cur === 'menu') $('dTime').textContent = 'NEW IN ' + hms(D.untilNext()); }, 1000);
  tap($('dailyBtn'), () => { const { c } = D.dailyState(save); wipe(() => api.startRace({ mode: 'daily', car: c.car, levels: c.levels, type: c.type })); }, 'ui_confirm');
  ui.dailyFinish = (et) => {
    const out = D.finishDaily(save, et || 0), { c } = D.dailyState(save);
    ui._dres = { medal: out.medal, t: c.targets, et };
    const unlock = out.item ? `UNLOCKED: ${out.item.name} ${out.item.kind === 'rim' ? 'RIMS' : out.item.kind === 'paint' ? 'PAINT' : ''}` : '';
    if (out.gems) out.lines.push(['DAILY SILVER GEMS', 0]);
    return { lines: out.lines.filter((l) => l[1] > 0), coins: out.coins, gems: out.gems, unlock };
  };
  // streak sheet: auto once on the first menu of the day, and any time from the gift icon in the top bar
  function streakView() { // {day shown, claimed today?, reward}
    const due = D.streakDue(save), st = save.streak || { n: 0 };
    return due ? { day: due.day, done: false, reward: due.reward } : { day: st.n || 1, done: true, reward: D.STREAK[(st.n || 1) - 1] };
  }
  function renderStreakBtn() {
    const v = streakView(), b = $('streakBtn');
    /* CrazyGames review: no "0" next to the dot. Due = the dot only; claimed = the streak day number */
    const n = v.done ? v.day : 0;
    $('stN').textContent = n > 0 ? n : '';
    $('stN').classList.toggle('hidden', !(n > 0));
    b.classList.toggle('due', !v.done);
  }
  const hideImg = 'onerror="this.style.visibility=\'hidden\'"';
  const rwHtml = (q, big) => q.car ? (big ? `<img src="sprites/thumb_${q.car}.webp" alt="" ${hideImg}>${P.CARS[q.car].name}` : 'CAR')
    : q.item ? (big ? 'RARE: ' + ((D.rareItems(q.item).find((x) => !D.owns(save, x)) || { name: '1,000 COINS' }).name) : 'RARE')
    : q.gems ? `${gemI}${big ? ' ' + q.gems + ' GEMS' : q.gems}` : `${coinI}${big ? ' ' + fmt(q.coins) + ' COINS' : q.coins >= 1000 ? (q.coins / 1000) + 'K' : q.coins}`;
  function openStreak() {
    const v = streakView(), r = v.reward, w0 = Math.floor((v.day - 1) / 7) * 7; // the current week of 7
    const got = v.day - (v.done ? 0 : 1); // days claimed so far in this run
    $('clTitle').textContent = `DAY ${v.day}`;
    $('clDays').innerHTML = D.STREAK.slice(w0, w0 + 7).map((q, j) => { const i = w0 + j;
      return `<i class="${i < got ? 'done' : i === v.day - 1 ? 'now' : ''}${q.car || q.item ? ' ms' : ''}"><b>${i + 1}</b><small>${rwHtml(q)}</small></i>`; }).join('');
    // 30-day track: progress + the two reward cars as milestones
    const pct = (d) => ((d - 0.5) / D.STREAK_LEN * 100).toFixed(1) + '%';
    $('clTrack').innerHTML = `<div class="trk"><i style="width:${pct(got + 0.5)}"></i></div>`
      + D.STREAK.map((q, i) => q.car ? `<span class="trkCar${got >= i + 1 ? ' got' : ''}" style="left:${pct(i + 1)}"><img src="sprites/thumb_${q.car}.webp" alt="" ${hideImg}><b>DAY ${i + 1}</b></span>` : '').join('');
    $('clRw').innerHTML = (v.done ? 'CLAIMED TODAY · ' : '') + rwHtml(r, true);
    $('clBtn').classList.toggle('hidden', v.done);
    $('clClose').classList.toggle('hidden', !v.done);
    $('claim').classList.remove('hidden');
  }
  function maybeClaim() {
    renderStreakBtn();
    if (!D.streakDue(save) || ui._claimShown || cur !== 'menu' || save.carGift || beatsWaiting() || beatOn) return;
    if (!((save.sessions || 0) >= 2)) return;   /* never on the very first visit (the gift icon's dot still invites it) */
    ui._claimShown = true;
    openStreak();
  }
  tap($('streakBtn'), () => openStreak());
  tap($('clClose'), () => $('claim').classList.add('hidden'));
  $('claim').addEventListener('click', (e) => { if (e.target.id === 'claim') $('claim').classList.add('hidden'); });
  tap($('clBtn'), () => {
    const out = D.claimStreak(save); persist();
    $('claim').classList.add('hidden');
    if (!out) return;
    snd.play('purchase');
    shownCoins = save.coins - out.coins; shownGems = save.gems - out.gems; refreshCurrency(true);
    coinFly($('clBtn'), $(out.gems ? 'gemPill' : 'coinPill'), 8, out.gems || out.coins, out.gems ? 'gem' : 'coin');
    toast(out.car ? `${P.CARS[out.car].name} IS YOURS!` : out.item ? `${out.item.name} UNLOCKED` : `DAY ${out.day} CLAIMED`, true);
    renderDaily(); renderStreakBtn();
  }, null);
  tap($('quickBtn'), () => wipe(() => api.startRace({ mode: 'quick' })), 'ui_confirm');

  // ---------- garage (merged with upgrade): the live car centred, hotspots ON the car, a part panel per hotspot ----------
  // Hotspot anchors are in the car's root space (x: 0 = nose, -len = tail; y: up from the road; z: the camera-side flank),
  // projected through the scene camera every frame (window.__g.cam / pView) so they stick to the car. Tapping one
  // eases the meta camera toward the part (main.js META_CAM.garage, exposed on __g) and slides the part panel in.
  let gKey = save.car, gPaint = null, gPart = null, hotLoop = 0, hotHint = false;
  const ownCar = (k) => save.owned.includes(k);
  const carOpen = (k) => !M.streakCar(k) && M.tierOpen(save, M.carTier(k)) && M.carUnlocked(save, k);
  const lockWhy = (k) => (!M.tierOpen(save, M.carTier(k)) ? `BEAT THE TIER ${M.TIERS[M.tierIdx(M.carTier(k)) - 1]} BOSS` : `WIN ${M.carUnlockAt(k)} CAREER RACES`);
  const PART_ICON = { engine: 0, turbo: 1, gearbox: 2, nitro: 3, tires: 4, weight: 5, intake: 6, ecu: 7, intercooler: 8, fuel: 9, clutch: 10, diff: 11, suspension: 12 };
  // 5 hotspot clusters; each opens a panel: UPGRADE = list of its parts (tap one for before -> after + buy), STYLE = its
  // cosmetics. 'exhaust' in a part list = the sound choice (stock / sport / straight pipe)
  const HOT = [ // id, label, anchor(v) -> [x, y] in metres, parts[], styles[]
    ['engine', 'ENGINE', (v) => [-v.len * 0.18, v.hh * 0.78], ['engine', 'turbo', 'intake', 'intercooler', 'ecu', 'fuel'], []],
    ['drive', 'DRIVETRAIN', (v) => [-v.len * 0.5, v.hh * 0.3], ['gearbox', 'clutch', 'diff'], []],
    ['chassis', 'CHASSIS', (v) => [v.ws[1].x, v.ws[1].r], ['suspension', 'tires', 'weight'], ['rims']],
    ['exhaust', 'EXHAUST', (v) => [-v.len + 0.12, v.hh * 0.62], ['nitro'], ['sound', 'flame']], // above the tail, clear of the flame
    ['body', 'BODY', (v) => [-v.len * 0.68, v.hh * 0.66], [], ['paint', 'decal', 'tint', 'glow', 'smoke']],
  ];
  const STYLE_NAME = { sound: 'SOUND', rims: 'RIMS', paint: 'PAINT', decal: 'DECAL', tint: 'TINT', glow: 'GLOW', smoke: 'SMOKE', flame: 'FLAME' };
  const hotOf = (id) => HOT.find((h) => h[0] === id);
  let pTab = 'up', gSub = null, gStyle = null;
  const ICON_SVG = {
    body: '<svg class="i" viewBox="0 0 24 24"><path d="M12 3.5c3.5 4.2 5.5 7.2 5.5 9.8a5.5 5.5 0 0 1-11 0c0-2.6 2-5.6 5.5-9.8z"/></svg>',
    chassis: '<svg class="i" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2"/><path d="M12 10V3.5M14 12.6l6 2.2M10 12.6l-6 2.2M13.2 13.6l3.8 5.3M10.8 13.6 7 18.9"/></svg>',
    exhaust: '<svg class="i" viewBox="0 0 24 24"><path d="M3 10h11v5H3zM14 11h4l3-1.5v6L18 14h-4"/><path d="M5 7.5c1-1 2-1 3 0s2 1 3 0M5 18c1-1 2-1 3 0s2 1 3 0"/></svg>',
    drive: '<svg class="i" viewBox="0 0 24 24"><path d="M6 5v14M12 5v14M18 5v7M6 12h12"/><circle cx="6" cy="4" r="1.2"/><circle cx="12" cy="4" r="1.2"/><circle cx="18" cy="4" r="1.2"/></svg>',
  };
  const icoHtml = (id) => ICON_SVG[id] || (PART_ICON[id] != null ? `<span class="ico up${PART_ICON[id]}"></span>` : ICON_SVG.body);
  function partState(pid) { // performance part -> {part, lv, cap, max, price, can} (null: none / car not owned)
    const k = gKey, part = M.PARTS.find((p) => p.id === pid);
    if (!part || !ownCar(k)) return null;
    const L = M.upOf(save, k), lv = L[pid], cap = M.partCap(L, pid), price = M.partPrice(part, lv, M.carTier(k)), open = M.partOpen(save, pid);
    return { part, lv, cap, max: lv >= M.MAX_LV, price, open, can: open && lv < cap && save.coins >= price };
  }
  const clusterCan = (h) => h[3].some((pid) => { const st = partState(pid); return st && st.can; });
  const clusterLv = (h) => { const ps = h[3].map(partState).filter(Boolean); return ps.length ? ps.reduce((a, s) => a + s.lv, 0) / (ps.length * M.MAX_LV) : -1; };
  function buildHot() {
    const box = $('hot');
    if (box.children.length) return;
    for (const [id, label] of HOT) {
      const b = document.createElement('button');
      b.className = 'hs'; b.dataset.id = id; b.setAttribute('aria-label', label);
      b.innerHTML = `<span class="hsRing">${icoHtml(id)}</span><span class="hsPips"></span><span class="hsLbl">${label}</span>`;
      b.addEventListener('pointerdown', (e) => e.stopPropagation());
      b.addEventListener('click', (e) => { e.stopPropagation(); api.audioInit(); if (ob && !(ob === 1 && id === 'engine')) return; snd.play('ui_click'); if (ob || !ownCar(gKey)) return; openPart(id); });   /* a car you don't own: no parts or styles (buy it first) */
      box.appendChild(b);
    }
  }
  function renderHot() {
    const own = ownCar(gKey);
    for (const b of $('hot').children) {
      const id = b.dataset.id, h = hotOf(id), f = clusterLv(h);
      b.classList.toggle('hidden', !own); /* a car you don't own: no hotspots, the BUY button is the way in */
      b.classList.toggle('can', clusterCan(h));
      b.classList.toggle('max', f >= 1);
      b.classList.toggle('sel', gPart === id);
      b.querySelector('.hsPips').innerHTML = f >= 0 ? Array.from({ length: M.MAX_LV }, (_, j) => `<i class="${j < Math.round(f * M.MAX_LV) ? 'f' : ''}"></i>`).join('') : '';
    }
    $('garage').classList.toggle('hotHint', hotHint);
  }
  // per frame: project the anchors; in focus mode steer the camera so the part sits in the free area
  /* layout rects the camera fit needs (top bar, panels, menu column...) come from a cache, so a frame does not force a
     layout. Refreshed when the screen state or size changes (then every frame for 0.45 s, so sliding panels are
