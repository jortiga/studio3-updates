const LV_PRICE = [200, 380, 650, 1000, 1500];
export const partPrice = (part, lv, tier) => (lv >= MAX_LV ? 0 : Math.round(LV_PRICE[lv] * TM[tier] * part.k / 10) * 10);
export const zeroLv = () => Object.fromEntries(PARTS.map((p) => [p.id, 0]));
/** Highest level a part can reach now (ECU levels 3-5 need the fuel system: ECU <= fuel + 2). */
export const partCap = (L, id) => (id === 'ecu' ? Math.min(MAX_LV, (L.fuel || 0) + 2) : MAX_LV);

export function modsFor(L) {
  L = { ...zeroLv(), ...(L || {}) };
  return {
    tq: (1 + 0.05 * L.engine) * (1 + 0.04 * L.turbo) * (1 + 0.012 * L.intake) * (1 + 0.015 * L.ecu) * (1 + 0.015 * L.intercooler) * (1 + 0.008 * L.fuel),
    redline: 1 + 0.012 * L.ecu,
    shift: 1 - 0.12 * L.gearbox,
    nitro: 0.035 * L.nitro, nitroDur: 0.2 * L.nitro,
    grip: (1 + 0.035 * L.tires) * (1 + 0.012 * L.diff),
    launchGrip: 1 + 0.03 * L.suspension,
    clutch: 1 - 0.13 * L.clutch,
    mass: 1 - 0.025 * L.weight,
  };
}
export const buildSpec = (key, L) => P.prepareSpec(P.CARS[key], 1, modsFor(L));

const etCache = new Map();
export function predictET(key, L) {
  const id = key + JSON.stringify(L || zeroLv());
  if (!etCache.has(id)) etCache.set(id, P.idealET(buildSpec(key, L)).et);
  return etCache.get(id);
}
export const fullLv = () => Object.fromEntries(PARTS.map((p) => [p.id, MAX_LV]));

// Stat bars 0..1 (shown in garage / upgrade)
export function stats(spec) {
  const c = (v) => Math.max(0.04, Math.min(1, v));
  return {
    POWER: c(spec.hp / 820),
    GRIP: c((spec.grip - 0.9) / 0.65),
    SHIFT: c((1.12 - spec.shiftMul) / 0.72 + (spec.gears.length - 5) * 0.06),
    NITRO: c(spec.nitro * spec.nitroDur / 2.6),
    WEIGHT: c((1650 - spec.mass) / 900),
  };
}

// Readable numbers for one part before/after a level.
export function partEffect(part, spec) {
  switch (part.id) {
    case 'engine': case 'turbo': return [['POWER', spec.hp, 'hp'], ['TORQUE', Math.round(spec.tq), 'Nm']];
    case 'gearbox': return [['PERFECT SHIFT', Math.round(60 * spec.shiftMul), 'ms'], ['GOOD SHIFT', Math.round(170 * spec.shiftMul), 'ms']];
    case 'nitro': return [['BOOST', '+' + Math.round(spec.nitro * 100), '%'], ['DURATION', spec.nitroDur.toFixed(1), 's']];
    case 'tires': return [['GRIP', (spec.grip * 100).toFixed(0), '']];
    case 'weight': return [['WEIGHT', spec.mass, 'kg'], ['HP / TON', Math.round(spec.hp / spec.mass * 1000), '']];
    case 'intake': case 'intercooler': case 'fuel': return [['POWER', spec.hp, 'hp'], ['TORQUE', Math.round(spec.tq), 'Nm']];
    case 'ecu': return [['POWER', spec.hp, 'hp'], ['REV LIMIT', Math.round(spec.redline / 10) * 10, 'rpm']];
    case 'clutch': return [['BOG / SPIN', Math.round(spec.clutchK * 100), '%']];
    case 'diff': return [['GRIP', (spec.grip * 100).toFixed(0), '']];
    case 'suspension': return [['LAUNCH GRIP', '+' + Math.round((spec.launchGrip - 1) * 100), '%']];
  }
  return [];
}

