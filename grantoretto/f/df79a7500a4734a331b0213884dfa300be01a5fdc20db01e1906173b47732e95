    const offAmt = 1 - throttle;
    const OL = this.layersOff;
    if (OL.length >= 3) {          // a full offload set (esx): neighbour crossfade, onload/offload by throttle
      let i = 0;
      while (i < OL.length - 1 && OL[i + 1].rpm <= rpm) i++;
      OL.forEach((l, k) => {
