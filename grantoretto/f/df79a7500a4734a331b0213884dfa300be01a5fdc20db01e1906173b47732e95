const GAME_IDLE = { car_hero: 950, car_silver: 900, car_yellow: 1000, car_neon: 950, car_red: 900, car_cyan: 1000, car_black: 850, car_cop: 850 };

class EngineVoice {
  constructor(id) {
    this.id = id;
    this.player = id === 'player';
    this.base = this.player ? 1 : 0.42;
    this.lpMax = this.player ? 14000 : 3600;      // the rival is "in the other lane": duller, quieter
    this.out = ctx.createGain(); this.out.gain.value = 0;
    this.cut = ctx.createGain();                  // rev-limiter chop
    this.lp = ctx.createBiquadFilter(); this.lp.type = 'lowpass'; this.lp.frequency.value = 3000; this.lp.Q.value = 0.5;
    this.pan = makePanner(this.player ? 0 : 0.28);
    this.sum = ctx.createGain();
    // exhaust chain: shelf -> note -> drive -> makeup
    this.shelf = ctx.createBiquadFilter(); this.shelf.type = 'lowshelf'; this.shelf.frequency.value = 220;
    this.note = ctx.createBiquadFilter(); this.note.type = 'peaking';
    this.shaper = ctx.createWaveShaper(); this.shaper.oversample = '2x';
    this.makeup = ctx.createGain();
