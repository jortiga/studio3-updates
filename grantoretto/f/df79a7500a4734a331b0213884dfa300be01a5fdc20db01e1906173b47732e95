        const outside = rpm < L[0].rpm || rpm > L[L.length - 1].rpm;
        if (w[k] > 0.001 || l.g.gain.value > 0.001) ramp(l.src.playbackRate, outside ? clamp(rpm / l.rpm, RMIN, RMAX) : clamp(rpm / l.rpm, 0.4, 2.5), T_RATE);
      });
