      .connect(this.lp).connect(this.cut).connect(this.out).connect(this.pan).connect(engineBus);
    this.onBus = ctx.createGain(); this.onBus.connect(this.sum);
    this.offBus = ctx.createGain(); this.offBus.gain.value = 0; this.offBus.connect(this.sum);
    this.layersOn = []; this.layersOff = [];
    this.buildSynth();
    this.last = 0; this.silent = true; this.nextCut = 0; this.prevThr = 0; this.nextPop = 0;
    this.state = { rpm: 900, maxRpm: 8000, throttle: 0, load: 0 };
    this.cls = null; this.exhaust = null;
    this.setProfile({});
  }

  buildSynth() {
    this.synthBus = ctx.createGain(); this.synthBus.gain.value = 0; this.synthBus.connect(this.sum);
    this.synthLp = ctx.createBiquadFilter(); this.synthLp.type = 'lowpass'; this.synthLp.Q.value = 1.2;
    this.synthLp.connect(this.synthBus);
    this.osc1 = ctx.createOscillator(); this.osc2 = ctx.createOscillator();
    this.g1 = ctx.createGain(); this.g1.gain.value = 0.5; this.g2 = ctx.createGain(); this.g2.gain.value = 0.22;
    this.osc1.connect(this.g1).connect(this.synthLp); this.osc2.connect(this.g2).connect(this.synthLp);
    this.noise = ctx.createBufferSource(); this.noise.buffer = noiseBuf; this.noise.loop = true;
    this.noiseBp = ctx.createBiquadFilter(); this.noiseBp.type = 'bandpass'; this.noiseBp.Q.value = 0.9;
    this.noiseGain = ctx.createGain(); this.noiseGain.gain.value = 0;
    this.noise.connect(this.noiseBp).connect(this.noiseGain).connect(this.sum);
    const t = ctx.currentTime;
    this.osc1.start(t); this.osc2.start(t); this.noise.start(t, Math.random());
  }

  /** {engine, car, exhaust} -> switch class (lazy-loads its loops) and/or exhaust DSP. */
  setProfile(o = {}) {
    if (o.car) this.car = o.car;
    if (o.sound) this.sound = { ...(this.sound || {}), ...o.sound };
    const sw = this.sound && SWAP_CLASS[this.sound.swap];
    if (sw && !o.engine && (o.car || o.sound)) o = { ...o, engine: sw };   // cosmetic engine swap
    if (!manifest) { this.pending = { ...(this.pending || {}), ...o }; }
    const cls = manifest ? classOf(o.engine || o.car ? o : { engine: this.cls }) : (this.cls || 'i4t');
    if (cls && cls !== this.cls) {
      this.dropLayers();
      this.cls = cls;
      const syn = SYN[cls] || SYN.i4t;
      this.osc1.type = syn.o1; this.osc2.type = syn.o2; this.g2.gain.value = syn.g2;
      this.syn = syn; this.ppr = manifest?.engines?.[cls]?.ppr || PPR[cls] || 2;
      if (manifest) { ensureClass(cls).then(() => { if (this.cls === cls) this.attachSamples(); }); releaseUnusedClasses(); }
      this.applyExhaust(this.exhaust || 'sport');
    }
    if (o.exhaust && EXH[o.exhaust] && o.exhaust !== this.exhaust) this.applyExhaust(o.exhaust);
    else if (!this.exhaust) this.applyExhaust('sport');
  }

  applyExhaust(name) {
    const x = EXH[name] || EXH.sport;
    this.exhaust = name; this.ex = x;
    const noteHz = manifest?.engines?.[this.cls]?.note || 800;
    ramp(this.shelf.gain, x.shelf, 0.05);
    this.note.frequency.value = noteHz; this.note.Q.value = x.q; ramp(this.note.gain, x.note, 0.05);
    this.shaper.curve = driveCurve(x.drive);
