// Drag Nights Race audio: sample-based engine (RPM-crossfaded constant-RPM loops), one-shots, loops, music,
// announcer lines and the voiced cast. Files + loop points + the measured RPM of each engine loop come from
// audio/manifest.json (made by tools/make_audio.py); the cast's lines and subtitles from cast.json.
// Nothing here throws: a missing file is logged once and skipped.
//
//   import Audio from './audio.js';
//   Audio.init();                                   // on the first tap/click (safe to call again)
//   Audio.setEngine('player', {rpm, maxRpm, throttle, load});   // every frame; also 'rival'
//   Audio.setRaceState({rpm, maxRpm, boost, speed, throttle});  // every frame in a race: turbo + gear whine
//   Audio.play('shift'); Audio.startLoop('rain'); Audio.music('race'); Audio.setVolume({music: 0.5});
//   Audio.say('three');                             // announcer (ducks music/engines, rate-limited by priority)
//   const secs = Audio.voice('rei', 'greet');       // cast line (one at a time; returns its duration)
//   Audio.setOption({countdownLang: 'en'|'jp', countdownVoice: 'announcer'|'mika', announcer: true|false});
//
// Menu music is fetched first (a small intro clip + the full loop) and starts on the very first tap anywhere.

const BASE = new URL('./audio/', import.meta.url);
const CAST_URL = new URL('./cast.json', import.meta.url);
const T_RATE = 0.022;      // smoothing time constants (s) for setTargetAtTime
const T_GAIN = 0.035;
const T_FILT = 0.05;
const MENU_INTRO = 'music_menu_intro.mp3';
const MENU_FULL = 'music_menu.mp3';

let ctx = null;
let manifest = null;
let manifestPromise = null;
let cast = null;
let master, comp, sfxBus, musicBus, engineBus, duckM, duckE, voiceBus, bedM;
const buffers = new Map();      // file -> AudioBuffer
const loading = new Map();      // file -> Promise<AudioBuffer|null>
const prefetched = new Map();   // file -> Promise<ArrayBuffer|null> (bytes fetched before the context exists)
const warned = new Set();
const vol = { master: 1, sfx: 1, music: 0.8, voice: 1 };
const mix = { samples: 1, synth: 0.35 };   // engine layer levels (tunable from the test page)
const opt = { countdownLang: 'en', countdownVoice: 'announcer', announcer: true, autoMenu: true };
const engines = new Map();
const loops = new Map();
let musicState = { name: null, src: null, gain: null, want: undefined };
let noiseBuf = null;
let watchdog = null;
let raceLast = 0;
const history = [];             // {t, kind, name, played} for tests / subtitles
let speech = null;              // {src, g, pri, end, kind}
let lastSay = { t: -1e9, pri: 0 };
let duckUntil = 0;

function warnOnce(key, ...msg) {
  if (warned.has(key)) return;
  warned.add(key);
  console.warn('[audio]', ...msg);
}

const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
function ramp(param, value, tau) {
  try { param.setTargetAtTime(value, ctx.currentTime, tau); } catch { param.value = value; }
}

// ------------------------------------------------------------------------------------------------
// Loading. Menu music bytes are requested the moment this module is imported (no context needed),
// everything else after them so they get the bandwidth first.
// ------------------------------------------------------------------------------------------------
function fetchBytes(file) {
  if (!prefetched.has(file)) {
    prefetched.set(file, fetch(new URL(file, BASE))
      .then((r) => { if (!r.ok && r.status !== 0) throw new Error(`HTTP ${r.status}`); return r.arrayBuffer(); })   /* iOS app: media come back with status 0 */
      .catch((e) => { warnOnce(file, `could not load ${file}:`, e.message || e); return null; }));
  }
  return prefetched.get(file);
}
const introBytes = fetchBytes(MENU_INTRO);
fetchBytes(MENU_FULL);
const manifestFetch = fetch(new URL('manifest.json', BASE), { cache: 'no-cache' })
  .then((r) => { if (!r.ok && r.status !== 0) throw new Error(`HTTP ${r.status}`); return r.json(); })
  .catch((e) => {
    warnOnce('manifest', 'no audio/manifest.json, running with the synth engine only:', e.message || e);
    return { engine: { cyl: 4, on: [], off: [] }, sfx: {}, loops: {}, music: {}, voice: {}, cast: {} };
  });
const castFetch = fetch(CAST_URL, { cache: 'no-cache' }).then((r) => (r.ok || r.status === 0 ? r.json() : null)).catch(() => null)
  .then((c) => { cast = c; return c; });

function decode(ab) {
  return new Promise((resolve, reject) => {
    const p = ctx.decodeAudioData(ab, resolve, reject);   // callback form for old Safari
    if (p && p.then) p.then(resolve, reject);
  });
}

function load(file) {
  if (!file) return Promise.resolve(null);
  if (buffers.has(file)) return Promise.resolve(buffers.get(file));
  if (loading.has(file)) return loading.get(file);
  const p = fetchBytes(file)
    .then((ab) => (ab ? decode(ab) : null))
    .then((buf) => { if (buf) buffers.set(file, buf); return buf; })
    .catch((e) => { warnOnce(file, `could not decode ${file}:`, e.message || e); return null; });
  loading.set(file, p);
  return p;
}

function loadManifest() {
  if (manifestPromise) return manifestPromise;
  manifestPromise = manifestFetch.then((m) => {
    manifest = m;
    // menu first, then the engine (what the race needs), then one-shots, loops, voices. Race music on demand.
    const first = Promise.all([load(MENU_INTRO), load(MENU_FULL)]).catch(() => null);
    first.then(() => {
      engines.forEach((v) => { if (v.sim || v.baked) return; const pend = v.pending || {}; v.pending = null; v.cls = null; v.setProfile(pend); });
      if (engMode === 'classic') ensureClass(classOf({}));      /* the default class; others load when a race needs them (baked: only if a car falls back) */
      else if (engMode === 'baked') loadBaked();
      for (const e of Object.values(m.engines || {})) Object.values(e.sfx || {}).forEach((n) => { const s = m.sfx?.[n]; if (s) load(s.file); });
      Object.values(m.sfx || {}).forEach((s) => load(s.file));
      Object.values(m.loops || {}).forEach((s) => load(s.file));
      for (const lang of ['en', 'jp']) Object.values(m.voice?.[lang] || {}).forEach((s) => load(s.file));
      Object.values(m.cast || {}).forEach((c) => Object.values(c).forEach((s) => load(s.file)));
      /* user (2026-11-14): everything loads up front, nothing on demand (first plays hitched): every music track. Baked
         engines: every set's bytes are prefetched (loadBaked), but only the sets the engines use are decoded (KEEP_ALL_BAKED) */
      Object.values(m.music || {}).forEach((s) => s && s.file && load(s.file));
    });
    return m;
  });
  return manifestPromise;
}

// ------------------------------------------------------------------------------------------------
// Context + buses
// ------------------------------------------------------------------------------------------------
function makeContext() {
  const AC = window.AudioContext || window.webkitAudioContext;
  if (!AC) { warnOnce('noac', 'Web Audio is not available'); return null; }
  let c = null;
  // 44.1 kHz = the files' rate, so loop points land on exact samples (falls back if refused)
  let coarse = false; try { coarse = matchMedia('(pointer: coarse)').matches; } catch { /* ignore */ }
  try { c = new AC({ sampleRate: 44100, latencyHint: coarse ? 'playback' : 'interactive' }); } catch { /* older browsers */ }
  if (!c) { try { c = new AC(); } catch (e) { warnOnce('acfail', 'AudioContext failed', e); return null; } }
  return c;
}

function buildGraph() {
  master = ctx.createGain();
  comp = ctx.createDynamicsCompressor();       // gentle bus limiter so stacked sounds don't clip
  comp.threshold.value = -10; comp.knee.value = 8; comp.ratio.value = 6;
  comp.attack.value = 0.004; comp.release.value = 0.18;
  master.connect(comp).connect(ctx.destination);
  sfxBus = ctx.createGain(); sfxBus.connect(master);
  duckM = ctx.createGain(); duckM.connect(master);
  bedM = ctx.createGain(); bedM.connect(duckM);           // music under the engines while they run
  musicBus = ctx.createGain(); musicBus.connect(bedM);
  duckE = ctx.createGain(); duckE.connect(sfxBus);
  engineBus = ctx.createGain(); engineBus.gain.value = 3.73; /* user: engines +15%, then +80% twice (2026-11-14, baked engine) = 1.15 x 1.8 x 1.8 */ engineBus.connect(duckE);
  voiceBus = ctx.createGain(); voiceBus.connect(master);
  master.gain.value = vol.master; sfxBus.gain.value = vol.sfx; musicBus.gain.value = vol.music;
  voiceBus.gain.value = vol.voice * vol.sfx;
  // white noise for the synth layer
  noiseBuf = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);
  const d = noiseBuf.getChannelData(0);
  for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
}

function unlock() {
  if (!ctx) return;
  if (ctx.state !== 'running') ctx.resume().catch(() => {});
  // iOS: playing one silent buffer inside the gesture fully unlocks output
  try {
    const s = ctx.createBufferSource();
    s.buffer = ctx.createBuffer(1, 1, ctx.sampleRate);
    s.connect(ctx.destination); s.start(0);
  } catch { /* ignore */ }
}

// First gesture anywhere on the page: create the context and start the menu music right away.
const GESTURES = ['pointerdown', 'touchstart', 'mousedown', 'keydown'];
function firstGesture() {
  GESTURES.forEach((ev) => document.removeEventListener(ev, firstGesture, true));
  Audio.init();
  if (opt.autoMenu && musicState.want === undefined) Audio.music('menu');
}
if (typeof document !== 'undefined') GESTURES.forEach((ev) => document.addEventListener(ev, firstGesture, { capture: true, passive: true }));

function makePanner(pan) {
  if (ctx.createStereoPanner) { const p = ctx.createStereoPanner(); p.pan.value = pan; return p; }
  return ctx.createGain();   // no panning on very old Safari
}

// ------------------------------------------------------------------------------------------------
// Engine classes + exhaust
// ------------------------------------------------------------------------------------------------
// Synth glue per class: osc1 at the firing frequency (rpm/60 * pulses per rev), osc2 at a sub-order
// (d2 x firing) for the class's character: boxer/V8 lope, rotary buzz, smooth six.
const SYN = {
  i4t: { o1: 'sawtooth', o2: 'square', d2: 0.5, g2: 0.22, lp: 1 },
  i6t: { o1: 'sawtooth', o2: 'sine', d2: 0.5, g2: 0.3, lp: 1.3 },
  rotary: { o1: 'square', o2: 'sawtooth', d2: 1, g2: 0.3, lp: 1.7 },
  boxer4t: { o1: 'sawtooth', o2: 'square', d2: 0.5, g2: 0.55, lp: 0.9 },
  v6mid: { o1: 'sawtooth', o2: 'square', d2: 0.5, g2: 0.3, lp: 1.25 },
  v8: { o1: 'sawtooth', o2: 'square', d2: 0.25, g2: 0.5, lp: 0.8 },
};
const PPR = { i4t: 2, i6t: 3, rotary: 2, boxer4t: 2, v6mid: 3, v8: 4 };
// Exhaust/muffler as DSP: low shelf (body), peaking "exhaust note" per class, saturation, brightness cap,
// level, and pops on lift-off (sport: sometimes; straight pipe: crackle + decel burble).
const EXH = {
  stock: { shelf: -4, note: 2, q: 0.9, drive: 0, level: 0.8, bright: 0.5, pops: 0 },
  sport: { shelf: 3, note: 4, q: 1.2, drive: 1.6, level: 1.0, bright: 0.85, pops: 1 },
  straight: { shelf: 5, note: 7, q: 1.6, drive: 3.6, level: 1.18, bright: 1.0, pops: 2 },
  antilag: { shelf: 5, note: 7, q: 1.6, drive: 3.8, level: 1.2, bright: 1.0, pops: 3 },    // rally anti-lag: big bangs
  popcorn: { shelf: 4, note: 6, q: 1.4, drive: 3.0, level: 1.12, bright: 0.95, pops: 4 },  // crackle tune: many small pops
};
// Engine-swap sound kits -> the closest sample class (CLASSIC backend)
const SWAP_CLASS = { v8cross: 'v8', v8flat: 'v8', i6: 'i6t', rotary2: 'rotary', flat6: 'boxer4t', v10: 'v6mid', v12: 'v6mid' };
/* CLASSIC fallback for cars the manifest does not list (same family as their LIVE engine, SIM_CAR) */
const CLASSIC_CAR = { car_neon: 'boxer4t', car_drift: 'i6t', car_hyper: 'v6mid' };
const EXHAUSTS = Object.keys(EXH);   // stock, sport, straight, antilag, popcorn
const classReady = new Map();   // cls -> Promise (all its loops decoded)
const classLoaded = new Set();  // classes whose loops are all decoded
const pendingProfiles = {};
let wakeKick = false;
const lastProfiles = {};   /* each engine's profile, so a voice rebuilt after stopEngine (pause on focus loss) keeps its car's sound */
const ENGINE_SFX = { backfire: 'pop', limiter: 'limiter', rev_blip: 'rev' };   // cls -> Promise (all its loops decoded)
const curveCache = new Map();
function driveCurve(k) {
  if (!k) return null;
  if (curveCache.has(k)) return curveCache.get(k);
  const n = 2048, c = new Float32Array(n), norm = Math.tanh(k);
  for (let i = 0; i < n; i++) { const x = i / (n - 1) * 2 - 1; c[i] = Math.tanh(k * x) / norm; }
  curveCache.set(k, c);
  return c;
}
function classOf(o = {}) {
  const engs = manifest?.engines || {};
  if (o.engine && engs[o.engine]) return o.engine;
  if (o.car && manifest?.car_engine?.[o.car] && engs[manifest.car_engine[o.car]]) return manifest.car_engine[o.car];
  if (o.car && engs[CLASSIC_CAR[o.car]]) return CLASSIC_CAR[o.car];   /* cars missing from manifest.car_engine keep their own engine */
  return engs[manifest?.default_engine] ? manifest.default_engine : Object.keys(engs)[0] || null;
}
function ensureClass(cls) {
  if (!cls || !manifest?.engines?.[cls]) return Promise.resolve(false);
  if (!classReady.has(cls)) {
    const e = manifest.engines[cls];
    const files = [...e.on, ...e.off].map((x) => x.file);
    classReady.set(cls, Promise.all(files.map(load)).then(() => { classLoaded.add(cls); return true; }));
  }
  return classReady.get(cls);
}
// Only keep the loops of the classes the engines currently use (+ the default): at most ~2 in memory.
function releaseUnusedClasses() {
  const keep = new Set([manifest?.default_engine]);
  engines.forEach((v) => keep.add(v.cls));
  for (const [cls, e] of Object.entries(manifest?.engines || {})) {
    if (keep.has(cls) || !classReady.has(cls)) continue;
    classReady.delete(cls); classLoaded.delete(cls);
    for (const x of [...e.on, ...e.off]) { buffers.delete(x.file); loading.delete(x.file); prefetched.delete(x.file); }
  }
