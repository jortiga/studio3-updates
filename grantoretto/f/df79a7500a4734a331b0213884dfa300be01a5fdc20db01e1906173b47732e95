  dropLayers() {
    const t = ctx.currentTime;
    [...this.layersOn, ...this.layersOff].forEach((l) => { try { ramp(l.g.gain, 0, 0.03); l.src.stop(t + 0.2); } catch { /* ignore */ } });
    this.layersOn = []; this.layersOff = []; this.weights = null;
  }

  attachSamples() {
    if (this.layersOn.length || this.dead || !manifest) return;
    const e = manifest.engines?.[this.cls];
    if (!e) return;
    const mk = (list, bus) => list.map((x) => {
      const buf = buffers.get(x.file);
      if (!buf) return null;
      const src = ctx.createBufferSource();
      src.buffer = buf; src.loop = true;
      src.loopStart = x.loopStart; src.loopEnd = x.loopEnd;
      src.playbackRate.value = clamp(this.state.rpm / x.rpm, 0.25, 4);
      const g = ctx.createGain(); g.gain.value = 0;
      const lv = ctx.createGain(); lv.gain.value = x.gain || 1;   // per-layer level (engine-sim suggestedVolumeDb)
      src.connect(g).connect(lv).connect(bus);
      // random phase so player and rival never comb against each other
      src.start(ctx.currentTime, x.loopStart + Math.random() * (x.loopEnd - x.loopStart));
      return { e: x, src, g, rpm: x.rpm };
    }).filter(Boolean).sort((a, b) => a.rpm - b.rpm);
    this.layersOn = mk(e.on, this.onBus);
    this.layersOff = mk(e.off, this.offBus);
  }

  pop(vol, rate = 1) {
    const name = manifest?.engines?.[this.cls]?.sfx?.pop || 'backfire';
    Audio.play(name, { volume: vol * (this.player ? 1 : 0.4), rate: rate * (0.9 + Math.random() * 0.35), pan: this.player ? 0 : 0.28, raw: true });
    (this.pops || (this.pops = [])).push({ time: ctx.currentTime, amp: clamp(vol, 0, 1) });   // for exhaust flames
    if (this.pops.length > 32) this.pops.shift();
  }

  update(p) {
    const s = this.state;
    if (p.rpm != null && isFinite(p.rpm)) s.rpm = clamp(p.rpm, 300, 20000);
    if (p.maxRpm != null && isFinite(p.maxRpm)) s.maxRpm = Math.max(1000, p.maxRpm);
    if (p.throttle != null && isFinite(p.throttle)) s.throttle = clamp(p.throttle, 0, 1);
    if (p.load != null && isFinite(p.load)) s.load = clamp(p.load, 0, 1);
    else s.load = s.throttle;
    const t = ctx.currentTime;
    this.last = performance.now();
    const { maxRpm, throttle, load } = s;
    let rpm = s.rpm;
    const rn = clamp(rpm / maxRpm, 0, 1.1);
    const x = this.ex || EXH.sport;
    const ed = manifest?.engines?.[this.cls];
    if (ed && ed.esx) {
