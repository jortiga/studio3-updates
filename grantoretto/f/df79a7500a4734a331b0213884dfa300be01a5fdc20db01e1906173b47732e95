    try { localStorage.setItem('gt_engine', engMode); } catch { /* ignore */ }
    updateEngineButtons();
    for (const [id, v] of [...engines]) { const prof = { car: v.car, engine: v.car ? undefined : (v.baseCls || v.cls), exhaust: v.exhaust }; v.destroy(); engines.delete(id); this.setEngineProfile(id, prof); }
  },

  /** What the engines are set to, plus the available classes / exhausts / car mapping. */
  engineInfo() {
    const out = { classes: Object.keys(manifest?.engines || {}), exhausts: EXHAUSTS, cars: { ...(manifest?.car_engine || {}) } };
    engines.forEach((v, id) => { out[id] = { engine: v.cls, exhaust: v.exhaust, sim: !!v.sim, simEngine: v.sim ? SIM_CLASS[v.cls]?.engine : null }; });
    out.mode = engMode;
    return out;
  },

  /** Engine class for a car id (from the manifest), e.g. 'car_black' -> 'v8'. */
  engineOf(car) { return manifest?.car_engine?.[car] || null; },

  stopEngine(id) {
    const v = engines.get(id);
    if (v) { v.destroy(); engines.delete(id); }
  },

  /** Race extras for the player car, every frame: turbo whistle follows boost, gear whine follows speed.
   *  {rpm, maxRpm, boost 0..1, speed m/s, throttle 0..1}. They fade out ~0.45 s after the calls stop. */
  setRaceState(p = {}) {
    if (!ctx) return;
    raceLast = performance.now();
    const thr = clamp(p.throttle ?? 1, 0, 1);
    const rn = p.rpm && p.maxRpm ? clamp(p.rpm / p.maxRpm, 0, 1.1) : 0.7;
    const boost = clamp(p.boost ?? rn * thr, 0, 1);
    const sp = Math.max(0, p.speed ?? 0);
    const pv = engines.get('player');
    /* the generic gear_whine loop only for the CLASSIC sample engine. Baked sets carry the Engine Sim's own whine (whL,
       pitched per gear); a baked voice still loading gets none (user 2026-11-14: its speed-swept pitch read as a jet).
       The 'turbo' loop is never started (NO_TURBO): it is only stopped here. */
    if (!pv || pv.sim || pv.baked) {   // no player engine (stopped after the line), Engine Sim or a baked set
      if (loops.has('turbo')) this.stopLoop('turbo', 0.2);
      if (loops.has('gear_whine')) this.stopLoop('gear_whine', 0.2);
      return;
    }
    if (!loops.has('gear_whine')) this.startLoop('gear_whine', { volume: 0 });
    const sn = clamp(sp / 80, 0, 1);
    this.setLoopVolume('gear_whine', 0.3 * Math.pow(sn, 0.8) * (0.35 + 0.65 * thr));
    this.setLoopRate('gear_whine', 0.85 + 0.3 * sn);
  },

  /** One-shot. opts: {volume, rate, pan, detune(random ±fraction of rate)}. Returns {stop()} or null. */
  play(name, opts = {}) {
    if (!ctx) return null;
    try {
      if (NO_TURBO && name === 'blowoff') return null;   // no turbo -> no blow-off valve
      if (name === 'nitro_start' && !opts.raw && manifest?.sfx?.nitro_hit) { nitroHit(); return null; }
      if (!opts.raw && name === 'launch') { const v = engines.get('player'); if (v && v.launch) v.launch(); const r = engines.get('rival'); if (r && r.launch) r.launch(); }
      if (!opts.raw && (name === 'shift' || name === 'shift_perfect')) {
        const v = engines.get(opts.pan < 0 ? 'rival' : 'player');
        if (v && (v.sim || v.baked)) v.shift();
      }
      if (!opts.raw && (ENGINE_SFX[name] || name === 'blowoff')) {
        const v = engines.get(opts.pan < 0 ? 'rival' : 'player');
        if (v && v.sim && v.ready && !opts.car && !opts.engine && name !== 'rev_blip') return null;   // Engine Sim makes these itself
      }
      if (!opts.raw && ENGINE_SFX[name] && manifest?.engines) {   // class-flavoured rev / pop / limiter
        const cls = opts.engine || (opts.car && manifest.car_engine?.[opts.car])
          || (opts.pan < 0 ? engines.get('rival')?.cls : engines.get('player')?.cls) || manifest.default_engine;
        const alt = manifest.engines[cls]?.sfx?.[ENGINE_SFX[name]];
        if (alt && manifest.sfx?.[alt]) name = alt;
      }
      const m = entry('sfx', name);
      if (!m) return null;
      const buf = buffers.get(m.file);
      if (!buf) { load(m.file); return null; }
      const src = ctx.createBufferSource();
      src.buffer = buf;
      let rate = opts.rate ?? 1;
      if (opts.detune) rate *= 1 + (Math.random() * 2 - 1) * opts.detune;
      src.playbackRate.value = rate;
      const g = ctx.createGain();
      g.gain.value = (m.gain ?? 1) * (opts.volume ?? 1);
      let node = src.connect(g);
      if (opts.pan) { const p = makePanner(opts.pan); node = node.connect(p); }
      node.connect(sfxBus);
      src.start();
      return { stop: (fade = 0.05) => { try { ramp(g.gain, 0, fade / 3); src.stop(ctx.currentTime + fade); } catch { /* ignore */ } } };
    } catch (e) { warnOnce(`play:${name}`, 'play failed', e); return null; }
  },

  /** Announcer line: 'three' 'two' 'one' 'go' 'ready' 'perfect_shift' 'perfect_launch' 'nitro' 'win' 'lose'
   *  'new_record' 'photo_finish' 'boss_race' 'upgrade_complete' 'welcome' (display text like "You win!" works too).
   *  Countdown lines always play (and follow countdownLang / countdownVoice); the others are rate-limited:
   *  at most one per 1.2 s unless the new one has a higher priority (GO > result > launch > shift > nitro),
   *  and never over a cast voice. Returns the duration played (0 if skipped). */
  say(line, opts = {}) {
    const key = lineKey(line);
    const rec = { t: performance.now(), kind: 'say', name: key, played: false };
    history.push(rec); if (history.length > 200) history.shift();
    if (!ctx || !manifest || !opt.announcer) return 0;
    try {
      const pri = PRI[key] ?? 10;
      const t = ctx.currentTime;
      const count = COUNT.has(key);
      if (!count && !opt.announcerAll) return 0;   // user: announcer only for the countdown (ready, 3, 2, 1, GO)
      // only hand the countdown to a cast voice when that voice's audio actually exists (else announcer)
      if (count && opt.countdownVoice !== 'announcer' && castLine(opt.countdownVoice, key)
          && manifest.cast?.[opt.countdownVoice]?.[key]) {
        const d = this.voice(opt.countdownVoice, key === 'ready' ? pickReady(opt.countdownVoice) : key, { force: true });   /* user: the same 'are you ready' every race got old: rotate the start lines */
        rec.played = d > 0; rec.via = opt.countdownVoice;
        return d;
      }
      if (!count && !opts.force) {
        if (speech && t < speech.end && (speech.kind === 'voice' || pri <= speech.pri)) return 0;
        if (t - lastSay.t < 1.2 && pri <= lastSay.pri) return 0;
      }
      const lang = count && key !== 'ready' && opt.countdownLang === 'jp' ? 'jp' : 'en';
      const m = manifest.voice?.[lang]?.[key] || manifest.voice?.en?.[key];
      if (!m) { warnOnce(`say:${key}`, `no announcer line "${key}"`); return 0; }
      const buf = buffers.get(m.file);
      if (!buf) { load(m.file); return 0; }
      lastSay = { t, pri };
      rec.played = true; rec.lang = lang;
      return speak(buf, opts.volume ?? 1, pri, 'say', count);
    } catch (e) { warnOnce(`say:${line}`, 'say failed', e); return 0; }
  },

  /** Cast line from cast.json, e.g. voice('rei', 'greet'). One voice at a time (cuts the previous one and the
   *  announcer). Returns the line's duration in seconds so the UI can time a subtitle/portrait; when the audio
   *  file is missing it still returns an estimate from the text (and logs once). */
  /** opts: {volume, rate (0.8-1.25, pitch+speed, e.g. a per-rival offset), tilt (dB high shelf)} */
  voice(charId, key, opts = {}) {
    const line = castLine(charId, key);
    const rec = { t: performance.now(), kind: 'voice', name: `${charId}.${key}`, played: false };
    history.push(rec); if (history.length > 200) history.shift();
    if (!line) { warnOnce(`cast:${charId}.${key}`, `no cast line ${charId}.${key}`); return 0; }
    const est = (line.dur || estimate(line.text)) / clamp(Number(opts.rate) || 1, 0.8, 1.25);
    if (!ctx || !manifest) return est;
    try {
      const m = manifest.cast?.[charId]?.[key];
      if (!m) { warnOnce(`castfile:${charId}`, `no audio yet for ${charId} lines (subtitles only)`); return est; }
      const buf = buffers.get(m.file);
      if (!buf) { load(m.file); return est; }
      rec.played = true; if (opts.rate) rec.rate = +(+opts.rate).toFixed(3);
      return speak(buf, opts.volume ?? 1, 200, 'voice', COUNT.has(key), opts.rate || 1, opts.tilt || 0);
    } catch (e) { warnOnce(`voice:${charId}`, 'voice failed', e); return est; }
  },

  /** Optional: nitro burn on/off with a level 0..1 (play('nitro_start') + startLoop('nitro_loop') do the same). */
  setNitro(on, level = 1) {
    if (!ctx) return;
    if (on) { if (!nitro.on) nitroHit(); this.startLoop('nitro_loop', { volume: level }); nitroOn(level); this.setLoopVolume('nitro_roar', 0.9 * level); }
    else this.stopLoop('nitro_loop', 0.25);
  },

  /** Stop whoever is talking. */
  hush() {
    if (speech && ctx) { try { ramp(speech.g.gain, 0, 0.02); speech.src.stop(ctx.currentTime + 0.08); } catch { /* ignore */ } speech = null; }
  },

  /** {countdownLang: 'en'|'jp', countdownVoice: 'announcer'|'mika', announcer: bool, autoMenu: bool} */
  setOption(o = {}) {
    if (o.countdownLang === 'en' || o.countdownLang === 'jp') opt.countdownLang = o.countdownLang;
    if (typeof o.countdownVoice === 'string') opt.countdownVoice = o.countdownVoice;
    if (o.announcer != null) opt.announcer = !!o.announcer;
    if (o.autoMenu != null) opt.autoMenu = !!o.autoMenu;
    if (o.rivalSim != null) opt.rivalSim = !!o.rivalSim;
    if (o.liveWavetables != null) opt.liveWavetables = !!o.liveWavetables;
    if (o.engineBackend) this.setEngineBackend(o.engineBackend);
  },
  getOption() { return { ...opt }; },

  /** Looping sounds: nitro_loop, crowd, wind, turbo, gear_whine, rain, coin_tick. opts {volume, rate, fade} */
  startLoop(name, opts = {}) {
    if (!ctx) return;
    if (name === 'nitro_loop' && manifest?.loops?.nitro_roar) nitroOn();
    try {
      const cur = loops.get(name);
      if (cur && !cur.stopping) { if (opts.volume != null) this.setLoopVolume(name, opts.volume); return; }
      const m = entry('loops', name);
      if (!m) return;
      const begin = (buf) => {
        if (!buf) return;
        const ex = loops.get(name);
        if (ex && !ex.stopping && ex.src) return;
        const vol0 = ex?.vol ?? opts.volume ?? 1;
        const src = ctx.createBufferSource();
        src.buffer = buf; src.loop = true; src.loopStart = m.loopStart; src.loopEnd = m.loopEnd;
        src.playbackRate.value = ex?.rate ?? opts.rate ?? 1;
        const g = ctx.createGain(); g.gain.value = 0;
        let head = src;
        if (LOOP_HP[name]) {   // no low rumble under everything: the air rush keeps only its hiss
          const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = LOOP_HP[name]; hp.Q.value = 0.7;
          head = src.connect(hp);
        }
        head.connect(g).connect(sfxBus);
        const off = m.loopStart + Math.random() * (m.loopEnd - m.loopStart);
        src.start(ctx.currentTime, off);
        const rec = { src, g, vol: vol0, m, lastSet: performance.now(), pos0: off, tAt: ctx.currentTime, rateAt: src.playbackRate.value };   /* pos0 / tAt / rateAt: loopPos() */
        loops.set(name, rec);
        ramp(g.gain, (m.gain ?? 1) * rec.vol, opts.fade ?? 0.06);
      };
      const buf = buffers.get(m.file);
      if (buf) begin(buf);
      else { loops.set(name, { pending: true, vol: opts.volume ?? 1, rate: opts.rate }); load(m.file).then((b) => { if (loops.get(name)?.pending) begin(b); }); }
    } catch (e) { warnOnce(`loop:${name}`, 'startLoop failed', e); }
  },

  stopLoop(name, fade = 0.12) {
    if (name === 'nitro_loop' && nitro.on && ctx) nitroOff();
    const rec = loops.get(name);
    if (!rec) return;
    loops.delete(name);
    if (!rec.src) return;
    rec.stopping = true;
    try { ramp(rec.g.gain, 0, fade); rec.src.stop(ctx.currentTime + fade * 6); } catch { /* ignore */ }
  },

  setLoopVolume(name, v) {
    const rec = loops.get(name);
    if (!rec) return;
    rec.vol = clamp(v, 0, 2) * (LOOP_TRIM[name] ?? 1);
    rec.lastSet = performance.now();
    if (rec.g) ramp(rec.g.gain, (rec.m.gain ?? 1) * rec.vol, 0.08);
  },

  setLoopRate(name, r) {
    const rec = loops.get(name);
    if (!rec) return;
    rec.rate = clamp(r, 0.25, 4);
    if (rec.src) { if (rec.tAt != null) { rec.pos0 = this.loopPos(name); rec.tAt = ctx.currentTime; rec.rateAt = rec.rate; } ramp(rec.src.playbackRate, rec.rate, 0.05); }
  },

  /** Where a playing loop is in its file (seconds), or null: lets visuals follow the sound (cop light bar on the siren). */
  loopPos(name) {
    const rec = loops.get(name);
    if (!rec || !rec.src || rec.tAt == null || !ctx) return null;
    const m = rec.m, len = m.loopEnd - m.loopStart;
    let p = rec.pos0 + (ctx.currentTime - rec.tAt) * rec.rateAt;
    if (p > m.loopEnd && len > 0) p = m.loopStart + ((p - m.loopStart) % len);
    return p;
  },
  loopMeta(name) { return entry('loops', name) || null; },

  /** 'menu' | 'race' | null, with a crossfade. The menu starts from a tiny intro clip if the full track is
   *  still downloading, then hands over to the full loop at the same position. */
  music(name, opts = {}) {
    musicState.want = name;
    if (!ctx) return;
    if (name === musicState.name && musicState.src) return;
    const fade = opts.fade ?? 1.2;
    if (musicState.src) {
      const { src, gain, intro } = musicState;
      ramp(gain.gain, 0, fade / 4);
      try { src.stop(ctx.currentTime + fade * 1.5); } catch { /* ignore */ }
      if (intro) { try { ramp(intro.g.gain, 0, fade / 4); intro.src.stop(ctx.currentTime + fade * 1.5); } catch { /* ignore */ } }
      musicState = { name: null, src: null, gain: null, want: name };
    }
    if (!name) return;
    const startFull = (m, buf, offset, fadeIn) => {
      if (!buf || musicState.want !== name || (musicState.src && !musicState.isIntro)) return;
      const src = ctx.createBufferSource();
      src.buffer = buf; src.loop = true; src.loopStart = m.loopStart; src.loopEnd = m.loopEnd;
      const g = ctx.createGain(); g.gain.value = 0;
      src.connect(g).connect(musicBus);
      src.start(ctx.currentTime + 0.01, offset);
      ramp(g.gain, m.gain ?? 0.5, fadeIn);
      let intro = null;
      if (musicState.isIntro) {        // hand over from the intro clip, same musical position
        intro = { src: musicState.src, g: musicState.gain };
        ramp(intro.g.gain, 0, 0.03);
        try { intro.src.stop(ctx.currentTime + 0.3); } catch { /* ignore */ }
      }
      musicState = { name, src, gain: g, want: name };
    };
    const go = () => {
      const m = entry('music', name);
      if (!m) return;
      const full = buffers.get(m.file);
      if (full) { startFull(m, full, opts.offset ?? 0, fade / 4); return; }
      if (name === 'menu') {
        load(MENU_INTRO).then((ib) => {
          if (!ib || musicState.want !== name || musicState.src || buffers.get(m.file)) return;
          const src = ctx.createBufferSource(); src.buffer = ib;
          const g = ctx.createGain(); g.gain.value = m.gain ?? 0.5;
          src.connect(g).connect(musicBus);
          const t0 = ctx.currentTime + 0.005;
          src.start(t0);
          musicState = { name, src, gain: g, want: name, isIntro: true, t0 };
        });
      }
      load(m.file).then((buf) => {
        if (musicState.isIntro && musicState.want === name) {
          startFull(m, buf, Math.max(0, ctx.currentTime + 0.01 - musicState.t0), 0.03);
        } else startFull(m, buf, opts.offset ?? 0, fade / 4);
      });
    };
    if (manifest) go(); else loadManifest().then(go);
  },

  setVolume({ master: m, sfx, music, voice } = {}) {
    if (m != null) vol.master = clamp(m, 0, 1);
    if (sfx != null) vol.sfx = clamp(sfx, 0, 1);
    if (music != null) vol.music = clamp(music, 0, 1);
    if (voice != null) vol.voice = clamp(voice, 0, 1);
    if (!ctx) return;
    ramp(master.gain, vol.master, 0.03);
    ramp(sfxBus.gain, vol.sfx, 0.03);
    ramp(musicBus.gain, vol.music, 0.03);
    ramp(voiceBus.gain, vol.voice * vol.sfx, 0.03);
  },

  getVolume() { return { ...vol }; },

  /** Tuning: {samples, synth} levels of the engine layers (defaults 1 and 0.35). */
  setEngineMix(o = {}) {
    if (o.samples != null) mix.samples = clamp(o.samples, 0, 2);
    if (o.synth != null) mix.synth = clamp(o.synth, 0, 3);
  },

  /** Every active engine voice and loop with its pitch (playbackRate) and gain. */
  debugSources() {
    const out = { engines: {}, loops: {} };
    engines.forEach((v, id) => {
      out.engines[id] = v.sim
        ? { backend: 'live', engine: v.cfg ? `${v.cfg.engine}/${v.cfg.vehicle}${v.cfg.turbo ? '+turbo' : ''}` : v.cls, ready: !!v.ready, gain: +v.out.gain.value.toFixed(3),
          source: v.engine ? (v.engine.combustion ? 'worklet' : 'wavetable') : 'loading', wavetables: !!(v.engine && v.engine.opts && v.engine.opts.wavetables) }
        : v.baked ? { backend: 'baked', engine: v.setName, ready: !!v.ready, gain: +v.out.gain.value.toFixed(3),
          layers: [...v.layersOn, ...v.layersOff, ...(v.layersFree || [])].filter((l) => l.g.gain.value > 0.01).map((l) => ({ rpm: l.rpm, rate: +l.src.playbackRate.value.toFixed(3), gain: +l.g.gain.value.toFixed(3) })) }
        : { backend: 'classic', engine: v.cls, gain: +v.out.gain.value.toFixed(3),
          synth: +(v.synthBus ? v.synthBus.gain.value : 0).toFixed(3), osc1Hz: v.osc1 ? Math.round(v.osc1.frequency.value) : 0,
          layers: [...v.layersOn, ...v.layersOff, ...(v.layersFree || [])].filter((l) => l.g.gain.value > 0.01)
            .map((l) => ({ rpm: l.rpm, rate: +l.src.playbackRate.value.toFixed(3), gain: +l.g.gain.value.toFixed(3) })) };
    });
    loops.forEach((r, n) => { if (r.src) out.loops[n] = { rate: +r.src.playbackRate.value.toFixed(3), gain: +r.g.gain.value.toFixed(3) }; });
    return out;
  },

  /** Debug info for the test page. */
  debug(id = 'player') {
    const v = engines.get(id);
    return {
      state: ctx?.state, rate: ctx?.sampleRate, loaded: buffers.size, warned: [...warned],
      music: musicState.name, intro: !!musicState.isIntro,
      engine: v?.cls, exhaust: v?.exhaust,
      layers: v ? v.layersOn.map((l, k) => ({ rpm: l.rpm, w: v.weights ? v.weights[k] : 0 })) : [],
    };
  },

  stopAll() {
    [...engines.keys()].forEach((id) => this.stopEngine(id));
    [...loops.keys()].forEach((n) => this.stopLoop(n));
    this.hush();
    this.music(null);
  },
};

export default Audio;
