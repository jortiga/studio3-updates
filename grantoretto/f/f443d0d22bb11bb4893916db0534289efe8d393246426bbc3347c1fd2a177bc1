  box-shadow: 0 0 0 calc(var(--u) * 2.5) var(--rt), 0 0 calc(var(--u) * 12) color-mix(in srgb, var(--rt) 70%, transparent), 0 calc(var(--u) * 3) calc(var(--u) * 8) rgba(0,0,0,.7);
  transition: transform .18s cubic-bezier(.2,1.4,.4,1); }
