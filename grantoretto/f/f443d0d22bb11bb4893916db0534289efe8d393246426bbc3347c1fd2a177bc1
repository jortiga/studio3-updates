/* ---------- chapter route stops (worldmap.js setRoute): one node per rung at its real place ---------- */
.pin.routed { display: none; }   /* the routed chapter shows its stops instead of the area pin */
.rStop { position: absolute; left: 0; top: 0; width: 0; height: 0; z-index: 2; }
.rStop.sel, .rStop.next { z-index: 3; }
