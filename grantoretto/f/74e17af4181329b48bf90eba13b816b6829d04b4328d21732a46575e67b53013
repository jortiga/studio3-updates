// Pooled GPU particles (one THREE.Points per system, no per-frame allocation) and the screen overlay shader.
import * as THREE from './vendor/three.module.min.js';

const PVS = `
attribute vec4 col; attribute float size;
uniform float uScale;
varying vec4 vCol;
void main(){
  vCol = col;
  vec4 mv = modelViewMatrix * vec4(position, 1.0);
  gl_PointSize = size * uScale / -mv.z;
  gl_Position = projectionMatrix * mv;
}`;
const PFS = `
uniform sampler2D map; varying vec4 vCol;
void main(){ vec4 t = texture2D(map, gl_PointCoord); gl_FragColor = vec4(vCol.rgb * t.rgb, vCol.a * t.a); }`;

export class Particles {
  constructor(max, tex, additive, order) {
    this.max = max; this.n = 0;
    const g = new THREE.BufferGeometry();
    this.pos = new Float32Array(max * 3); this.col = new Float32Array(max * 4); this.size = new Float32Array(max);
    g.setAttribute('position', new THREE.BufferAttribute(this.pos, 3).setUsage(THREE.DynamicDrawUsage));
    g.setAttribute('col', new THREE.BufferAttribute(this.col, 4).setUsage(THREE.DynamicDrawUsage));
    g.setAttribute('size', new THREE.BufferAttribute(this.size, 1).setUsage(THREE.DynamicDrawUsage));
    g.setDrawRange(0, 0);
    this.geo = g;
    this.mat = new THREE.ShaderMaterial({
      uniforms: { map: { value: tex }, uScale: { value: 500 } }, vertexShader: PVS, fragmentShader: PFS,
      transparent: true, depthTest: false, depthWrite: false, blending: additive ? THREE.AdditiveBlending : THREE.NormalBlending,
    });
    this.points = new THREE.Points(g, this.mat);
    this.points.frustumCulled = false; this.points.renderOrder = order;
    // state
    const F = (k) => new Float32Array(max * k);
    this.vel = F(3); this.life = F(1); this.maxLife = F(1); this.s0 = F(1); this.s1 = F(1); this.drag = F(1);
    this.c0 = F(4); this.c1 = F(4); this.grav = F(1);
  }
  spawn(x, y, z, vx, vy, vz, life, s0, s1, r, g, b, a, r1, g1, b1, a1, drag = 1, grav = 0) {
    if (this.n >= this.max) return;
    const i = this.n++;
    this.pos[i * 3] = x; this.pos[i * 3 + 1] = y; this.pos[i * 3 + 2] = z;
    this.vel[i * 3] = vx; this.vel[i * 3 + 1] = vy; this.vel[i * 3 + 2] = vz;
    this.life[i] = 0; this.maxLife[i] = life; this.s0[i] = s0; this.s1[i] = s1; this.drag[i] = drag; this.grav[i] = grav;
    const c0 = this.c0, c1 = this.c1, k = i * 4;
    c0[k] = r; c0[k + 1] = g; c0[k + 2] = b; c0[k + 3] = a; c1[k] = r1; c1[k + 1] = g1; c1[k + 2] = b1; c1[k + 3] = a1;
  }
  update(dt) {
    let i = 0;
    while (i < this.n) {
      this.life[i] += dt;
      if (this.life[i] >= this.maxLife[i]) { this.kill(i); continue; }
      const t = this.life[i] / this.maxLife[i], k3 = i * 3, k4 = i * 4;
      const d = Math.exp(-this.drag[i] * dt);
      this.vel[k3] *= d; this.vel[k3 + 1] = this.vel[k3 + 1] * d - this.grav[i] * dt; this.vel[k3 + 2] *= d;
      this.pos[k3] += this.vel[k3] * dt; this.pos[k3 + 1] += this.vel[k3 + 1] * dt; this.pos[k3 + 2] += this.vel[k3 + 2] * dt;
      if (this.pos[k3 + 1] < 0.02 && this.grav[i] > 0) { this.pos[k3 + 1] = 0.02; this.vel[k3 + 1] *= -0.4; }
      this.size[i] = this.s0[i] + (this.s1[i] - this.s0[i]) * Math.sqrt(t);
      const fade = t < 0.1 ? t / 0.1 : 1;
      for (let j = 0; j < 4; j++) this.col[k4 + j] = this.c0[k4 + j] + (this.c1[k4 + j] - this.c0[k4 + j]) * t;
      this.col[k4 + 3] *= fade;
      i++;
    }
    this.geo.setDrawRange(0, this.n);
    this.geo.attributes.position.needsUpdate = true; this.geo.attributes.col.needsUpdate = true; this.geo.attributes.size.needsUpdate = true;
  }
  kill(i) { // swap with last
    const j = --this.n;
    if (i === j) return;
    const cp = (a, k) => { for (let q = 0; q < k; q++) a[i * k + q] = a[j * k + q]; };
    cp(this.pos, 3); cp(this.vel, 3); cp(this.col, 4); cp(this.c0, 4); cp(this.c1, 4);
    this.life[i] = this.life[j]; this.maxLife[i] = this.maxLife[j]; this.s0[i] = this.s0[j]; this.s1[i] = this.s1[j];
    this.drag[i] = this.drag[j]; this.grav[i] = this.grav[j]; this.size[i] = this.size[j];
  }
  clear() { this.n = 0; this.geo.setDrawRange(0, 0); }
}

// Full-screen overlay (premultiplied): speed streaks + edge glow + flashes, all kept to the screen edges so the car (an
// ellipse around uC) and the road ahead stay clear; vignette. uEdge = edge flash (shift/nitro reward), uPhoto = finish
// camera flash (edge burst + slight exposure lift).
export function makeOverlay() {
  const mat = new THREE.ShaderMaterial({
    uniforms: { uTime: { value: 0 }, uAmt: { value: 0 }, uEdge: { value: 0 }, uFlashCol: { value: new THREE.Color(1, 1, 1) }, uPhoto: { value: 0 },
      uNitro: { value: 0 }, uC: { value: new THREE.Vector2(0.5, 0.45) }, uAspect: { value: 1 }, uVig: { value: 0.4 } },
    vertexShader: 'varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }',
    fragmentShader: `
varying vec2 vUv; uniform float uTime, uAmt, uEdge, uNitro, uAspect, uVig, uPhoto; uniform vec2 uC; uniform vec3 uFlashCol;
float h1(float n){ return fract(sin(n * 127.1) * 43758.5453); }
void main(){
  vec2 uv = vUv;
  // distance from the car, in an ellipse that covers the car + the road ahead (wider in landscape)
  vec2 d = (uv - uC) * vec2(uAspect, 1.0) / (uAspect < 1.0 ? vec2(0.9 * uAspect, 0.5) : vec2(1.15, 0.72));
  float r = length(d);
  float edge = smoothstep(0.6, 1.3, r);
  // speed streaks: thin horizontal lines scrolling back, only in the edge band, growing with speed
  float rows = 90.0, ry = uv.y * rows, row = floor(ry);
  float h = h1(row), h2 = h1(row + 31.7), h3 = h1(row + 77.3);
  float x = fract(uv.x * (0.3 + h3 * 0.3) + uTime * (1.4 + h * 2.2) + h * 9.0);
  float len = 0.25 + h2 * 0.35;
  float ln = smoothstep(0.0, 0.03, x) * (1.0 - smoothstep(0.03, len, x));
  float th = 1.0 - smoothstep(0.05, 0.22 + h3 * 0.2, abs(fract(ry) - 0.5));
  float on = step(0.62 - uAmt * 0.3, h2);
  float a = ln * th * on * edge * clamp(uAmt * 1.2 - 0.12, 0.0, 1.0) * 0.4;
  vec3 lc = mix(vec3(1.0, 0.95, 1.0), vec3(0.5, 0.82, 1.0), uNitro);
  float v = smoothstep(0.7, 1.6, r) * (uVig + 0.15 * uNitro);   // NOS: deeper blue-tinted edges
  vec3 rgb = lc * a + vec3(0.08, 0.25, 0.9) * edge * uNitro * 0.42 + uFlashCol * edge * edge * uEdge + vec3(1.0) * uPhoto * (0.04 + 0.4 * edge);
  gl_FragColor = vec4(rgb, clamp(v + a * 0.15, 0.0, 1.0));
}`,
    transparent: true, depthTest: false, depthWrite: false,
    blending: THREE.CustomBlending, blendSrc: THREE.OneFactor, blendDst: THREE.OneMinusSrcAlphaFactor,
  });
  const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), mat);
  mesh.frustumCulled = false;
  return mesh;
}
