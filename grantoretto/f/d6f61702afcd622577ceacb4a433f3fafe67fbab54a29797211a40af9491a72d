// 2.5D cars: the painted side sprite lofted into a real body (tumblehome greenhouse, rounded roof, plan-view taper),
// the painting projected on both sides, edge colours (sprites/cars3d.json, baked by tools/car_mesh.py) on the
// hood/roof/trunk/front/rear, cel-shaded with an ink hull. Wheels are real cylinders (tread + painted rim cap) driven
// in the vertex shader (spin, hub height, tire squash), all 4 in one draw call. Plus the suspension model.
import * as THREE from './vendor/three.module.min.js';
import * as D from './depth.js';

let DATA = null;
/* painted surfaces per car (sprites/paint_surfaces.json, written by the dev paint editor's save): { car_key: ['hood', 'face'] } */
export let PAINT = {};
export async function load3D() {
  try { const r = await fetch('sprites/cars3d.json', { cache: 'no-cache' }); DATA = r.ok || r.status === 0 ? await r.json() : null; } catch { DATA = null; }
  try { const r = await fetch('sprites/paint_surfaces.json', { cache: 'no-cache' }); PAINT = r.ok ? await r.json() : {}; } catch { PAINT = {}; }
  return DATA;
}

// ---------- suspension + body tuning: derived automatically per car, optional overrides only ----------
// fz/fp/fr: heave / pitch / roll natural frequency (Hz), z*: damping ratio, pitchK: rad of squat per g, squat: m of heave
// per g, rollK: torque-reaction roll (rad at 1 g of drive force), droop: front travel before the wheels leave the road
// (m), launchKick / shiftKick: pitch-rate impulses (rad/s), ride: ride-height offset (m, + = higher).
// Defaults come from the sprite (length, height/length = how tall the car stands) and the physics spec (torque per kg:
// stronger cars kick harder at launch and lift the nose). SUSP_OVERRIDE[key] only for cars that need it.
export const SUSP_OVERRIDE = {};
export function suspOf(key, d, spec) {
  const tall = Math.min(1.3, Math.max(0.8, (d.h * d.s) / d.len / 0.3)); // body height / length vs a typical coupe
  const pw = spec ? Math.min(1, Math.max(0, (spec.tq / spec.mass - 0.3) / 0.2)) : 0.3; // 0 = weak D car, 1 = S monster
  const len = Math.min(1.15, Math.max(0.85, d.len / 4.4));
  return { fz: 1.95 / Math.sqrt(len), zz: 0.34, fp: 1.6 / Math.sqrt(len) * (1.05 - 0.1 * tall), zp: 0.28, fr: 2.4, zr: 0.3,
    pitchK: 0.036 * tall + 0.01 * pw, squat: 0.012, rollK: 0.012 + 0.006 * pw, droop: 0.075 - 0.02 * pw,
    launchKick: 0.1 + 0.62 * pw, shiftKick: 0.24 + 0.08 * pw, ride: 0, ...(SUSP_OVERRIDE[key] || {}) };
}

// ---------- shaders ----------
const BODY_VS = `attribute vec3 eu; attribute vec3 hn; attribute float lat; uniform float hull, uHW;
varying vec2 vUv; varying vec3 vEu, vWp, vN, vLp, vNl, vVm; varying float vLat;
void main(){
  vUv = uv; vEu = eu; vLp = position; vLat = lat; vNl = normal;
  { vec3 d = cameraPosition - (modelMatrix * vec4(position, 1.0)).xyz;   /* view direction in the car's own frame (x = length, z = width): front views vs side-on */
    vVm = vec3(dot(modelMatrix[0].xyz, d), dot(modelMatrix[1].xyz, d), dot(modelMatrix[2].xyz, d)); }
  /* (the old nose slide toward the near flank plane is gone: with the full mirrored body the real 3D nose reads right from
     ahead, and the slide squashed it into a swept-back wedge at 30-60 deg, User 2026-11-14) */
  vec3 p = position;
  vec4 wp = modelMatrix * vec4(p + hn * hull, 1.0); vWp = wp.xyz;
  vN = normalize(mat3(modelMatrix) * normal);
  gl_Position = projectionMatrix * viewMatrix * wp;
}`;
/* FACE_OLD (user 2026-11-15: match the Nov 12 cars): nose / tail faces = the Nov 12 look, the painting's front / rear edge
   column per height stretched across the face (its lamp + highlight bands run across the nose), no shader grille, pill
   lamps or projected head lens. Cars with a painted nose projection (hero) keep theirs */
const FACE_OLD = true;
const BODY_FS = `${D.FOG_GLSL}
${D.LAMP_GLSL}
uniform sampler2D map, mask, nmap, edge; uniform vec3 paint, paint2, inkCol;
uniform float recolor, lumMed, lumHi, uHW, opacity, fadeY, flash, sweep, wx0, ww, shineOff, dim, metal, pearl, chrome, lightK, ripple, uTime, isHull;
uniform vec4 uCapF, uCapR;   /* nose / tail face: bottom y, top y, tip half width, lamp row y */
uniform vec4 uFaceF, uFaceR;   /* nose / tail face body colour (a = 1 body paint, recolourable) */
uniform sampler2D uLensTex; uniform vec4 uLensF, uLensR; uniform float uLensU, uLensK;
uniform sampler2D uProjF, uProjT; uniform float uProjOn; uniform vec4 uProjFR, uProjTR; uniform vec2 uProjFY[6];
/* front view height fit: world y -> painting v, piecewise linear through (y, v) pairs (PROJ fy) */
float projFV(float y) { float r = uProjFY[0].y;
  for (int i = 1; i < 6; i++) { if (y >= uProjFY[i - 1].x) r = mix(uProjFY[i - 1].y, uProjFY[i].y, clamp((y - uProjFY[i - 1].x) / max(uProjFY[i].x - uProjFY[i - 1].x, 1e-4), 0.0, 1.0)); }
  return r; }   /* projection painting (PROJ): front view (half width, y0, y1, nose-half start x), top view (x0, x1, half width, blend power) */
uniform vec3 uBandP[8], uBandO[8]; uniform float uBandX, uBandT; uniform sampler2D uBandTex; uniform vec4 uCover;   /* front lamp + grille band (BAND in carGeo): (s, bottom y, top y) control points along s = |z| + depth behind the nose (uBandX); uBandX < -50 = none */
vec2 bandOld(float s) { vec2 r = uBandO[0].yz;   /* the band the painted texture was cut for (BAND_FIT): texture rows follow it */
  for (int i = 1; i < 8; i++) { float t = clamp((s - uBandO[i - 1].x) / max(uBandO[i].x - uBandO[i - 1].x, 1e-4), 0.0, 1.0); if (s >= uBandO[i - 1].x) r = mix(uBandO[i - 1].yz, uBandO[i].yz, t); }
  return r; }
vec2 bandAt(float s) { vec2 r = uBandP[0].yz;
  for (int i = 1; i < 8; i++) { float t = clamp((s - uBandP[i - 1].x) / max(uBandP[i].x - uBandP[i - 1].x, 1e-4), 0.0, 1.0); if (s >= uBandP[i - 1].x) r = mix(uBandP[i - 1].yz, uBandP[i].yz, t); }
  return r; }
float aaS(float e, float x) { float w = max(fwidth(x), 1e-5); return smoothstep(e - w, e + w, x); }   /* painted head lens cut-out; outer edge z, width, bottom y, top y (width 0 = none); u of its front end; its uv rect on the flank painting (u0, row0, du, drow) */
uniform sampler2D uHoodTex, uFaceTex, uGlassTex, uHeadTex, uSideTex; uniform float uHoodOn, uFaceOn, uGlassOn, uHeadOn, uHeadU, uSideOn; uniform vec4 uHoodR, uFacePR, uGlassR;   /* painted hood / front face (car_<key>_hood|face.webp: colour over paint mask) */
uniform float uTintW, uBeltY, uDecal, uStripeY, uDoorX, uRoundY; uniform vec3 uDecalCol; uniform sampler2D uDecalTex;   // cosmetics
varying vec2 vUv; varying vec3 vEu, vWp, vN, vLp, vNl, vVm; varying float vLat;
void main(){
#ifdef F_HULL
  gl_FragColor = vec4(mix(inkCol * dim, fogCol(vWp), fogF(vWp)), 1.0);
#else
  /* 0 = side-on (race / staging camera), 1 = looking at the nose or tail (front / rear 3/4, dead-front, garage turntable) */
  float endV = smoothstep(0.3, 0.7, abs(normalize(vVm).x));
  float sw = min(vEu.z, 1.0);
  vec2 uv = vUv;
  if (ripple > 0.0) uv.x += sin(vWp.y * 38.0 + uTime * 4.0) * 0.005 * ripple;
  vec4 tx = texture2D(map, uv);
  /* painted SIDE layer (dev paint editor, user 2026-11-15: "can i open that and edit straight"): a layer over the whole side
     painting in its own uv (colour top half, paint mask bottom half), both flanks; the outline (alpha) stays the painting's */
  float sM = -1.0;
#ifdef F_SIDE
  if (uSideOn > 0.5) { float sv = clamp(1.0 - uv.y, 0.0, 1.0); vec4 sc = texture2D(uSideTex, vec2(uv.x, 1.0 - sv * 0.5)), sm = texture2D(uSideTex, vec2(uv.x, 0.5 - sv * 0.5));
    tx.rgb = tx.rgb * (1.0 - sc.a) + sc.rgb; if (sm.a > 0.5) sM = sm.r / sm.a; }
#endif
  /* optional paint-over of a painted side lamp rect (uCover: u0, row0, du, drow; z = 0 off, currently unused): the body
     paint just above / below it, blended down the rect, on both flanks; mask / normals read there too */
#ifdef F_COVER
  if (uCover.z > 0.0 && sw > 0.5 && vEu.z < 1.5) { vec2 cq = vec2((uv.x - uCover.x) / uCover.z, (1.0 - uv.y - uCover.y) / uCover.w);
    if (cq.x >= 0.0 && cq.x <= 1.0 && cq.y >= 0.0 && cq.y <= 1.0) {
      vec2 uA = vec2(uv.x, 1.0 - (uCover.y - 0.011)), uB = vec2(uv.x, 1.0 - (uCover.y + uCover.w + 0.011));
      vec4 pc = mix(texture2D(map, uB), texture2D(map, uA), 0.6 * (1.0 - smoothstep(0.0, 0.35, cq.y)));   /* mostly the fender paint below, the shoulder above only near the top */
      float fe = smoothstep(0.0, 0.1, cq.x) * smoothstep(0.0, 0.08, cq.y) * smoothstep(0.0, 0.08, 1.0 - cq.y);   /* feather into the painting at the rect's edges */
      tx = mix(tx, pc, fe); uv = mix(uv, uB, step(0.5, fe)); } }
#endif
  float cut = step(1.5, vEu.z) * step(vEu.z, 2.75);   /* wing / strut / bar plates: cut out like the painting, soft alpha edge (no stair steps) */
  if (cut > 0.5 && tx.a < 0.08) discard;
  vec4 ec = texture2D(edge, vEu.xy);
  /* painted surfaces (dev paint editor, user 2026-11-15): the hood (top, windshield base -> nose tip; u along x, v across z)
     replaces the baked edge colour: colour in the top half, paint mask in the bottom half (white = body paint, recoloured;
     black = fixed detail; grey = glass), same as ec.a. The front face: below, after the side / edge mix */
  float hP = 0.0, pD = 0.0, fM = -1.0; vec4 hl = vec4(0.0), fL = vec4(0.0);   /* fL / fM: the FRONT layer, re-applied over the hero's projected nose */   /* pD: painted fixed-detail colour (editor layer) -> little added shine, so black paints black, not grey */
#ifdef F_HOOD
  if (uHoodOn > 0.5 && vEu.z < 1.5 && vEu.y < 0.125 && vEu.x >= uHoodR.x && vEu.x <= uHoodR.y) {
    float hu = (vEu.x - uHoodR.x) / max(uHoodR.y - uHoodR.x, 1e-4), hz = clamp((vLp.z / uHoodR.z + 1.0) * 0.5, 0.004, 0.996);
    vec4 lc = texture2D(uHoodTex, vec2(hu, 1.0 - hz * 0.5)), lm = texture2D(uHoodTex, vec2(hu, 0.5 - hz * 0.5));   /* premultiplied */
    ec.rgb = ec.rgb * (1.0 - lc.a) + lc.rgb;
    if (lm.a > 0.5) { float mv = lm.r / lm.a; if (mv > 0.3 && mv < 0.7) hP = 1.0; else { ec.a = mv > 0.5 ? 1.0 : 0.0; pD = lc.a * step(mv, 0.3); } } }   /* grey mask = remove the hood paint, show the side painting's projection there */
#endif
  /* painted windshield (dev paint editor, user 2026-11-15: "add windshield too ... remove some or edit the mask"): the front
     glass band seen from ahead (u across z, screen right = far side; v = roof front edge at the top -> windshield base).
     Mask white = body paint (pillars, a sun strip: lit + recoloured like the hood); black = glass: the baked glass colour
     is lit as before and the painted difference from it is added like the old streaks (seed = glass + the Nov 12 streaks,
     so a seed renders exactly as before; painting glass colour over a streak removes it). gT / gD feed the glass code below */
  float gT = 0.0, gA = 0.0, gS = 0.0, gW = 1.0; vec3 gC = vec3(0.0), gD = vec3(0.0);
#ifdef F_GLASS
  if (uGlassOn > 0.5 && vEu.z < 1.5 && vEu.y < 0.125 && vEu.x >= uGlassR.x && vEu.x <= uGlassR.y) {
    float gu = clamp(0.5 - vLp.z / (2.0 * uGlassR.z), 0.0, 1.0), gv = clamp((vEu.x - uGlassR.x) / max(uGlassR.y - uGlassR.x, 1e-4), 0.004, 0.996);
    vec4 lc = texture2D(uGlassTex, vec2(gu, 1.0 - gv * 0.5)), lm = texture2D(uGlassTex, vec2(gu, 0.5 - gv * 0.5));   /* premultiplied */
    gT = 1.0; gA = lc.a; gC = lc.a > 0.001 ? lc.rgb / lc.a : vec3(0.0); gS = step(0.5, lm.a);
    if (gS > 0.5) ec.a = lm.r / lm.a > 0.5 ? 1.0 : 0.5; }
#endif
  /* flank loft past the painted outline (a column's loft spans its whole run, but the painted nose / tail recedes at an
     intake or under a lip, and edge-on corners sample a blurred mip that mixes in the transparent texels past the tip):
     it took the hood edge colour = a flat fin beside the bumper. Use the baked front / rear face colour at that height */
  float ext = sw > 0.5 && vEu.z < 1.5 ? 1.0 - smoothstep(0.2, 0.6, tx.a) : 0.0;   /* edge-on corners: mip alpha falls off */
  vec4 fcE = texture2D(edge, vec2(clamp(1.0 - uv.y, 0.0, 1.0), (uv.x > 0.5 ? 1.5 : 2.5) / 8.0));   /* front / rear face colour at this height */
  if (ext > 0.0) tx = vec4(mix(tx.rgb, fcE.rgb, ext), 1.0);
  float sk = sw * smoothstep(0.2, 0.6, tx.a); // 1 = painted side, 0 = edge colour (top / caps / wells)
  /* shoulder band (0 < sw < 1, where the flank rolls into the hood / roof / trunk): the painting there is its dark ink
     outline, which became a black line along the hood (Seiryu, Aozora). Ink-dark painted pixels take the top colour */
  if (sw > 0.001 && sw < 0.999 && vEu.z < 1.5) { float le = dot(ec.rgb, vec3(0.299, 0.587, 0.114)), lp = dot(tx.rgb, vec3(0.299, 0.587, 0.114));
    sk *= smoothstep(0.3, 0.65, lp / max(le, 0.03)); }
  if (hP > 0.5) sk = 1.0;
  float capK = 1.0;
  vec3 col = mix(ec.rgb, tx.rgb, sk);
  float mk = mix(step(0.75, ec.a), mix(sM >= 0.0 ? sM : texture2D(mask, uv).r, step(0.75, fcE.a), ext), sk);
  /* painted front face (dev paint editor): every forward-facing surface of the nose (end cap, the loft's underside rising
     to the bumper, the steep hood front), seen from ahead: u across z (screen right = far side), v = height top -> bottom.
     Colour + mask only; the lighting keeps its side / top split (sk) */
#ifdef F_FACE
  if (uFaceOn > 0.5 && vEu.z < 1.5 && (vEu.y > 0.125 || vEu.z > 0.5) && vLp.x > uFacePR.w && normalize(vNl).x > 0.55) {   /* not the steep hood front (top row): that is the hood's */
    float fu = clamp(0.5 - vLp.z / (2.0 * uFacePR.x), 0.0, 1.0), fv = clamp((uFacePR.z - vLp.y) / max(uFacePR.z - uFacePR.y, 1e-3), 0.004, 0.996);
    vec4 lc = texture2D(uFaceTex, vec2(fu, 1.0 - fv * 0.5)), lm = texture2D(uFaceTex, vec2(fu, 0.5 - fv * 0.5));   /* premultiplied */
    col = col * (1.0 - lc.a) + lc.rgb; fL = lc; if (lm.a > 0.5) { mk = step(0.5, lm.r / lm.a); fM = mk; pD = max(pD, lc.a * (1.0 - mk)); } }
#endif
  /* painted headlights (HEADLIGHTS layer, user: "headlight should be front view" / "up more"): the FRONT view mapping on every
     forward-facing surface of the nose INCLUDING the steep hood front (the upper nose), glowing, applied after the lighting */
#ifdef F_HEAD
  if (uHeadOn > 0.5 && vEu.z < 1.5 && vLp.x > uFacePR.w && normalize(vNl).x > 0.55) {
    float hu2 = clamp(0.5 - vLp.z / (2.0 * uFacePR.x), 0.0, 1.0), hv2 = clamp((uFacePR.z - vLp.y) / max(uFacePR.z - uFacePR.y, 1e-3), 0.004, 0.996);
    hl = texture2D(uHeadTex, vec2(hu2, 1.0 - hv2 * 0.5)); }
#endif
  /* nose / tail faces: the end caps AND the steep front of the loft's top (where the hood drops to the bumper the top
     surface faces forward). Clean, symmetric construction (Codex review 2026-11-14): reading the painting inside the
     edge across the width smeared the side-view bumper into horizontal streaks, and the per-height front column put white
     lamp / highlight bands right across the face. Now: one body colour (uFaceF / uFaceR, the paint of the nose / tail
     column), only real dark painted bands (lip, intake) kept as clean bands, an inset grille / diffuser, and a pair of
     mirrored lamps that continue the painted lens on each corner */
  float faceOld = ${FACE_OLD ? '1.0' : '0.0'} * (1.0 - step(0.5, uProjOn));
  float capRow = step(0.15, vEu.y) * step(vEu.y, 0.35);
  float steep = step(vEu.y, 0.1) * smoothstep(0.45, 0.7, abs(normalize(vN).x)) * step(0.36, abs(vEu.x - 0.5));
  float wF = (1.0 - step(0.5, sw)) * max(capRow, steep) * (1.0 - faceOld);
#ifdef F_CAPS
  if (wF > 0.0) {
    float fr = capRow > 0.5 ? (vEu.y < 0.25 ? 1.0 : -1.0) : sign(vEu.x - 0.5);
    vec4 cp = fr > 0.0 ? uCapF : uCapR, fc = fr > 0.0 ? uFaceF : uFaceR;
    float le = dot(ec.rgb, vec3(0.299, 0.587, 0.114));
    float dkB = capRow * (1.0 - step(0.75, ec.a)) * (1.0 - smoothstep(0.07, 0.13, le));   /* a dark painted band (lip / intake) */
    col = mix(col, mix(fc.rgb, ec.rgb, dkB), capRow); mk = mix(mk, fc.a * (1.0 - dkB), capRow);
    float hy = clamp((vLp.y - cp.x) / max(cp.y - cp.x, 0.01), 0.0, 1.0), lz = clamp(abs(vLp.z) / max(cp.z, 0.05), 0.0, 1.0);
    float onP = (1.0 - dkB) * wF;   /* the steep top too: on a blunt nose (Red, Drift) the loft's top drops down the whole nose face and the cap is a thin strip */
    /* grille (front) / diffuser (rear): a rounded inset opening with a lit upper lip, a shadowed top inside, a mesh
       (front) or vertical fins (rear) that get darker toward the centre = depth */
    vec2 gq = vec2(lz / 0.5, (hy - 0.24) / 0.12);   /* a little narrower: a full-width black opening read as a pasted-on pill */
    float gd = pow(pow(abs(gq.x), 4.0) + pow(abs(gq.y), 4.0), 0.25);
    float gi = (1.0 - smoothstep(0.93, 1.0, gd)) * onP;
    float lip = smoothstep(0.98, 1.02, gd) * (1.0 - smoothstep(1.06, 1.14, gd)) * step(0.0, gq.y) * onP;
    float sur = smoothstep(0.93, 0.97, gd) * (1.0 - smoothstep(1.06, 1.12, gd)) * onP;   /* dark surround (bezel) around the opening */
    vec2 mq = vec2(vLp.z, vLp.y) * 62.0;
    float mesh = fr > 0.0 ? step(0.62, abs(fract(mq.x + mq.y) - 0.5) * 2.0) * step(0.62, abs(fract(mq.x - mq.y) - 0.5) * 2.0)
                          : step(0.72, fract(vLp.z * 22.0));
    vec3 gcol = mix(vec3(0.045, 0.045, 0.055), vec3(0.15, 0.15, 0.17) * (0.55 + 0.45 * gd), mesh) * (1.0 - 0.55 * smoothstep(0.35, 0.95, gq.y));   /* dark grey, not pure black */
    col = mix(col, gcol, gi); mk *= 1.0 - gi;
    col = mix(col, vec3(0.025, 0.025, 0.03), sur * 0.85); mk *= 1.0 - sur * 0.85;
    capK = mix(1.0, (1.0 - 0.3 * smoothstep(0.4, 1.0, lz)) * (0.86 + 0.22 * smoothstep(0.5, 0.8, hy)) * (1.0 + 0.25 * lip), wF);
  }
#endif
  /* head / tail lamps: a mirrored pair on the lamp row (uCapF.w / uCapR.w) wherever the unpainted surface (hood front,
     nose / tail cap) faces the end, 0.48-0.92 of the half width: housing + lens + a bright inner unit, the same on both
     sides. The painted lens on each flank corner (mirrored on the far flank) keeps the painting. Faded out side-on
     (endV): there the near one showed as a white sliver past the painted lens at the race / start-line camera */
  vec4 lensC = vec4(0.0);
#if defined(F_CAPS) || defined(F_BAND)
  if (vEu.z < 1.5) { vec3 nl = normalize(vNl); float lzz = abs(vLp.z) / max(uHW, 0.01);
    float fF = smoothstep(0.3, 0.55, nl.x), fR = smoothstep(0.3, 0.55, -nl.x), lw = (1.0 - sk) * endV * max(fF, fR);
    /* front band (user reference 2026-11-14, hero): ONE continuous unit across the nose = the grille between the lamps at
       lamp height, running straight into the two swept lamps, which wrap round the corners onto the flanks over the
       painted side lamp. One ink outline round it all, drawn over the paint. Lamp: dark housing, two faceted chrome
       projector bowls with a bulb, (hero: the painted texture BAND_TEX instead), clear glass top band + highlight, white DRL trim
       along the bottom (bulbs + DRL are the only near-white = bloom). Mirrored on both sides */
#ifdef F_BAND
    if (uBandX > -50.0) {
      float az = abs(vLp.z), bs = az + max(0.0, uBandX - vLp.x);
      vec2 bt = bandAt(bs);
      float sJ = uBandP[1].x, sE = uBandP[7].x, dY = min(vLp.y - bt.x, bt.y - vLp.y), dE = min(dY, sE - bs);
      float aa = max(fwidth(dE), 1e-4), RIM = uBandT > 0.5 ? 0.014 : 0.011;   /* bolder ink round the painted band (user: 39's ~3-4 px outline) */
      float bA = smoothstep(-RIM - aa, -RIM + aa, dE);
      /* side-on the flank keeps the ORIGINAL painted side lamp (user 2026-11-14: the side view was fine): the band's flank
         part fades in only as the view turns toward the nose, fully original up to ~15 deg off the side, full band by ~30 */
      if (uBandT > 0.5) bA *= smoothstep(0.26, 0.5, abs(normalize(vVm).x));   /* whole band: side-on (race / staging camera) = the original painting */
      if (bA > 0.0) {
        float v = clamp((vLp.y - bt.x) / max(bt.y - bt.x, 0.01), 0.0, 1.0);
        vec3 ink = vec3(0.086, 0.067, 0.118), c;
        /* proportions measured on the user's target (39.webp, head-on, in body half widths -> m): grille to |z| 0.35, taller
           than the lamp's inner tip; lamp to the corner, tallest at the outer end, lower edge dipping in the middle; bowls at
           s 0.565 / 0.715, a white glass brow along the top (no amber: it comes from the painted texture) */
        if (uBandT > 0.5) {   /* painted band texture (sprites/car_hero_front.webp, cut from the user's repaint; tools/make_hero_front.py):
