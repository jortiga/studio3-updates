const Q = new URLSearchParams(location.search);
const OFF = Q.has('nostory') || Q.has('t') || (Q.has('auto') && Q.get('auto') !== '0');
const PREVIEW = Q.get('story') === 'auto' ? null : Q.get('story');
const HOLD = Q.has('storyhold');
/* User (2026-11-13, CrazyGames review): the story never interrupts the game. No scene auto-plays (prologue, after-tutorial,
   area enter, boss intro, boss beaten, finale); the code stays behind this flag (window.GT_STORY = true or ?story=auto turns
   the old triggers back on). The STORY book in the menu stays as an optional replay of the chapters the player reached. */
/* User (2026-11-14): the phone app (Play / iOS store builds, GT_BUILD.target 'app') plays the story again; CrazyGames and
   the web stay story-free. */
const AUTO_STORY = Q.get('story') === 'auto' || (typeof window !== 'undefined' && (window.GT_STORY === true ||
  !!(window.GT_BUILD && (window.GT_BUILD.native || ['app', 'ios', 'android'].includes(window.GT_BUILD.target)))));   /* gt-platform.js turns 'app' into 'ios' / 'android' on a device (the 1.1 TestFlight build played no story) */
