  for (const s of fl.querySelectorAll('.shade')) s.animate([{ opacity: 0 }, { opacity: 1 }, { opacity: 0 }], { duration: D, easing: E });
  /* user 2026-11-22: mid-flip the turning page's photo boxes showed through, and the text flickered. backface-visibility
     on .face alone is not enough on phone WebKit / Android Chrome: descendants that get their own compositing layer
     (clip-path art, blend-mode dots, the old per-bubble opacity fades) are drawn without the face's culling. So each face
     is switched off outright at the 90 deg moment (same duration + easing as the turn, so offset 0.5 = edge-on): the
     side that faces the reader first is hidden from 0.5 on, the other side only shows from 0.5. The per-overlay opacity
