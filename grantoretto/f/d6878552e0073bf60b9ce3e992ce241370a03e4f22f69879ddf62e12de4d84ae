export function once(id) { if (!want(id)) return Promise.resolve(false); mark(id); return play(id).then(() => true); }

// ---------------------------------------------------------------- triggers
export function init(c) {
  ctx = c;
  migrate(c.save);
  window.GT_story = { ready, play, stop, once, want, seen, area, busy: () => !!playing, idle: () => playing ? new Promise((r) => idleW.push(r)) : Promise.resolve(),
    leaveResult: () => { const id = c.G.state === 'result' ? afterResult() : null; return id && want(id) ? once(id) : Promise.resolve(false); },   /* main.js NEXT RACE: the leaving-the-result scene first, then the next race */
    menu: openMenu, get data() { return data; }, get panels() { return panels; } };
  const hook = () => {
    const ui = window.__g && window.__g.ui;
    if (!ui) { setTimeout(hook, 50); return; }
    // leaving the result screen (CONTINUE / CAREER / menu / upgrade): after-tutorial, boss beaten, finale
    const show = ui.show;
    ui.show = (name, o) => {
      const id = c.G.state === 'result' ? afterResult() : null;
      if (id && want(id)) { once(id).then(() => show(name, o)); return; }
      show(name, o);
    };
    const b = $('storyBtn');
    if (b) ui.tap(b, openMenu);
  };
  hook();
