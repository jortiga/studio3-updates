/** The tutorial race start: the prologue (first run). */
export const prologue = () => once('prologue');

// ---------------------------------------------------------------- player
const FACE_LEFT = { kaito: 1, misaki: 1, goro: 1, shin: 1, empress: 1, rei: 1, mika: 0, driver: 0 }; // bust looks left
const ART = (id) => C.ART[id] || '';
const nameOf = (id) => C.charName(id).replace(/'.*'/, '').replace(/\s*\(.*\)\s*/, '').trim();
function img(src) {
