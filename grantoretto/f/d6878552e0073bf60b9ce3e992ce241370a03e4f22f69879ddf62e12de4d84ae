    old.remove(); fl.remove();
    nu.style.visibility = ''; nu.style.zIndex = '';
    nu.querySelectorAll('.pg').forEach((p) => { p.style.visibility = ''; });
    bk.leaf = nu; bk.busy = false;
  };
  bkAt = j; foot(); preload(j);
  bk.book.classList.toggle('atCover', j === 0 && !bk.port);   /* user: after a flip the open spread stayed shifted left by the cover offset: clear it (and set it when flipping back to the cover) */
}
function closeBook() {
  if (!bk || !bk.open) return;
  bk.el.className = 'hidden';
  removeEventListener('keydown', bk.onKey, true); removeEventListener('resize', bk.onResize);
  bk.open = false;
}
async function openMenu(at) {
  await ready;
  if (!data || playing) return;
  let m = $('storyMenu');
  if (!m) { m = document.createElement('div'); m.id = 'storyMenu'; document.body.appendChild(m); }
  if (bk && bk.open) closeBook();
  if (typeof at === 'number') bkAt = at;
  const chs = chapters();
  bkAt = Math.max(0, Math.min(bkAt, chs.length));
  m.className = 'bk';
  m.innerHTML = `<div class="bkTop"><span class="bkLbl">STORY</span></div>
    <div class="bkStage"><div class="bkBook"></div></div>
    <button class="bkBtn bkX" data-act="close" aria-label="Close"><svg class="i" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    <button class="bkBtn bkPrev" data-act="prev" aria-label="Previous page">${ARR(-1)}</button>
    <button class="bkBtn bkNext" data-act="next" aria-label="Next page">${ARR(1)}</button>
    <div class="bkFoot"><span class="bkDots"></span><span class="bkNum"></span></div>`;
  bk = { el: m, book: m.querySelector('.bkBook'), chs, busy: false, open: true };
  fitBook(); showAt(bkAt);
  let sx = 0, sy = 0, swiped = false, down = false;
  m.onpointerdown = (e) => { e.stopPropagation(); down = true; sx = e.clientX; sy = e.clientY; swiped = false; };
  m.onpointerup = (e) => {
    e.stopPropagation();
    if (!down) return;
    down = false;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) { swiped = true; turn(dx < 0 ? 1 : -1); }
  };
  m.onclick = (e) => {
    e.stopPropagation();
    if (swiped) { swiped = false; return; }
    const act = e.target.closest('[data-act]');
    if (act) {
      const k = act.dataset.act;
      if (k === 'close') { try { C.audio().play('ui_click'); } catch { /* */ } closeBook(); } else turn(k === 'next' ? 1 : -1);
      return;
    }
    if (bk.busy) return;
    const p = e.target.closest('.mgP[data-id]');
    if (p) {
      try { C.audio().play('ui_confirm'); } catch { /* */ }
      const page = bkAt;
      closeBook();
      play(p.dataset.id).then(() => openMenu(page));
      return;
    }
    const r = bk.book.getBoundingClientRect();
    if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) return;
    if (bkAt === 0) { turn(1); return; }
    const fx = (e.clientX - r.left) / r.width;
    if (fx < 0.2) turn(-1); else if (fx > 0.8) turn(1);
  };
