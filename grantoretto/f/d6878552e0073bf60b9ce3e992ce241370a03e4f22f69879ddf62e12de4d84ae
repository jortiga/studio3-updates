// Ken Burns: the image is sized to cover the stage, then scaled/translated (transform only) so the focus point stays
// in frame; drifts from (focus, z0) to (focus + d, z1) over the beat.
function kbTransform(el, im, box, fx, fy, z) {
  const iw = im.naturalWidth || im.width, ih = im.naturalHeight || im.height, bw = box.clientWidth, bh = box.clientHeight;
  const s = Math.max(bw / iw, bh / ih), w = iw * s * z, h = ih * s * z;
  el.style.width = iw * s + 'px'; el.style.height = ih * s + 'px';
  const tx = Math.min(0, Math.max(bw - w, bw / 2 - fx * w)), ty = Math.min(0, Math.max(bh - h, bh * 0.45 - fy * h));
  return `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${z})`;
}
function drift(p) {
  const { el, im, box, v, pan, hold } = p;
