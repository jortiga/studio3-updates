}
function foot() {
  const n = bk.chs.length + 1;
  bk.el.querySelector('.bkNum').textContent = `${bkAt + 1} / ${n}`;
  bk.el.querySelector('.bkDots').innerHTML = Array.from({ length: n }, (_, k) => `<i class="${k === bkAt ? 'on' : ''}"></i>`).join('');
  bk.el.querySelector('.bkPrev').classList.toggle('off', bkAt === 0);
  bk.el.querySelector('.bkNext').classList.toggle('off', bkAt === n - 1);
}
// page flip: a two-faced sheet rotates around the spine (landscape) or the left edge (portrait); the pages it uncovers
// are already rendered underneath. transform + opacity only.
function turn(dir) {
  const j = bkAt + dir;
  if (!bk || bk.busy || j < 0 || j > bk.chs.length) return;
  const a = C.audio(); try { a && a.play && a.play('whoosh', { volume: 0.22 }); } catch { /* */ }
  const old = bk.leaf, nu = renderLeaf(j), port = bk.port;
  bk.busy = true;
  const face = (pg, b) => `<div class="face${b ? ' b' : ''}">${pg ? pg.outerHTML : ''}<i class="shade"></i></div>`;
  const fl = document.createElement('div');
  let from = 0, to, hide = [];
  if (port) {
    const paper = document.createElement('div'); paper.className = 'pg S back';
    if (dir > 0) { bk.book.insertBefore(nu, old); fl.innerHTML = face(old.firstElementChild) + face(paper, 1); to = -180; old.style.visibility = 'hidden'; }
    else { bk.book.appendChild(nu); fl.innerHTML = face(nu.firstElementChild) + face(paper, 1); from = -180; to = 0; nu.style.visibility = 'hidden'; hide = [nu]; }
    fl.className = 'flip whole';
  } else {
    bk.book.insertBefore(nu, old);
    const oL = old.querySelector('.pg.L'), oR = old.querySelector('.pg.R'), nL = nu.querySelector('.pg.L'), nR = nu.querySelector('.pg.R');
    if (dir > 0) { fl.innerHTML = face(oR) + face(nL, 1); to = -180; fl.className = 'flip right'; oR.style.visibility = 'hidden'; hide = [nL]; }
    else { fl.innerHTML = face(oL) + face(nR, 1); to = 180; fl.className = 'flip left'; oL.style.visibility = 'hidden'; hide = [nR]; }
  }
  hide.forEach((p) => { p.style.visibility = 'hidden'; });
