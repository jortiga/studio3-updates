  for (const b of sc.beats) if (b.panel && panels[b.panel]) return `art/story/${b.panel}.webp`;
  return thumbOf(sc);
}
function lineOf(sc) {   // first spoken line (else the first narration), cut to one short line for the bubble
  let who = '', text = '';
  for (const b of sc.beats) {
    const l = b.lines.find((x) => x[0]);
    if (l) { who = l[0]; text = l[1]; break; }
    if (!text && b.lines[0]) text = b.lines[0][1];
