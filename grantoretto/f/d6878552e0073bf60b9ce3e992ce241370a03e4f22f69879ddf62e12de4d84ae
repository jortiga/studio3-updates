function chapters() {   // the book's chapters: story.json's, with the finale split off CH.5 as its own spread
  const out = [];
  for (const ch of data.chapters) {
    const sc = ch.scenes.filter((id) => id !== 'finale');
    const m = /^CH\.(\d+)\s+(.*)$/.exec(ch.name);
    out.push({ id: ch.id, no: m ? `CHAPTER ${m[1]}` : '', name: m ? m[2] : ch.name, scenes: sc });
    if (sc.length < ch.scenes.length) out.push({ id: 'F', no: '', name: 'FINALE', scenes: ['finale'] });
  }
