// v1 of the story flags: an older save gets everything it already passed marked as seen (no flood of old scenes)
function migrate(s) {
  if (s.story && s.story.seen) return;
  s.story = { v: 1, seen: {} };
  const old = s.tutorialDone || s.races > 0;
  if (old) { s.story.seen.prologue = 1; s.story.seen.after_tut = 1; }
  for (const t of M.TIERS) {
    const p = (s.career && s.career[t]) || 0;
    if (p > 0) s.story.seen[`ch${CH[t]}_enter`] = 1;
    if (p >= M.RUNGS) { s.story.seen[`ch${CH[t]}_boss`] = 1; s.story.seen[beatenId(t)] = 1; }
  }
