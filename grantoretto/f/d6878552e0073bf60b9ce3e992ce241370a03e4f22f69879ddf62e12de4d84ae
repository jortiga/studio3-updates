  if (o.mode === 'career' && o.rung === M.RUNGS - 1 && save().career[o.tier] >= M.RUNGS) return beatenId(o.tier);
  return null;
}
/** Area card opened on the map (ui.js openCard): the area's intro, the first time, once the area is open. */
export function area(t) {
  if (!CH[t] || !M.tierOpen(save(), t)) return Promise.resolve(false);
  return once(`ch${chOf(t)}_enter`);
}
/** Before a career race (scene_extras.raceStart, while G.intro holds the staging): area intro if never seen, boss intro. */
export async function beforeRace(ri) {
  if (!ri || !CH[ri.tier]) return;
  await area(ri.tier);
  if (ri.isBoss) { const id = `ch${chOf(ri.tier)}_boss`, was = seen(id); await once(id); return !was && seen(id); }   // true = the boss scene just played
