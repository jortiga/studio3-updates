    if (e.code !== 'ArrowRight' && e.code !== 'ArrowLeft' && e.code !== 'Escape') return;
    e.stopImmediatePropagation(); e.preventDefault();
    if (e.type !== 'keydown' || e.repeat) return;
    if (e.code === 'Escape') closeBook(); else turn(e.code === 'ArrowRight' ? 1 : -1);
  };
  bk.onResize = () => requestAnimationFrame(() => { if (!bk.open) return; fitBook(); if (!bk.busy) showAt(bkAt); });
  addEventListener('keydown', bk.onKey, true); addEventListener('resize', bk.onResize);
}
