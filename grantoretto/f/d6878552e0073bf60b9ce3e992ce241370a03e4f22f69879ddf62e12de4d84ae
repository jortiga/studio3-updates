/** Play a scene; resolves when it ends or is skipped. opts.beat = start beat (preview). */
export async function play(id, opts = {}) {
  await ready;
  const sc = data && data.scenes[id];
  if (!sc || playing) return;
  const el = root || build();
  playing = id;
