  && String(a.focus) === String(b.focus) && String(pa || '') === String(pb || '');

let root = null;
function build() {
  root = document.createElement('div');
  root.id = 'story';
  root.className = 'st hidden';
  root.innerHTML = `<div class="stStage" id="stStage"></div><div class="stBox" id="stBox"><div class="stWho" id="stWho"><i class="stFace" id="stFace"></i><b id="stName"></b><em id="stTag"></em></div>
