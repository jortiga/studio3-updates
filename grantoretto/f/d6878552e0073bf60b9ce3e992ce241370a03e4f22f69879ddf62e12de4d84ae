const carSrc = () => { const k = save() && save().car; try { const u = window.GT_snapCar && window.GT_snapCar(k, 'player'); if (u) return u; } catch { /* */ } return `sprites/thumb_${k}.webp`; };
// what a beat shows: the painted panel if it exists, else its fallback
function look(b) {
