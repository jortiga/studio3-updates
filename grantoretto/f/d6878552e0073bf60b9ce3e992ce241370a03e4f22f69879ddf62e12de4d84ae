    <button class="btn stSkip" id="stSkip" aria-label="Skip"><span>SKIP</span><svg class="i" viewBox="0 0 24 24"><path d="M5 5.5 12 12l-7 6.5M12 5.5 19 12l-7 6.5"/></svg></button>
