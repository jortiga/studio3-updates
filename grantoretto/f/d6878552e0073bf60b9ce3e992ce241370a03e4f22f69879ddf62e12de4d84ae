  const [dx, dy, z0, z1] = pan || [0.03, 0, 1.03, 1.1];
  const [fx, fy] = v.focus;
  const a = kbTransform(el, im, box, fx, fy, z0), b = kbTransform(el, im, box, fx + dx, fy + dy, z1);
  if (p.anim) p.anim.cancel();
  if (hold) { el.style.transform = kbTransform(el, im, box, fx + dx / 2, fy + dy / 2, (z0 + z1) / 2); return; }
  p.anim = el.animate([{ transform: a }, { transform: b }], { duration: 9000, easing: 'ease-out', fill: 'forwards' });
}

async function makePanel(v, b, stage) {
  const p = document.createElement('div');
  p.className = `stPanel k_${v.kind}` + (v.fx ? ' fx_' + v.fx : '');
  // 'live' = the 3D scene behind (race staging: the player's car on the line) under a dim veil; on the meta screens
  // (result/map behind) it becomes a dark garage with the player's car snapshot instead
  const see = v.kind === 'live' && ctx && ctx.G.state === 'stage';
  root.classList.toggle('see', see);
  const im = see ? null : v.kind === 'live' ? await img(carSrc()) : await img(v.src);
  let html = '';
  if (see) p.classList.add('see');
  else if (v.kind === 'live') html += `<div class="stGarage"></div>${im ? `<div class="stCar" style="background-image:url(${im.src})"></div>` : ''}`;
  else if (im) html += `<div class="stImg" style="background-image:url(${im.src})"></div>`;
  else html += '<div class="stGarage"></div>';
  html += '<div class="stFx"></div>';
  const [r, l] = v.busts || [];
  if (l) html += `<div class="stBust l c_${l}${FACE_LEFT[l] ? ' flip' : ''}" style="background-image:url(${ART(l)})"></div>`;
  if (r) html += `<div class="stBust r c_${r}${FACE_LEFT[r] === 0 ? ' flip' : ''}" style="background-image:url(${ART(r)})"></div>`;
  if (b.cap) html += `<div class="stCap"><span>${b.cap}</span></div>`;
  p.innerHTML = html;
  stage.appendChild(p);
  const P = { root: p, el: p.querySelector('.stImg'), im: v.kind === 'live' ? null : im, box: stage, v, pan: b.pan, hold: !!b._hold };
  return P;
}

function plate(who, tag) {
  const box = $('stBox');
  box.className = 'stBox' + (who ? ' c_' + who : ' narr');
  $('stName').textContent = who ? nameOf(who) : '';
  $('stTag').textContent = tag || '';
  const f = $('stFace');
  f.style.backgroundImage = who ? `url(${ART(who)})` : 'none';
  f.className = 'stFace c_' + who + (FACE_LEFT[who] === 0 && who !== 'mika' ? ' flip' : '');
