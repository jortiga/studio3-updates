/** Book: a scene is unlocked once seen, or once the career got there (scenes no longer auto-play, see AUTO_STORY). */
export function unlocked(id) {
  if (seen(id)) return true;
  const s = save(); if (!s) return false;
  const c = s.career || {};
  if (id === 'prologue' || id === 'after_tut') return !!(s.tutorialDone || s.races > 0);
  if (id === 'finale') return (c.S || 0) >= M.RUNGS;
  const m = /^ch(\d)_(enter|boss|beaten)$/.exec(id); if (!m) return false;
  const t = M.TIERS[+m[1] - 1], p = c[t] || 0;
  if (m[2] === 'enter') return M.tierOpen(s, t) && !!(s.tutorialDone || s.races > 0);
  if (m[2] === 'boss') return p >= M.RUNGS - 1;
  return p >= M.RUNGS;
}
/** Should this scene auto-play now? (exists, unseen, story enabled, not previewing another) */
export const want = (id) => AUTO_STORY && !OFF && !PREVIEW && !!data && !!data.scenes[id] && !seen(id) && !playing;
