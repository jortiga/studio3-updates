}
const chOpen = (ch) => ch.scenes.some(unlocked);
function chNeed(ch) { const m = BOOK[ch.id] || {}; return m.need || (m.prev ? `BEAT ${NAME(m.prev)} TO UNLOCK` : 'KEEP RACING TO UNLOCK'); }
function sceneNeed(ch, id) {
  const m = BOOK[ch.id] || {};
  if (id === 'after_tut') return 'FINISH THE TUTORIAL';
  if (/_boss$/.test(id)) return `RACE ${NAME(m.who)} TO UNLOCK`;
  if (/_beaten$|^finale$/.test(id)) return `BEAT ${NAME(m.who)} TO UNLOCK`;
  return chNeed(ch);
}

// ---- page markup (plain strings: the flip faces re-render the same pages)
function coverHTML() {
  return `<div class="bkCover"><i class="bkCoverArt" style="background-image:url(art/story/pro_rain.webp)"></i><i class="bkTone"></i>
    <span class="bkVol">VOL.1</span><div class="bkLogo"><b>${GNAME}</b><em>THE STORY</em></div><span class="bkTapHint">TAP TO OPEN</span></div>`;
}
function titleHTML(ch, ci) {
  const m = BOOK[ch.id] || {};
  if (!chOpen(ch)) return `<div class="tp sealed"><span class="tpNo">${ch.no || '&nbsp;'}</span><b class="tpName">${ch.name}</b>${LOCK_SVG}<span class="tpNeed">${chNeed(ch)}</span></div>`;
  return `<div class="tp"><i class="tpBurst"></i><span class="tpNo">${ch.no || GNAME}</span><b class="tpName">${ch.name}</b>
    <p class="tpSyn">${esc(m.syn || '')}</p><div class="tpBoss${ci % 2 ? ' alt' : ''}"><i style="background-image:url(${ART(m.who)})"></i><span>${m.boss ? 'BOSS · ' : ''}${esc(NAME(m.who))}</span></div></div>`;
}
function panelsHTML(ch, ci) {
  const open = chOpen(ch), n = ch.scenes.length, m = BOOK[ch.id] || {};
  let sp = m.sp || 0;
  if (!open || !unlocked(ch.scenes[sp]) || !LAY[`${n}_${sp}`]) sp = 0;
  const lay = LAY[`${n}_${sp}`] || LAY['1_0'], flip = ci % 2 === 1;
  // mirrored on every other chapter for variety, then re-sorted into left-to-right, top-to-bottom reading order
  const shapes = lay.map((pts) => (flip ? pts.map((v, j) => (j % 2 ? v : 100 - v)) : pts))
    .map((pts, k) => ({ pts, big: k === sp, y: Math.round(Math.min(...pts.filter((_, j) => j % 2)) / 10), x: Math.min(...pts.filter((_, j) => j % 2 === 0)) }))
    .sort((a, b) => a.y - b.y || a.x - b.x);
  return `<div class="mg${open ? '' : ' sealed'}">` + ch.scenes.map((id, k) => {
    const pts = (shapes[k] || shapes[0]).pts;
    const xs = pts.filter((_, j) => j % 2 === 0), ys = pts.filter((_, j) => j % 2 === 1);
    const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
    const poly = 'polygon(' + xs.map((x, j) => `${(((x - x0) / (x1 - x0)) * 100).toFixed(2)}% ${(((ys[j] - y0) / (y1 - y0)) * 100).toFixed(2)}%`).join(',') + ')';
    const box = `left:${x0}%;top:${y0}%;width:${x1 - x0}%;height:${y1 - y0}%`;
    const sc = data.scenes[id], ok = open && unlocked(id);
    const big = shapes[k] && shapes[k].big && n > 1 ? ' big' : '';
    if (!ok) return `<div class="mgP lock${big}" style="${box}"><i class="mgInk" style="clip-path:${poly}"></i><i class="mgArt" style="clip-path:${poly}"></i>`
      + `<span class="mgLock">${LOCK_SVG}${open ? `<em>${sceneNeed(ch, id)}</em>` : ''}</span></div>`;
    const l = lineOf(sc), side = (k + (flip ? 1 : 0)) % 2 ? ' r' : '';
    return `<div class="mgP${big}" role="button" tabindex="0" aria-label="Replay ${esc(sc.title)}" data-id="${id}" style="${box}"><i class="mgInk" style="clip-path:${poly}"></i>`
      + `<i class="mgArt" style="clip-path:${poly};background-image:url(${artOf(sc)})"></i><i class="mgDot" style="clip-path:${poly}"></i>`
      + `<span class="mgBub${l.who ? '' : ' nar'}${side}"><span>${esc(l.text)}</span></span><span class="mgPlay"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg></span></div>`;
  }).join('') + '</div>';
}
// a leaf = what one book position shows: landscape = left + right page, portrait = one page
function leafHTML(i, port) {
  if (i === 0) return port ? `<div class="pg S cover">${coverHTML()}</div>` : `<div class="pg L none"></div><div class="pg R cover">${coverHTML()}</div>`;
  const ch = bk.chs[i - 1], seal = chOpen(ch) ? '' : ' dark';
  if (port) return `<div class="pg S${seal}">${titleHTML(ch, i)}${panelsHTML(ch, i)}<span class="pgN r">${i + 1}</span></div>`;
  return `<div class="pg L${seal}">${titleHTML(ch, i)}<span class="pgN">${2 * i}</span></div><div class="pg R${seal}">${panelsHTML(ch, i)}<span class="pgN r">${2 * i + 1}</span></div>`;
}

function fitBook() {
  const st = bk.el.querySelector('.bkStage'), port = innerHeight > innerWidth;
  bk.el.classList.toggle('port', port);
  const sw = st.clientWidth, sh = st.clientHeight;
  let w, h;
  if (port) { w = Math.min(sw, sh / 1.3); h = Math.min(sh, w * 1.8); }
  else { h = sh; const pw = Math.min(sw / 2, h * 0.8); if (pw < h * 0.62) h = pw / 0.62; w = pw * 2; }
  bk.book.style.width = Math.floor(w) + 'px'; bk.book.style.height = Math.floor(h) + 'px';
  bk.port = port;
}
function renderLeaf(i) {
  const lf = document.createElement('div');
  lf.className = 'leaf';
  lf.innerHTML = leafHTML(i, bk.port);
  return lf;
}
function showAt(i) {
  bkAt = i;
  bk.book.innerHTML = '';
  bk.leaf = renderLeaf(i);
  bk.book.appendChild(bk.leaf);
  bk.book.classList.toggle('atCover', i === 0 && !bk.port);   /* the closed book (cover = right page only) sits centred */
  foot(); preload(i);
}
/* fetch + decode the art of the pages either side of i, so a turn never shows a panel's empty ink box (the "photo
   container") while its picture is still loading on the phone */
const preloaded = new Set();
function preload(i) {
  for (const k of [i - 1, i + 1]) {
    if (k < 0 || k > bk.chs.length) continue;
    for (const m of leafHTML(k, bk.port).matchAll(/url\(([^)]+)\)/g)) {
      const src = m[1].replace(/^['"]|['"]$/g, '');
      if (!src || preloaded.has(src)) continue;
      preloaded.add(src);
      const im = new Image(); im.src = src; if (im.decode) im.decode().catch(() => { /* missing art: the dark fallback shows */ });
    }
