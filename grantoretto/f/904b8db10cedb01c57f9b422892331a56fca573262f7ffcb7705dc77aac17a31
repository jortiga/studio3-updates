  background: linear-gradient(180deg, rgba(30,24,64,.92), rgba(8,6,22,.92)); box-shadow: inset 0 0 0 calc(var(--u) * 1.5) rgba(255,204,51,.6), 0 0 calc(var(--u) * 10) rgba(255,190,40,.3);
