/* =================== meta UI (menu, garage, upgrade, career, rewards) =================== */
.it0, .it1, .it2, .it3, .it4, .it5 { background: url(sprites/ic_items.webp) no-repeat 0 0 / 600% 100%; }
.it1 { background-position: 20% 0; } .it2 { background-position: 40% 0; } .it3 { background-position: 60% 0; }
.it4 { background-position: 80% 0; } .it5 { background-position: 100% 0; }
/* part icons: CSS masks in min.css (painted ic_upgrade.webp retired) */
.up1 { background-position: 20% 0; } .up2 { background-position: 40% 0; } .up3 { background-position: 60% 0; }
.up4 { background-position: 80% 0; } .up5 { background-position: 100% 0; }

.ico { display: inline-block; width: 1.05em; height: 1.2em; vertical-align: -0.28em; }
/* glossy glass panel with neon edge + a one-shot shine sweep when it appears */
.glass { position: relative; overflow: hidden; border-radius: calc(var(--u) * 16);
  background: linear-gradient(180deg, rgba(44,30,96,.88) 0%, rgba(16,12,40,.92) 40%, rgba(8,6,22,.95) 100%);
  box-shadow: inset 0 0 0 calc(var(--u) * 1.5) rgba(255,70,190,.75), inset 0 calc(var(--u) * 2) 0 rgba(255,255,255,.12),
    0 0 calc(var(--u) * 18) rgba(255,47,154,.35), 0 0 calc(var(--u) * 40) rgba(90,60,255,.25), 0 calc(var(--u) * 10) calc(var(--u) * 26) rgba(0,0,0,.6); }
.glass::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 40%; pointer-events: none;
  background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,0)); border-radius: inherit; }
.glass::after { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 30%; pointer-events: none;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,.14), transparent); transform: translateX(-120%) skewX(-18deg); }
.enter .glass::after { animation: sweep 1.1s .15s ease-out; }
@keyframes sweep { to { transform: translateX(450%) skewX(-18deg); } }
.glass > * { position: relative; z-index: 1; }

