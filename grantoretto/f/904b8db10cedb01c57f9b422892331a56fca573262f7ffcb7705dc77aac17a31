.backIco { display: block; margin: auto; width: 34%; height: 34%; border-left: calc(var(--u) * 4) solid #fff; border-bottom: calc(var(--u) * 4) solid #fff; transform: translateX(15%) rotate(45deg); }
.tabTitle { font-style: italic; font-size: calc(var(--u) * 22); letter-spacing: calc(var(--u) * 1); padding: 0 calc(var(--u) * 22) 0 calc(var(--u) * 12); line-height: calc(var(--u) * 34);
  background: linear-gradient(90deg, #ff2f9a, #b0208a 70%, rgba(176,32,138,0)); transform: skewX(-14deg); border-radius: calc(var(--u) * 4);
  text-shadow: 0 calc(var(--u) * 2) 0 rgba(60,0,40,.6); white-space: nowrap; }
