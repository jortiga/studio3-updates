/* career */
.cPanel { position: absolute; left: calc(var(--u) * 10 + env(safe-area-inset-left)); right: calc(var(--u) * 10 + env(safe-area-inset-right)); top: calc(var(--u) * 62 + env(safe-area-inset-top));
  bottom: calc(var(--u) * 12 + env(safe-area-inset-bottom)); padding: calc(var(--u) * 10); display: flex; flex-direction: column; }
.cTiers { display: flex; gap: calc(var(--u) * 6); margin-bottom: calc(var(--u) * 10); flex: none; }
.cTier { flex: 1; height: calc(var(--u) * 46); border-radius: calc(var(--u) * 10); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1;
  font-size: calc(var(--u) * 22); font-style: italic; background: rgba(255,255,255,.05); box-shadow: inset 0 0 0 1px rgba(150,140,255,.3); cursor: pointer; position: relative; }
.cTier small { font-family: var(--font2); font-weight: 700; font-size: calc(var(--u) * 12); color: #aab0e0; margin-top: 2px; }
.cTier.on { background: linear-gradient(180deg, #ff4fb0, #8a1a70); box-shadow: 0 0 calc(var(--u) * 12) rgba(255,47,154,.6); }
.cTier.on small { color: #ffe0f4; }
.cTier.lock { opacity: .4; }
.cTier.done::after { content: ''; position: absolute; right: 2px; top: 2px; width: calc(var(--u) * 14); height: calc(var(--u) * 16); background: url(sprites/ic_items.webp) no-repeat 40% 0 / 600% 100%; }
.cBody { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: calc(var(--u) * 10); }
.cLadder { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column-reverse; gap: calc(var(--u) * 5); padding: 2px; scrollbar-width: none; touch-action: pan-y; }
.cLadder::-webkit-scrollbar { display: none; }
.rung { flex: none; display: grid; grid-template-columns: calc(var(--u) * 26) 1fr auto; align-items: center; gap: calc(var(--u) * 8); height: calc(var(--u) * 42);
  padding: 0 calc(var(--u) * 10); border-radius: calc(var(--u) * 8); background: rgba(255,255,255,.05); box-shadow: inset 0 0 0 1px rgba(150,140,255,.2); cursor: pointer; }
.rung .n { font-size: calc(var(--u) * 18); font-style: italic; color: #8a90c0; text-align: center; }
.rung .nm { font-size: calc(var(--u) * 16); font-style: italic; letter-spacing: .5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.05; }
.rung .nm small { display: block; font-family: var(--font2); font-weight: 700; font-size: calc(var(--u) * 13); color: #9aa2d0; letter-spacing: .5px; }
.rung .rw { font-family: var(--font2); font-weight: 700; font-style: italic; font-size: calc(var(--u) * 15); color: #ffd76a; display: flex; align-items: center; gap: 3px; }
.rung .rw i { width: calc(var(--u) * 15); height: calc(var(--u) * 17); }
.rung.beat .n { color: var(--green); }
.rung.beat .nm { color: #b9c2e8; }
.rung.next { background: linear-gradient(90deg, rgba(255,79,176,.38), rgba(255,79,176,.08)); box-shadow: inset 0 0 0 calc(var(--u) * 1.5) #ff4fb0; }
.rung.lock { opacity: .38; cursor: default; }
.rung.boss { height: calc(var(--u) * 52); background: linear-gradient(90deg, rgba(255,51,85,.32), rgba(255,204,51,.12)); box-shadow: inset 0 0 0 calc(var(--u) * 1.5) rgba(255,90,90,.85); }
.rung.boss .nm { color: #ffd0d8; font-size: calc(var(--u) * 18); }
.rung.sel { box-shadow: inset 0 0 0 calc(var(--u) * 2) #fff, 0 0 calc(var(--u) * 10) rgba(255,255,255,.4); }
.cCard { flex: none; padding: calc(var(--u) * 10) calc(var(--u) * 12); border-radius: calc(var(--u) * 12); background: rgba(0,0,0,.35); box-shadow: inset 0 0 0 1px rgba(255,79,176,.4);
  display: flex; flex-direction: column; gap: calc(var(--u) * 7); }
.cCard .who { font-size: calc(var(--u) * 24); font-style: italic; letter-spacing: .5px; line-height: 1.05; }
.cCard .who small { display: block; font-family: var(--font2); font-weight: 700; font-size: calc(var(--u) * 14); color: #b9c2ff; letter-spacing: .5px; }
.cCard .cmp { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: calc(var(--u) * 6); }
.cCard .cmp div { text-align: center; background: rgba(255,255,255,.05); border-radius: calc(var(--u) * 6); padding: calc(var(--u) * 4); font-family: var(--font2); font-weight: 700; font-size: calc(var(--u) * 13); color: #aab0e0; letter-spacing: .5px; }
.cCard .cmp b { display: block; font-family: var(--font); font-weight: normal; font-size: calc(var(--u) * 19); color: #fff; font-style: italic; }
.cCard .cmp b.good { color: var(--green); } .cCard .cmp b.bad { color: #ff8aa0; }
.cCard .note { text-align: center; font-family: var(--font2); font-weight: 700; font-style: italic; font-size: calc(var(--u) * 15); color: #ff8aa0; }
.cCard .note.ok { color: #9ff5d0; }
.cCard .row { margin-top: 0; }
.cCard .row .mid { flex: 1; width: auto; }
.bossTag { display: inline-block; font-size: calc(var(--u) * 13); padding: 0 calc(var(--u) * 6); margin-right: calc(var(--u) * 6); border-radius: 3px; background: var(--red); transform: skewX(-12deg); vertical-align: middle; color: #fff; }
body.landscape .cBody { flex-direction: row; }
body.landscape .cLadder { flex: 1.15; }
body.landscape .cCard { flex: 1; justify-content: center; }
body.landscape .cTier { height: calc(var(--u) * 40); }

/* result reward */
.reward { margin: calc(var(--u) * 4) 0 calc(var(--u) * 8); padding: calc(var(--u) * 8) calc(var(--u) * 10); border-radius: calc(var(--u) * 10); background: rgba(40,24,0,.4); box-shadow: inset 0 0 0 1px rgba(255,204,51,.45); }
.reward:empty { display: none; }
.rl { display: flex; justify-content: space-between; font-family: var(--font2); font-weight: 700; font-style: italic; font-size: calc(var(--u) * 15); letter-spacing: .5px; color: #ffe9b0;
  opacity: 0; transform: translateX(calc(var(--u) * -12)); animation: rlIn .3s ease-out forwards; }
@keyframes rlIn { to { opacity: 1; transform: none; } }
.rl b { font-family: var(--font); font-weight: normal; color: #fff; }
.rtot { display: flex; align-items: center; justify-content: space-between; margin-top: calc(var(--u) * 6); padding-top: calc(var(--u) * 6); border-top: 1px solid rgba(255,204,51,.3); font-style: italic; font-size: calc(var(--u) * 18); }
.rtot .amt { display: flex; align-items: center; gap: calc(var(--u) * 6); font-size: calc(var(--u) * 28); color: #ffe27a; }
.rtot .amt i { width: calc(var(--u) * 30); height: calc(var(--u) * 34); }
.rtot .gems { color: #8ae8ff; font-size: calc(var(--u) * 20); display: flex; align-items: center; gap: 4px; }
.rtot .gems i { width: calc(var(--u) * 22); height: calc(var(--u) * 25); }
.unlock { margin-top: calc(var(--u) * 6); text-align: center; font-style: italic; font-size: calc(var(--u) * 17); letter-spacing: 1px; color: #fff; padding: calc(var(--u) * 4);
  border-radius: calc(var(--u) * 6); background: linear-gradient(90deg, rgba(255,47,154,0), rgba(255,47,154,.55), rgba(255,47,154,0)); }
.mid.sm { width: calc(var(--u) * 56); flex: none; }
.homeIco { display: block; margin: auto; width: calc(var(--u) * 22); height: calc(var(--u) * 18); background: #fff; clip-path: polygon(50% 0, 100% 45%, 86% 45%, 86% 100%, 14% 100%, 14% 45%, 0 45%); }
#result .row .mid { width: auto; flex: 1; padding: 0 calc(var(--u) * 8); }
#result .row .mid.sm { flex: none; width: calc(var(--u) * 56); }
body.landscape #result .reward, body.landscape #result .stats, body.landscape #result .paintRow { grid-column: 2; }
body.landscape #result .resTimes, body.landscape #result .chips { grid-column: 1; }
body.landscape #result .reward { margin: 0 0 calc(var(--u) * 6); grid-row: 2 / span 2; }
body.landscape #result .stats { grid-row: 4; } body.landscape #result .paintRow { grid-row: 5; margin-top: calc(var(--u) * 6); }
body.landscape #result .chips { grid-row: 3 / span 3; }

/* HUD rival plate */
#vsTag { position: absolute; left: 0; right: 0; top: calc(var(--u) * 132 + env(safe-area-inset-top)); text-align: center; opacity: 0; pointer-events: none; }
#vsTag.show { animation: vsIn 3.2s ease-out forwards; }
#vsTag b { display: inline-block; font-weight: normal; font-style: italic; font-size: calc(var(--u) * 24); letter-spacing: 1px; padding: 0 calc(var(--u) * 26);
  background: linear-gradient(90deg, rgba(224,16,58,0), rgba(224,16,58,.85) 20%, rgba(224,16,58,.85) 80%, rgba(224,16,58,0)); transform: skewX(-12deg); }
#vsTag i { display: block; font-family: var(--font2); font-weight: 700; font-size: calc(var(--u) * 15); letter-spacing: 1px; color: #ffd0d8; margin-top: 2px; text-shadow: 0 1px 3px #000; }
@keyframes vsIn { 0% { opacity: 0; transform: translateX(-30%); } 12% { opacity: 1; transform: none; } 80% { opacity: 1; } 100% { opacity: 0; } }
body.landscape #vsTag { top: calc(var(--u) * 46 + env(safe-area-inset-top)); left: auto; right: calc(var(--u) * 14 + env(safe-area-inset-right)); text-align: right; }
body.landscape #vsTag b { font-size: calc(var(--u) * 20); padding: 0 calc(var(--u) * 10) 0 calc(var(--u) * 30); background: linear-gradient(90deg, rgba(224,16,58,0), rgba(224,16,58,.85) 25%); }
body.landscape #vsTag i { font-size: calc(var(--u) * 13); }
body.landscape #prompt { top: 27%; }
/* shift buttons: drawn glyphs (the UI font's +/- are tiny) */
.pill .pm { position: absolute; left: 50%; top: 50%; width: calc(var(--u) * 22); height: calc(var(--u) * 5); margin: calc(var(--u) * -2.5) 0 0 calc(var(--u) * -11); background: #fff; border-radius: calc(var(--u) * 2); box-shadow: 0 0 calc(var(--u) * 6) rgba(255,255,255,.6); }
.pill .pm.plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: calc(var(--u) * 5); height: calc(var(--u) * 22); margin: calc(var(--u) * -11) 0 0 calc(var(--u) * -2.5); background: #fff; border-radius: calc(var(--u) * 2); }
/* landscape result: two columns, compact so it fits 390 px tall */
body.landscape #result .panel { width: min(86vw, calc(var(--u) * 620)); padding: calc(var(--u) * 8) calc(var(--u) * 14) calc(var(--u) * 10); }
body.landscape #result .banner { font-size: calc(var(--u) * 38); margin: 0 0 calc(var(--u) * 4); }
body.landscape #result .rt b { font-size: calc(var(--u) * 19); }
body.landscape #result .rl { font-size: calc(var(--u) * 13); }
body.landscape #result .rtot { margin-top: calc(var(--u) * 3); padding-top: calc(var(--u) * 3); }
body.landscape #result .rtot .amt { font-size: calc(var(--u) * 22); }
body.landscape #result .stats { font-size: calc(var(--u) * 12); }
body.landscape #result .paintRow .sw { width: calc(var(--u) * 20); height: calc(var(--u) * 20); }
body.landscape #result .row .mid { height: calc(var(--u) * 42); }

/* fx canvas, wipe transition, toast */
#fx2d { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 12; pointer-events: none; will-change: transform; }   /* perf: redrawn every frame while particles fly; own layer, never painted into the page */
#wipe { position: fixed; top: -10vh; bottom: -10vh; left: 0; width: 170vw; z-index: 15; pointer-events: none; transform: translateX(-200vw) skewX(-14deg); visibility: hidden;
  background: linear-gradient(90deg, rgba(255,47,154,0) 0, #ff2f9a 5%, #1a0c3a 8%, #0b0820 50%, #1a0c3a 92%, #2fe6ff 95%, rgba(47,230,255,0) 100%); }
#wipe.go { visibility: visible; animation: wipe .6s cubic-bezier(.65,0,.35,1); }
@keyframes wipe { from { transform: translateX(-190vw) skewX(-14deg); } to { transform: translateX(120vw) skewX(-14deg); } }
#toast { position: fixed; left: 50%; top: 24%; z-index: 14; transform: translateX(-50%); pointer-events: none; opacity: 0; white-space: nowrap;
  font-style: italic; font-size: calc(var(--u) * 20); letter-spacing: 1px; padding: calc(var(--u) * 8) calc(var(--u) * 22); border-radius: calc(var(--u) * 10);
  background: linear-gradient(180deg, rgba(40,28,90,.96), rgba(12,8,30,.96)); box-shadow: inset 0 0 0 calc(var(--u) * 1.5) #ff4fb0, 0 0 20px rgba(255,47,154,.5); }
#toast.show { animation: toast 1.9s ease-out forwards; }
#toast.good { box-shadow: inset 0 0 0 calc(var(--u) * 1.5) var(--gold), 0 0 24px rgba(255,190,40,.6); }
@keyframes toast { 0% { opacity: 0; transform: translate(-50%, 20px) scale(.8); } 10% { opacity: 1; transform: translate(-50%, 0) scale(1.05); } 18% { transform: translate(-50%, 0) scale(1); } 80% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -16px); } }

/* staggered entrance for meta screens */
.enter .gHead, .enter .gThumbs, .enter .glass, .enter .menuCol > *, .enter .arrow { animation: rise .45s cubic-bezier(.2,1.2,.4,1) both; }
.enter .gThumbs { animation-delay: .06s; } .enter .glass { animation-delay: .1s; }
.enter .menuCol > :nth-child(2) { animation-delay: .07s; } .enter .menuCol > :nth-child(3) { animation-delay: .14s; }
@keyframes rise { from { opacity: 0; transform: translateY(calc(var(--u) * 26)); } }
body.landscape .enter .glass { animation-name: slideL; }
@keyframes slideL { from { opacity: 0; transform: translateX(calc(var(--u) * 40)); } }
body.landscape #gStats { flex: 1; justify-content: space-evenly; }
