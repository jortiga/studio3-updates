// Drag race physics (SI units: meters, seconds, kg, N, Nm). No three.js in here.
export const QUARTER = 402.336;          // 1/4 mile in meters
export const G = 9.81;
export const DT = 1 / 120;               // fixed sim step
export const HALF = QUARTER * 2;         /* 1/2 mile */
/* Race types (TASKS.md "Race-type variety"). dist = metres from the start (roll: from the GO point); roll = rolling start
   at ROLL.v0 in ROLL.gear, GO on the third honk; cop = roll start with Bay Patrol closing from ROLL.copGap behind (win =
   reach the off-ramp first); grip = wet-road multiplier; nitro = nitro charges. */
export const RACE_TYPES = {
  drag: { dist: QUARTER },
  half: { dist: HALF, nitro: 2 },
  wet:  { dist: QUARTER, grip: 0.8 },
  roll: { dist: HALF, roll: true },
  cop:  { dist: HALF, roll: true, cop: true },
};
export const ROLL = { v0: 60 / 3.6, gear: 2, honks: [1.4, 2.2, 3.0], copGap: 16, auto: 0.02 };   /* auto: the player's car floors it by itself at GO (one step) */
/** Per-race spec changes for a type (call on the race's own spec copy). */
export function prepType(spec, type) {
  const T = RACE_TYPES[type] || RACE_TYPES.drag;
  if (T.grip) { spec.grip *= T.grip; spec.launchGrip = (spec.launchGrip || 1) * 0.94; }
  spec.nitroCharges = T.nitro || 1;
  return spec;
}

// Torque curve shape (rpm fraction of redline -> fraction of peak torque). Turbo-ish: lazy low end, fat middle.
