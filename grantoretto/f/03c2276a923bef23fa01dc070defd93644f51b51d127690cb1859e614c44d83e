<style id="noselect">/* MOBILE_PERFORMANCE.md: a double tap must never select text, show the iOS callout/loupe or zoom the page */
html, body, body * { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; }
img, canvas { -webkit-user-drag: none; }
input, textarea, [contenteditable] { -webkit-user-select: text; user-select: text; }
html, body { touch-action: manipulation; }</style>
<script id="nozoom">/* iOS still allows pinch and double-tap zoom in some cases */
document.addEventListener('gesturestart', function (e) { e.preventDefault(); });
document.addEventListener('dblclick', function (e) { e.preventDefault(); }, { passive: false });
for (var ev of ['selectstart', 'contextmenu']) document.addEventListener(ev, function (e) {
  if (!(e.target.closest && e.target.closest('input, textarea, [contenteditable]'))) e.preventDefault(); });
/* the iOS loupe still shows on a long press: cancel touchstart on the race surfaces (3D canvas + HUD, where fast double
   taps happen). Pointer events still fire, so gas/shift/nitro keep working. Menus keep native touch on purpose: many of
   their tap targets are plain divs (map pins, garage thumbs, rival rows, story) and iOS drops the click if touchstart is
   cancelled. Buttons and scrolling panels always keep native touch. */
document.addEventListener('touchstart', function (e) {
  var t = e.target; if (!t || !t.closest) return;
  if (t.closest('button, a, input, textarea, select, label, [contenteditable]')) return;
  if (t.id === 'gl' || t.tagName === 'CANVAS' || t.closest('#hud')) e.preventDefault();
}, { passive: false });</script>
