/* =================== theme: CLEAN PREMIUM (smoked glass, white italic type, pink glow, slanted buttons) =================== */
:root[data-theme="premium"] { --acc: #ff2f8e; --acc2: rgba(255,47,142,.2); --surf: rgba(14,12,22,.84); --surf2: rgba(255,255,255,.06); --surf3: rgba(255,255,255,.14);
  --line: rgba(255,255,255,.2); --line2: rgba(255,255,255,.4); --r: calc(var(--u) * 10); --r-panel: calc(var(--u) * 14); --hud-bg: rgba(12,10,20,.5); --hud-line: rgba(255,255,255,.6);
  --tach-a0: 160; --tach-a1: 380; --tach-face: rgba(8,8,14,.62); --tach-ring: rgba(255,255,255,.9); --tach-ring-w: 2.5; --tach-tick: #fff; --tach-tick2: rgba(255,255,255,.5);
  --tach-num: #fff; --tach-red: #ff2f5e; --tach-needle: #ff2f8e; --tach-prog: rgba(255,47,142,.9); --tach-border: rgba(255,255,255,.25); --tach-border-w: 1; --tach-font: 'Barlow Condensed'; --tach-font-w: italic 700; }
/* slanted buttons: the frame skews, the content un-skews (centres are preserved) */
:root[data-theme="premium"] .btn.mid, :root[data-theme="premium"] .btn.big, :root[data-theme="premium"] #career .btn { transform: skewX(-10deg); background: linear-gradient(180deg, rgba(255,255,255,.1), rgba(255,255,255,.03)); box-shadow: inset 0 0 0 1px var(--line), 0 4px 14px rgba(0,0,0,.45); }
:root[data-theme="premium"] .btn.mid > *, :root[data-theme="premium"] .btn.big > *, :root[data-theme="premium"] #career .btn > * { transform: skewX(10deg); }
:root[data-theme="premium"] .btn.mid.down, :root[data-theme="premium"] .btn.big.down { transform: skewX(-10deg) scale(.96); }
/* tiles (icon over label) stay upright: a skew would push the icon and the label off-centre in opposite directions */
:root[data-theme="premium"] .btn.tile { background: linear-gradient(180deg, rgba(255,255,255,.1), rgba(255,255,255,.03)); box-shadow: inset 0 0 0 1px var(--line), 0 4px 14px rgba(0,0,0,.45); }
:root[data-theme="premium"] .btn.gold, :root[data-theme="premium"] #career .btn.gold { background: linear-gradient(180deg, #ff4fa2, #d81b72); box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.55), 0 0 18px rgba(255,47,142,.55), 0 4px 14px rgba(0,0,0,.5); }
:root[data-theme="premium"] .btn, :root[data-theme="premium"] .tab, :root[data-theme="premium"] .mTxt, :root[data-theme="premium"] .sheetTitle, :root[data-theme="premium"] .banner, :root[data-theme="premium"] .carT, :root[data-theme="premium"] #uName, :root[data-theme="premium"] .tabTitle { font-style: italic; }
:root[data-theme="premium"] .mTxt { font-size: calc(var(--u) * 30); }
:root[data-theme="premium"] .glass, :root[data-theme="premium"] .panel, :root[data-theme="premium"] .aCta, :root[data-theme="premium"] #career .aCard { background: linear-gradient(180deg, rgba(26,22,38,.86), rgba(10,8,18,.9)); box-shadow: inset 0 0 0 1px var(--line), inset 0 1px 0 rgba(255,255,255,.12), var(--shadow); }
:root[data-theme="premium"] .cpill { background: rgba(14,12,22,.8); box-shadow: inset 0 0 0 1px var(--line2); border-radius: calc(var(--u) * 8); }
:root[data-theme="premium"] #title .logo .l1 { font-style: italic; font-size: calc(var(--u) * 36); }
:root[data-theme="premium"] #title .logo .l1 span { text-shadow: 0 0 18px rgba(255,47,142,.6); }
:root[data-theme="premium"] .tab.on, :root[data-theme="premium"] .seg button.on { background: var(--acc); color: #fff; }
:root[data-theme="premium"] .part.on, :root[data-theme="premium"] .th.on { box-shadow: inset 0 0 0 1.5px var(--acc), 0 0 12px rgba(255,47,142,.4); }
:root[data-theme="premium"] #subs span, :root[data-theme="premium"] #toast, :root[data-theme="premium"] .coachBub { background: rgba(14,12,22,.9); box-shadow: inset 0 0 0 1px var(--line2), var(--shadow); }
:root[data-theme="premium"] #hud .btn.ic { box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.7), 0 2px 10px rgba(0,0,0,.5); }
:root[data-theme="premium"] #hud #nitro { box-shadow: inset 0 0 0 1.5px var(--acc), 0 0 14px rgba(255,47,142,.5); color: #fff; }
:root[data-theme="premium"] #nitroFill { stroke: var(--acc); }
:root[data-theme="premium"] #prog .track { height: 3px; background: rgba(255,255,255,.25); }
:root[data-theme="premium"] #mk1 { box-shadow: 0 0 0 1.5px #fff, 0 0 10px var(--acc); }
:root[data-theme="premium"] #gear, :root[data-theme="premium"] .tval, :root[data-theme="premium"] #kmh { font-style: italic; }
:root[data-theme="premium"] .cdNum { text-shadow: 1px 1px 0 #ffd0e6, 2px 2px 0 #ff9fcb, 3px 3px 0 #ff6fb0, 4px 4px 0 #ff2f8e, 5px 5px 0 #c2106a, 6px 6px 0 #8a0a4b, 9px 12px 18px rgba(0,0,0,.6); }
:root[data-theme="premium"] .cdRing i { background: #fff; }
/* win/lose scene + VS intro */
:root[data-theme="premium"] { --scene-win: rgba(255,47,142,.28); --scene-lose: rgba(90,20,40,.4); --vs-l1: #ff4fa2; --vs-l2: #5a1d8c; --vs-r1: #e0304e; --vs-r2: #7a0f24; --vs-bolt: #ffd0e6; }
:root[data-theme="premium"] .rsWord { font-style: italic; text-shadow: 0 0 22px rgba(255,47,142,.55), 0 2px 12px rgba(0,0,0,.6); }
:root[data-theme="premium"] .lose .rsWord { text-shadow: 0 2px 12px rgba(0,0,0,.6); }
:root[data-theme="premium"] .rsMargin, :root[data-theme="premium"] .vsInfo b, :root[data-theme="premium"] .vsVs::before { font-style: italic; }
