    g.fillStyle = k % 2 ? '#0a0614' : '#1c0a14'; rr(g, r.x + pad, r.y + pad, r.w - pad * 2, r.h - pad * 2, k % 3 ? 8 : 2); g.fill();
    g.lineWidth = 3; g.strokeStyle = col; g.shadowColor = col; g.shadowBlur = 8; rr(g, r.x + pad + 3, r.y + pad + 3, r.w - pad * 2 - 6, r.h - pad * 2 - 6, 6); g.stroke(); g.shadowBlur = 0;
    const ch = [...txt], step = Math.min(56, (r.h - 36) / ch.length);
    ch.forEach((t, j) => neonText(g, t, r.x + r.w / 2, r.y + 18 + step * (j + 0.5), `bold ${Math.round(step * 0.86)}px ${JP}`, col, 10));
    cells.v.push(r);
  });
  i = 64;   // rows 8-10 (y 1024+): EN-first neon signs + a second set of shopfronts in a dark-panel neon style
  H_SIGNS2.forEach(([jp, en, col], k) => {
    const r = cell(), pad = 10;
    g.fillStyle = ['#0a0614', '#140a06', '#06101a'][k % 3]; rr(g, r.x + pad, r.y + pad, r.w - pad * 2, r.h - pad * 2, k % 2 ? 4 : 14); g.fill();
    if (k % 2) { g.lineWidth = 3; g.strokeStyle = col; g.shadowColor = col; g.shadowBlur = 10; rr(g, r.x + pad + 4, r.y + pad + 4, r.w - pad * 2 - 8, r.h - pad * 2 - 8, 3); g.stroke(); g.shadowBlur = 0; }
    neonText(g, en, r.x + r.w / 2, r.y + 50, fitFont(g, en, 40, EN, r.w - 40, 'normal'), col, 14);
