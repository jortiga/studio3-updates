function rr(g, x, y, w, h, r) { g.beginPath(); g.moveTo(x + r, y); g.arcTo(x + w, y, x + w, y + h, r); g.arcTo(x + w, y + h, x, y + h, r); g.arcTo(x, y + h, x, y, r); g.arcTo(x, y, x + w, y, r); g.closePath(); }
function neonText(g, txt, x, y, font, col, blur = 14) {
  g.font = font; g.textAlign = 'center'; g.textBaseline = 'middle';
  g.shadowColor = col; g.shadowBlur = blur; g.fillStyle = col; g.fillText(txt, x, y); g.fillText(txt, x, y);
  g.shadowBlur = 0; g.fillStyle = 'rgba(255,255,255,0.85)'; g.fillText(txt, x, y);
}
function fitFont(g, txt, base, family, maxW, weight = 'bold') {
  let s = base; g.font = `${weight} ${s}px ${family}`;
  while (g.measureText(txt).width > maxW && s > 10) { s -= 2; g.font = `${weight} ${s}px ${family}`; }
  return `${weight} ${s}px ${family}`;
}

// ---------------------------------------------------------------- sign atlas (2048 x 1024)
