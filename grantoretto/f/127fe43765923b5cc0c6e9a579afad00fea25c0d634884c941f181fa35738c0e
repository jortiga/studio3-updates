// ---------------------------------------------------------------- screen atlas (1024 x 1024): 4 x 7 cells of 256 x 144
const SC = { w: 256, h: 144, cols: 4 };
const scCell = (k) => ({ x: (k % SC.cols) * SC.w, y: Math.floor(k / SC.cols) * SC.h });
function coverDraw(g, im, x, y, w, h, { fit = 'cover', bg = null, ax = 0.5, ay = 0.3 } = {}) {
  if (bg) { g.fillStyle = bg; g.fillRect(x, y, w, h); }
  if (!im) return;
  const s = fit === 'cover' ? Math.max(w / im.width, h / im.height) : Math.min(w / im.width, h / im.height) * 0.92;
  const dw = im.width * s, dh = im.height * s;
  g.save(); g.beginPath(); g.rect(x, y, w, h); g.clip();
  g.drawImage(im, x + (w - dw) * ax, y + (h - dh) * (fit === 'cover' ? ay : 0.5), dw, dh); g.restore();
}
function poster(g, k, title, sub, c1, c2) {
  const { x, y } = scCell(k), w = SC.w, h = SC.h;
  const gr = g.createLinearGradient(x, y, x + w, y + h); gr.addColorStop(0, c1); gr.addColorStop(1, c2);
  g.fillStyle = gr; g.fillRect(x, y, w, h);
  g.globalAlpha = 0.25; for (let i = 0; i < 9; i++) { g.fillStyle = '#fff'; g.fillRect(x, y + 10 + i * 16, w, 2); } g.globalAlpha = 1;
  neonText(g, title, x + w / 2, y + h * 0.42, fitFont(g, title, 40, EN, w - 24, 'normal'), '#ffffff', 10);
  g.fillStyle = '#ffe27a'; g.font = fitFont(g, sub, 22, JP, w - 30); g.textAlign = 'center'; g.fillText(sub, x + w / 2, y + h * 0.74);
}

