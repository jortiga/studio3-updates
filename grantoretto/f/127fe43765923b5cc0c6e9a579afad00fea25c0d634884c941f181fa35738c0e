  for (const [jp, en, col] of PASS_SIGNS) {
    const r = cell(), pad = 8;
    g.fillStyle = '#10204a'; rr(g, r.x + pad, r.y + pad, r.w - pad * 2, r.h - pad * 2, 8); g.fill();
    g.lineWidth = 5; g.strokeStyle = '#e8ecff'; rr(g, r.x + pad + 5, r.y + pad + 5, r.w - pad * 2 - 10, r.h - pad * 2 - 10, 6); g.stroke();
