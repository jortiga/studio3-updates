// Race extras owned by the "wow" pass, kept out of main.js (which only calls the hooks below):
//   init(ctx)           after buildWorld: adds Mika the flag girl between the lanes at the start line
//   raceStart(opts, ri) end of startRace: VS intro (sets G.intro so the staging clock waits), Mika's voice
//   update(dt)          every frame: Mika's pose (ready -> GO on the green -> cheering), countdown voice
//   event(type, grade, isPlayer)   race events: driver cut-ins, 2D sparks / flare / nitro ring
import * as THREE from './vendor/three.module.min.js';
import * as A from './assets.js';
import * as M from './meta.js';
import * as P from './physics.js';
import * as C from './cast.js';
import * as S from './scenes.js';
import * as ST from './story.js'; // story cutscenes (prologue before the tutorial, area/boss scenes before the VS intro)

const Q = new URLSearchParams(location.search);
let ctx = null, mika = null, shadow = null;
const tex = {};
const PX_M = 1.9 / 732; // metres per pixel of the Mika sprites (body ~732 px tall at the cut scale)
const MIKA_X = 1.0, MIKA_Z = -1.8;
const state = { pose: '', said: {}, goT: -1, lastStage: -1 };

export function init(c) {
  ctx = c;
  const G = c.G;
  if (!('intro' in G)) G.intro = false;
  ST.init(c);
  for (const k of ['ready', 'go', 'win']) {
    const im = new Image();
    im.onload = () => {
      tex[k] = { t: A.texFrom(im, { srgb: false }), w: im.width, h: im.height };
      if (!mika && tex.ready) build();
    };
    im.src = `art/mika_${k}.webp`;
  }
  try { C.audio() && C.audio().setOption && C.audio().setOption({ countdownVoice: 'mika' }); } catch { /* */ }
  C.castReady.then(() => { try { C.audio() && C.audio().setOption({ countdownVoice: 'mika' }); } catch { /* */ } });
}

function build() {
  const { scene, spriteMat, RO } = ctx;
  mika = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), spriteMat(tex.ready.t, { tint: 0xe6e2f2, fog: 0.6 }));
  mika.renderOrder = (RO && RO.tree ? RO.tree - 1 : 17); mika.frustumCulled = false; mika.visible = false;
  scene.add(mika);
  const c = document.createElement('canvas'); c.width = c.height = 64;
  const g = c.getContext('2d'), r = g.createRadialGradient(32, 32, 0, 32, 32, 32);
  r.addColorStop(0, 'rgba(0,0,0,.65)'); r.addColorStop(1, 'rgba(0,0,0,0)'); g.fillStyle = r; g.fillRect(0, 0, 64, 64);
  shadow = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), spriteMat(A.texFrom(c, { srgb: false }), { fog: 0.6 }));
  shadow.rotation.x = -Math.PI / 2; shadow.scale.set(1.3, 0.55, 1); shadow.position.set(MIKA_X, 0.01, MIKA_Z);
  shadow.renderOrder = mika.renderOrder - 0.5; shadow.frustumCulled = false; shadow.visible = false;
  scene.add(shadow);
  setPose('ready');
}
function setPose(p) {
  if (!mika || !tex[p] || state.pose === p) return;
  state.pose = p;
  const t = tex[p];
  mika.material.uniforms.map.value = t.t;
  mika.userData.w = t.w * PX_M; mika.userData.h = t.h * PX_M;
  // the GO pose leans forward (flag swept to the right); shift so her feet stay on the same spot
  mika.userData.dx = p === 'go' ? 0.15 : 0;
  mika.userData.squash = 1;
}

// ---------------------------------------------------------------- race start: VS intro
export function raceStart(opts, ri, info) {
  const G = ctx.G;
  state.said = {}; state.goT = -1; state.pose = ''; setPose('ready');
  if (opts && opts.mode === 'tutorial' && ST.want('prologue')) { G.intro = true; ST.prologue().then(() => { G.intro = false; }); return; } // first run: prologue, then the tutorial
  /* user (2026-11-13): the VS screen with the rival's trash talk is back for every race after the tutorial (career +
     quick; not the tutorial, the daily or a cop chase): ~2-3 s, one tap / key skips, one voiced taunt that never repeats
     back to back for the same rival, the race-type badge. It fades out into the staging. */
  if (!opts || !(opts.mode === 'career' || opts.mode === 'quick') || (info && info.type === 'cop')) { mikaLine(); return; }
  if (Q.has('t') || (Q.has('auto') && !Q.has('vs'))) return; // headless fast-forward / bot runs: no intro
  const save = ctx.save;
  const rid = ri ? C.rivalChar(ri) : C.rivalChar(null, (G.raceNo || 0) + (info && info.rkey ? info.rkey.length : 0));
  const myET = M.predictET(save.car, M.upOf(save, save.car)) + 0.04;
  const retry = !!ri && G.lastIntro && G.lastIntro.tier === ri.tier && G.lastIntro.i === ri.i;
  if (ri) G.lastIntro = { tier: ri.tier, i: ri.i };
  const keys = ['taunt1', 'taunt2', 'taunt3', 'taunt4'].filter((k) => C.hasLine(rid, k));
  const last = (G.lastTaunt || (G.lastTaunt = {}))[rid];
  const pool = keys.filter((k) => k !== last);
  const lineKey = pool.length ? pool[Math.floor(Math.random() * pool.length)] : keys[0];
  if (lineKey) G.lastTaunt[rid] = lineKey;
  const rcar = ri ? ri.car : info.rkey, type = (info && info.type) || 'drag';
  G.intro = true; G.vsUsed = true; G.vsUp = true;   /* main.typeUI: the race-type card / chip leave with the VS screen */
  (ri ? ST.beforeRace(ri) : Promise.resolve(false)).then((bossScene) => S.vsIntro({
    boss: !!(ri && ri.isBoss), retry, type, place: info && info.place, onOut: () => { G.vsUp = false; },
    you: { car: save.car, carName: P.CARS[save.car].name, et: myET, tag: `TIER ${M.carTier(save.car)} · ${save.wins || 0} WINS` },
    rival: { id: rid, name: ri ? ri.name : (info.rname || 'STREET RACER'), car: rcar, carName: P.CARS[rcar].name,
      crew: ri ? (ri.isBoss ? `${ri.crew} · TIER ${ri.tier} BOSS` : `${ri.crew} · RIVAL ${ri.i + 1}/${M.RUNGS}`) : 'QUICK RACE', et: ri ? ri.et : (info.rivalTarget || myET) },
    line: bossScene || !lineKey ? null : { id: rid, key: lineKey },   // the boss just spoke in the story scene: don't repeat
  })).then(() => { G.intro = false; G.vsUp = false; mikaLine(); });
}
// Mika's staging line now comes only from main.js (snd.say('ready') at the start of staging); a second line here
// ('eyes'/'ready') cut it off and the countdown voices stepped on each other.
function mikaLine() { }

// countdown voice in Mika's voice on the amber lamps / green (skipped if the audio side already said it)
function countdown(key) {
  if (state.said[key]) return; state.said[key] = true;
  const a = C.audio();
  if (!a || !a.say) return;
  const h = a.history || [], now = performance.now();
  for (let i = h.length - 1; i >= 0 && now - h[i].t < 400; i--) if (h[i].name === key || h[i].name === 'mika.' + key) return;
  try { a.say(key); } catch { /* */ }
}

export function update(dt) {
  if (!ctx) return;
  const G = ctx.G;
  const racing = G.state === 'stage' || G.state === 'race' || G.state === 'finish';
  if (mika) { const on = racing && !G.rolling; mika.visible = on; shadow.visible = on; }   /* no flag girl on a rolling start */
  if (!racing) return;
  if (G.state === 'stage' && !G.intro && !G.paused && !G.rolling) {
    const t = G.stageT, am = ctx.STAGE.amber;
    if (t > am[0]) countdown('three');
    if (t > am[1]) countdown('two');
    if (t > am[2]) countdown('one');
  }
  if (G.state !== 'stage' && state.goT < 0) { state.goT = G.time; setPose('go'); if (mika) mika.userData.squash = 0.9; if (!G.rolling) countdown('go'); }
  if (state.goT >= 0 && G.time - state.goT > 1.1) setPose('win');
  if (!mika) return;
  const u = mika.userData;
  u.squash += (1 - u.squash) * Math.min(1, dt * 10);
  const bob = state.pose === 'win' ? Math.abs(Math.sin(G.time * 7)) * 0.06 : Math.sin(G.time * 2.2) * 0.012;
  const h = u.h * u.squash, w = u.w * (2 - u.squash);
  mika.scale.set(w, h, 1);
  mika.position.set(MIKA_X + u.dx, h / 2 + bob, MIKA_Z);
}

// ---------------------------------------------------------------- race events
export function event(type, grade, isPlayer) {
  // Race feedback is all in-world now (main.js + fx3d.js: exhaust flame/sparks, edge pulse, tach flash). The 2D juice
  // layer (rings, lens flares, spark bursts over the car) stays for UI-only bursts (coins, unlocks, results).
}
// Player car's rear (exhaust side) on screen, CSS px
const v3 = new THREE.Vector3();
function carScreen() {
  const p = ctx.getPlayer && ctx.getPlayer();
  if (!p || !ctx.cam) return [innerWidth * 0.4, innerHeight * 0.55];
  v3.set(p.x - 3.4, 0.7, 0).project(ctx.cam);
  return [(v3.x * 0.5 + 0.5) * innerWidth, (-v3.y * 0.5 + 0.5) * innerHeight];
}
